diff --git a/src/core/observers.cpp b/src/core/observers.cpp
new file mode 100644
index 00000000..4527cda3
--- /dev/null
+++ b/src/core/observers.cpp
@@ -0,0 +1,25 @@
+#include <rex/diagnostics/observers.h>
+#include <atomic>
+
+namespace rex::diagnostics::observers {
+namespace {
+std::atomic<FileOpenFn> file_open{nullptr};
+std::atomic<InputFn> input{nullptr};
+std::atomic<CrashFn> crash{nullptr};
+std::atomic_flag crash_called = ATOMIC_FLAG_INIT;
+}
+void SetFileOpenObserver(FileOpenFn fn) noexcept { file_open.store(fn, std::memory_order_relaxed); }
+void SetInputObserver(InputFn fn) noexcept { input.store(fn, std::memory_order_relaxed); }
+void SetCrashObserver(CrashFn fn) noexcept { crash.store(fn, std::memory_order_relaxed); }
+void NotifyFileOpen(const char* p, uint32_t s, bool d) noexcept {
+  if (auto fn = file_open.load(std::memory_order_relaxed)) fn(p, s, d);
+}
+void NotifyInput(uint32_t u, uint16_t b, uint8_t l, uint8_t r) noexcept {
+  if (auto fn = input.load(std::memory_order_relaxed)) fn(u, b, l, r);
+}
+void NotifyCrash(const char* s) noexcept {
+  if (auto fn = crash.load(std::memory_order_relaxed)) {
+    if (!crash_called.test_and_set(std::memory_order_relaxed)) fn(s);
+  }
+}
+}  // namespace rex::diagnostics::observers
diff --git a/src/core/seh_posix.cpp b/src/core/seh_posix.cpp
index 6971ec76..95b91cad 100644
--- a/src/core/seh_posix.cpp
+++ b/src/core/seh_posix.cpp
@@ -18,11 +18,15 @@ static_assert(REX_PLATFORM_LINUX || REX_PLATFORM_MAC, "This file is POSIX-only")
 #include <cstring>   // std::memset()
 
 #include <rex/ppc/exceptions.h>
+#include <rex/diagnostics/observers.h>
+#include <atomic>
+#include <cstdio>
 
 namespace rex::ppc::detail {
 
 static thread_local SehThreadState tls_seh_state;
 static thread_local bool tls_seh_active = false;
+static std::atomic_flag crash_observer_called = ATOMIC_FLAG_INIT;
 
 // The signal actions that were installed before the PPC SEH layer claimed
 // SIGSEGV/SIGBUS/SIGFPE/SIGILL. A fault that the PPC SEH layer declines (we
@@ -101,6 +105,12 @@ static void signal_handler(int sig, siginfo_t* info, void* context) {
     // Not in SEH region - pass the fault to the handler that owned the signal
     // before this layer (e.g. an application crash reporter), or terminate
     // with the default disposition if there was none.
+    if (!crash_observer_called.test_and_set(std::memory_order_relaxed)) {
+      char summary[96];
+      std::snprintf(summary, sizeof(summary), "signal=%d address=0x%llX", sig,
+                    static_cast<unsigned long long>(info ? reinterpret_cast<uintptr_t>(info->si_addr) : 0));
+      rex::diagnostics::observers::NotifyCrash(summary);
+    }
     ChainToPreviousHandler(sig, info, context);
   }
 
diff --git a/src/kernel/xam/xam_input.cpp b/src/kernel/xam/xam_input.cpp
index 4b6a8ebb..0cfdc2c0 100644
--- a/src/kernel/xam/xam_input.cpp
+++ b/src/kernel/xam/xam_input.cpp
@@ -11,6 +11,7 @@
 
 #include <atomic>
 #include <rex/cvar.h>
+#include <rex/diagnostics/observers.h>
 #include <rex/chrono/clock.h>
 #include <rex/input/input.h>
 #include <rex/input/input_system.h>
@@ -167,7 +168,12 @@ ppc_u32_result_t XamInputGetState_entry(ppc_u32_t user_index, ppc_u32_t flags,
   }
 
   auto* is = input_system();
-  return is->GetState(actual_user_index, input_state);
+  const X_RESULT result = is->GetState(actual_user_index, input_state);
+  if (result == X_ERROR_SUCCESS && input_state) {
+    rex::diagnostics::observers::NotifyInput(actual_user_index, input_state->gamepad.buttons,
+        input_state->gamepad.left_trigger, input_state->gamepad.right_trigger);
+  }
+  return result;
 }
 
