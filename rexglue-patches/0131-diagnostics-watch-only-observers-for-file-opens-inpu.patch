From 13b9641484bd2d9e21668a2b517bf7007054286e Mon Sep 17 00:00:00 2001
From: PromethenDev <PromethenDev@users.noreply.github.com>
Date: Fri, 30 Oct 2026 21:53:46 -0700
Subject: [PATCH 131/149] diagnostics: watch-only observers for file opens,
 input state and fatal POSIX signals (WWE2K14 timeline tracker, card LOG1;
 owner OK 2026-10-31)

SetFileOpenObserver (NtCreateFile result + guest path), SetInputObserver
(successful XamInputGetState), SetCrashObserver (POSIX: only on the path that
chains to the previous handler / terminates; signal-tolerant contract). One
relaxed atomic load when nobody registered; observers cannot change results.
Windows crash notification is left to the game's SetUnhandledExceptionFilter.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 include/rex/diagnostics/observers.h | 23 +++++++++++++++++++++++
 src/core/CMakeLists.txt             |  1 +
 src/core/observers.cpp              | 25 +++++++++++++++++++++++++
 src/core/seh_posix.cpp              | 10 ++++++++++
 src/kernel/xam/xam_input.cpp        |  8 +++++++-
 src/kernel/xboxkrnl/xboxkrnl_io.cpp |  3 +++
 6 files changed, 69 insertions(+), 1 deletion(-)
 create mode 100644 include/rex/diagnostics/observers.h
 create mode 100644 src/core/observers.cpp

diff --git a/include/rex/diagnostics/observers.h b/include/rex/diagnostics/observers.h
new file mode 100644
index 00000000..3e31d8f1
--- /dev/null
+++ b/include/rex/diagnostics/observers.h
@@ -0,0 +1,23 @@
+#pragma once
+
+#include <cstdint>
+
+namespace rex::diagnostics::observers {
+using FileOpenFn = void (*)(const char* guest_path, uint32_t status, bool is_directory);
+using InputFn = void (*)(uint32_t user_index, uint16_t buttons, uint8_t left_trigger,
+                         uint8_t right_trigger);
+using CrashFn = void (*)(const char* summary);
+
+// Crash callbacks run in the SDK's existing fatal-crash context: POSIX only, from the
+// signal handler when a fault is passed on to the previous handler / termination (signal
+// context). They must be signal-tolerant: no allocation, locks, or exceptions. On Windows
+// the game installs its own SetUnhandledExceptionFilter (vectored handlers also see
+// exceptions that are handled later, so they cannot tell a crash).
+void SetFileOpenObserver(FileOpenFn fn) noexcept;
+void SetInputObserver(InputFn fn) noexcept;
+void SetCrashObserver(CrashFn fn) noexcept;
+void NotifyFileOpen(const char* guest_path, uint32_t status, bool is_directory) noexcept;
+void NotifyInput(uint32_t user_index, uint16_t buttons, uint8_t left_trigger,
+                 uint8_t right_trigger) noexcept;
+void NotifyCrash(const char* summary) noexcept;
+}  // namespace rex::diagnostics::observers
