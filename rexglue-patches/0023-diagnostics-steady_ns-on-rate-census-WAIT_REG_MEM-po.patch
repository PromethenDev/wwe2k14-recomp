+                                                 now - census_wait_start_ns,
+                                                 census_payload_ms,
+                                                 census_wait_iterations,
+                                                 census_payload_ms_sum);
     }
   };
 
@@ -1207,11 +1215,14 @@ bool CommandProcessor::ExecutePacketType3_WAIT_REG_MEM(memory::RingBuffer* reade
         break;
     }
     if (!matched) {
