Subject: [PATCH 04/97] kernel/input: IO, RTL, XAM input and MnK driver fixes

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/input/mnk/mnk_input_driver.cpp   | 30 ++++++++++++++
 src/kernel/xam/apps/xmp_app.cpp      |  8 +++-
 src/kernel/xam/xam_input.cpp         |  8 +++-
 src/kernel/xboxkrnl/xboxkrnl_io.cpp  | 62 ++++++++++++++++++++++++++++
 src/kernel/xboxkrnl/xboxkrnl_rtl.cpp | 43 +++++++++++++++++++
 5 files changed, 148 insertions(+), 3 deletions(-)

diff --git a/src/input/mnk/mnk_input_driver.cpp b/src/input/mnk/mnk_input_driver.cpp
index b8eae3c..b005782 100644
--- a/src/input/mnk/mnk_input_driver.cpp
+++ b/src/input/mnk/mnk_input_driver.cpp
@@ -112,6 +112,30 @@ static bool IsBindPressed(const bool (&key_down)[256], const std::string& cvar_v
   return idx < 256 && key_down[idx];
 }
 
+// Virtual keys consumed by the guest's front-end keyboard UI through
+// XamInputGetKeystroke(Ex): the standard VK navigation/action set (the guest
+// pump dispatches on VK codes 3..40 and consumes the VK_SHIFT key-up). Only
+// these are turned into keystroke events; all other keys stay state-only.
+static bool IsUiKeystrokeKey(uint16_t vk) {
+  switch (static_cast<VirtualKey>(vk)) {
+    case VirtualKey::kCancel:
+    case VirtualKey::kBack:
+    case VirtualKey::kTab:
+    case VirtualKey::kReturn:
+    case VirtualKey::kShift:
+    case VirtualKey::kCapital:
+    case VirtualKey::kEscape:
+    case VirtualKey::kSpace:
+    case VirtualKey::kLeft:
+    case VirtualKey::kUp:
+    case VirtualKey::kRight:
+    case VirtualKey::kDown:
+      return true;
+    default:
+      return false;
+  }
+}
+
 X_RESULT MnkInputDriver::GetCapabilities(uint32_t user_index, uint32_t flags,
                                          X_INPUT_CAPABILITIES* out_caps) {
   if (!IsEnabled() || user_index != UserIndex()) {
@@ -311,6 +335,9 @@ void MnkInputDriver::OnKeyDown(rex::ui::KeyEvent& e) {
   std::lock_guard lock(state_mutex_);
   uint16_t vk = static_cast<uint16_t>(e.virtual_key());
   SetKeyState(vk, true);
+  if (IsUiKeystrokeKey(vk)) {
+    EnqueueKeystroke(vk, true);
+  }
 }
 
 void MnkInputDriver::OnKeyUp(rex::ui::KeyEvent& e) {
@@ -319,6 +346,9 @@ void MnkInputDriver::OnKeyUp(rex::ui::KeyEvent& e) {
   std::lock_guard lock(state_mutex_);
   uint16_t vk = static_cast<uint16_t>(e.virtual_key());
   SetKeyState(vk, false);
+  if (IsUiKeystrokeKey(vk)) {
+    EnqueueKeystroke(vk, false);
+  }
 }
 
 void MnkInputDriver::OnMouseDown(rex::ui::MouseEvent& e) {
diff --git a/src/kernel/xam/apps/xmp_app.cpp b/src/kernel/xam/apps/xmp_app.cpp
index a5e9088..1aab507 100644
--- a/src/kernel/xam/apps/xmp_app.cpp
+++ b/src/kernel/xam/apps/xmp_app.cpp
@@ -405,8 +405,14 @@ X_HRESULT XmpApp::DispatchMessageSync(uint32_t message, uint32_t buffer_ptr,
       assert_true(args->xmp_client == 0x00000002);
       REXKRNL_DEBUG("XMPGetPlaybackController({:08X}, {:08X}, {:08X})", uint32_t(args->xmp_client),
                     uint32_t(args->controller_ptr), uint32_t(args->locked_ptr));
+      // Report the playback state stored by XMPSetPlaybackController instead of a
+      // hardcoded idle (0, 0): the guest poll chain (sub_829BCF48) treats the pair
+      // as the live controller state and only sees "not active" while both words
+      // are zero. The controller word is not tracked by this app and the title's
+      // own setter calls always pass controller == 0, so it stays 0.
       memory::store_and_swap<uint32_t>(memory_->TranslateVirtual(args->controller_ptr), 0);
-      memory::store_and_swap<uint32_t>(memory_->TranslateVirtual(args->locked_ptr), 0);
+      memory::store_and_swap<uint32_t>(memory_->TranslateVirtual(args->locked_ptr),
+                                       static_cast<uint32_t>(playback_client_));
 
       if (!XThread::GetCurrentThread()->main_thread()) {
         // Atrain spawns a thread 82437FD0 to call this in a tight loop forever.
diff --git a/src/kernel/xam/xam_input.cpp b/src/kernel/xam/xam_input.cpp
index f03f439..2db5561 100644
--- a/src/kernel/xam/xam_input.cpp
+++ b/src/kernel/xam/xam_input.cpp
@@ -32,6 +32,10 @@ using rex::input::X_INPUT_STATE;
 using rex::input::X_INPUT_VIBRATION;
 
 constexpr uint32_t XINPUT_FLAG_GAMEPAD = 0x01;
+// Any-device keystroke queries (flags low byte 0x02, see the XamInputGetKeystroke
+// comment below). Keyboard-driven front ends query keystrokes this way; the
+// keyboard VKs they expect come from the MnK driver, not from VK_PAD codes.
+constexpr uint32_t XINPUT_FLAG_ANY_DEVICE = 0x02;
 constexpr uint32_t XINPUT_FLAG_ANY_USER = 1 << 30;
 
 rex::input::InputSystem* input_system() {
@@ -147,7 +151,7 @@ ppc_u32_result_t XamInputGetKeystroke_entry(ppc_u32_t user_index, ppc_u32_t flag
     return X_ERROR_BAD_ARGUMENTS;
   }
 
-  if ((flags & 0xFF) && (flags & XINPUT_FLAG_GAMEPAD) == 0) {
+  if ((flags & 0xFF) && (flags & (XINPUT_FLAG_GAMEPAD | XINPUT_FLAG_ANY_DEVICE)) == 0) {
     // Ignore any query for other types of devices.
     return X_ERROR_DEVICE_NOT_CONNECTED;
   }
@@ -169,7 +173,7 @@ ppc_u32_result_t XamInputGetKeystrokeEx_entry(ppc_pu32_t user_index_ptr, ppc_u32
     return X_ERROR_BAD_ARGUMENTS;
   }
 
-  if ((flags & 0xFF) && (flags & XINPUT_FLAG_GAMEPAD) == 0) {
+  if ((flags & 0xFF) && (flags & (XINPUT_FLAG_GAMEPAD | XINPUT_FLAG_ANY_DEVICE)) == 0) {
     // Ignore any query for other types of devices.
     return X_ERROR_DEVICE_NOT_CONNECTED;
   }
diff --git a/src/kernel/xboxkrnl/xboxkrnl_io.cpp b/src/kernel/xboxkrnl/xboxkrnl_io.cpp
index 3883e2f..d73269d 100644
--- a/src/kernel/xboxkrnl/xboxkrnl_io.cpp
+++ b/src/kernel/xboxkrnl/xboxkrnl_io.cpp
@@ -198,6 +198,68 @@ ppc_u32_result_t NtReadFile_entry(ppc_u32_t file_handle, ppc_u32_t event_handle,
       (uint32_t)file_handle, (uint32_t)event_handle, apc_routine_ptr.guest_address(),
       apc_context.guest_address(), io_status_block.guest_address(), buffer.guest_address(),
       (uint32_t)buffer_length, byte_offset_ptr ? (int64_t)byte_offset : -1);
+  if ((uint32_t)file_handle == 0) {
+    // Cycle-19 diagnostic: identify the guest caller of a null-handle read.
+    // ctx.lr is the guest return address of the caller of NtReadFile (the
+    // instruction after the bl/bctrl that invoked this import). Bounded: at
+    // most 16 logged occurrences plus one suppression notice; no behavior
+    // change, normal-path logging untouched.
+    // Cycle-20b diagnostic: also read the two saved-LR words of the live guest
+    // frames (offsets derived and verified in logs/cycle20b-offsets.txt):
+    //   guest [ctx.r1 + 168] = LR saved by sub_82B88DB8's caller (sub_82B73860)
+    //   guest [ctx.r1 + 312] = LR saved by the caller of sub_82B73860
+    // Guest memory is big-endian; read via the same virtual-membase translation
+    // the iosb accessor uses (host = virtual_membase + guest_addr), with
+    // rex::memory::load_and_swap<uint32_t>. Bounded by the same cap below.
+    static unsigned null_read_log_count = 0;
+    if (null_read_log_count < 16) {
+      ++null_read_log_count;
+      auto* thread_state = rex::runtime::ThreadState::Get();
+      uint32_t guest_lr =
+          (thread_state && thread_state->context()) ? (uint32_t)thread_state->context()->lr : 0;
+      uint32_t caller_lr = 0;
+      uint32_t upper_lr = 0;
+      uint32_t caller_lr2 = 0;
+      uint32_t this_ptr = 0;
+      uint32_t obj0 = 0, obj80 = 0, objA4 = 0, objB8 = 0;
+      if (thread_state && thread_state->context()) {
+        uint32_t guest_r1 = thread_state->context()->r1.u32;
+        auto* kernel_state = thread_state->context()->kernel_state;
+        auto* memory = kernel_state ? kernel_state->memory() : nullptr;
+        if (memory) {
+          caller_lr =
+              memory::load_and_swap<uint32_t>(memory->TranslateVirtual(guest_r1 + 168));
+          upper_lr = memory::load_and_swap<uint32_t>(memory->TranslateVirtual(guest_r1 + 312));
+          // Cycle-23a: reader `this` and stream-object state at the failing read.
+          // [r1+308] = sub_82B73860's saved r31 low word (reader this; 157.cpp:6299-6300)
+          // [r1+424] = sub_8334C860's saved LR (0x8334CC50 or 0x8334CE90)
+          caller_lr2 = memory::load_and_swap<uint32_t>(memory->TranslateVirtual(guest_r1 + 424));
+          this_ptr = memory::load_and_swap<uint32_t>(memory->TranslateVirtual(guest_r1 + 308));
+          if (this_ptr >= 0x10000u && this_ptr < 0xF0000000u) {
+            obj0 = memory::load_and_swap<uint32_t>(memory->TranslateVirtual(this_ptr + 0));
+            obj80 = memory::load_and_swap<uint32_t>(memory->TranslateVirtual(this_ptr + 128));
+            objA4 = memory::load_and_swap<uint32_t>(memory->TranslateVirtual(this_ptr + 164));
+            objB8 = memory::load_and_swap<uint32_t>(memory->TranslateVirtual(this_ptr + 184));
+          }
+        }
+      }
+      REXKRNL_IMPORT_TRACE(
+          "NtReadFile",
+          "NULL-HANDLE handle={:#x} event={:#x} apc={:#x} apc_ctx={:#x} iosb={:#x} buf={:#x} "
+          "len={:#x} offset={} lr={:#010x} count={} caller_lr={:#010x} upper_lr={:#010x} "
+          "this={:#010x} obj0={:#010x} obj80={:#010x} objA4={:#010x} objB8={:#010x} "
+          "caller_lr2={:#010x}",
+          (uint32_t)file_handle, (uint32_t)event_handle, apc_routine_ptr.guest_address(),
+          apc_context.guest_address(), io_status_block.guest_address(), buffer.guest_address(),
+          (uint32_t)buffer_length, byte_offset_ptr ? (int64_t)byte_offset : -1, guest_lr,
+          null_read_log_count, caller_lr, upper_lr, this_ptr, obj0, obj80, objA4, objB8,
+          caller_lr2);
+    } else if (null_read_log_count == 16) {
+      ++null_read_log_count;
+      REXKRNL_IMPORT_TRACE("NtReadFile",
+                           "NULL-HANDLE further null-handle reads suppressed (cap=16)");
+    }
+  }
   X_STATUS result = X_STATUS_SUCCESS;
   bool apc_queued = false;
 
diff --git a/src/kernel/xboxkrnl/xboxkrnl_rtl.cpp b/src/kernel/xboxkrnl/xboxkrnl_rtl.cpp
index db31f40..f353e3a 100644
--- a/src/kernel/xboxkrnl/xboxkrnl_rtl.cpp
+++ b/src/kernel/xboxkrnl/xboxkrnl_rtl.cpp
@@ -384,6 +384,27 @@ ppc_u32_result_t RtlInitializeCriticalSectionAndSpinCount_entry(
 }
 
 void RtlEnterCriticalSection_entry(ppc_ptr_t<X_RTL_CRITICAL_SECTION> cs) {
+  // Cycle-16 H1 guard: a null critical section is a guest-supplied null.
+  // Guest address 0 maps to a host nullptr through ArgTranslator
+  // (include/rex/ppc/function.h:326-328 = ../tools/rexglue/include/rex/ppc/
+  // function.h), so without this guard the host dereferences null+0x18
+  // (X_RTL_CRITICAL_SECTION::owning_thread, line 343) and faults with
+  // SEGV_MAPERR si_addr=0x18; the real hardware would read mapped physical
+  // 0x10..0x1C and continue. Evidence: cycle-16 m11 capture
+  // (logs/cycle16-m11-attribution.txt), guest thid 10 (host tid 578675),
+  // RIP offset 0x4554d3 `movbe 0x18(%rbx),%eax` with rbx=0, ctx.r3=0,
+  // ctx.lr=0x82b20dfc (generated/wwe13_recomp.74.cpp:37049 calls
+  // RtlEnterCriticalSection with r3=0). Leave shares the same null source;
+  // only Enter is guarded this cycle (see docs/CRASH_LOG.md cycle 16).
+  if (!cs) {
+    static volatile uint32_t null_cs_count = 0;
+    uint32_t n = rex::thread::atomic_inc(&null_cs_count);
+    if (n <= 32) {
+      REXKRNL_IMPORT_TRACE("RtlEnterCriticalSection",
+                           "null cs (guest address 0), ignoring (count={})", n);
+    }
+    return;
+  }
   uint32_t cur_thread = XThread::GetCurrentThread()->guest_object();
   uint32_t spin_count = cs->header.absolute * 256;
 
@@ -434,6 +455,28 @@ ppc_u32_result_t RtlTryEnterCriticalSection_entry(ppc_ptr_t<X_RTL_CRITICAL_SECTI
 }
 
 void RtlLeaveCriticalSection_entry(ppc_ptr_t<X_RTL_CRITICAL_SECTION> cs) {
+  // Cycle-17 H2 guard: a null critical section is a guest-supplied null.
+  // Guest address 0 maps to a host nullptr through ArgTranslator
+  // (include/rex/ppc/function.h:326-328 = ../tools/rexglue/include/rex/ppc/
+  // function.h), so without this guard the host dereferences null+0x14
+  // (X_RTL_CRITICAL_SECTION::recursion_count, line 342) and faults with
+  // SEGV_MAPERR si_addr=0x14; the real hardware would read mapped physical
+  // 0x10..0x1C and continue. Evidence: cycle-17 m11 capture
+  // (logs/cycle17-m11-attribution.txt), guest thid 10 (host tid 591272),
+  // RIP offset 0x527bb35 `movbe 0x14(%rsi),%eax` with rsi=0 -- the Leave body
+  // is inlined into its HostToGuestFunction trampoline, so the faulting ELF
+  // symbol is that trampoline rather than the out-of-line body at 0x4556f0 --
+  // ctx.r3=0, ctx.lr=0x82b20e1c (generated/wwe13_recomp.74.cpp:37064 calls
+  // RtlLeaveCriticalSection with r3=0). Enter's cycle-16 guard is unchanged.
+  if (!cs) {
+    static volatile uint32_t null_cs_count = 0;
+    uint32_t n = rex::thread::atomic_inc(&null_cs_count);
+    if (n <= 32) {
+      REXKRNL_IMPORT_TRACE("RtlLeaveCriticalSection",
+                           "null cs (guest address 0), ignoring (count={})", n);
+    }
+    return;
+  }
   assert_true(cs->owning_thread == XThread::GetCurrentThread()->guest_object());
 
   // Drop recursion count - if it isn't zero we still have the lock.
-- 
