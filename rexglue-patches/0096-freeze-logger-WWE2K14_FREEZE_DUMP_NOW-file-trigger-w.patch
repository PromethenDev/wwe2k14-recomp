From 49b3d4466a6cfec10c76e6121a987f897ac8df7d Mon Sep 17 00:00:00 2001
From: PromethenDev <PromethenDev@users.noreply.github.com>
Date: Sat, 10 Oct 2026 12:40:55 -0700
Subject: [PATCH 96/97] freeze logger: WWE2K14_FREEZE_DUMP_NOW=<file> trigger -
 when the file exists the watchdog deletes it and writes a full freeze report
 now (for the W1 DLC boot hang where frames keep presenting); off unless set


Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/core/freeze_logger.cpp | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/src/core/freeze_logger.cpp b/src/core/freeze_logger.cpp
index 0411719..9ba1a53 100644
--- a/src/core/freeze_logger.cpp
+++ b/src/core/freeze_logger.cpp
@@ -1017,6 +1017,16 @@ void Watchdog() {
       g_cpu_history_head[i] = (head + 1) % kCpuHistory;
       if (g_cpu_history_count[i] < kCpuHistory) ++g_cpu_history_count[i];
     }
+    // Diagnostic (W1 boot-hang investigation): when WWE2K14_FREEZE_DUMP_NOW names a path and that file
+    // exists, delete it and write a report immediately, whatever the present gap. Off unless the env
+    // var is set; no effect on the freeze detection below.
+    if (const char* dump_now = std::getenv("WWE2K14_FREEZE_DUMP_NOW"); dump_now && *dump_now) {
+      std::error_code ec;
+      if (std::filesystem::remove(dump_now, ec) && !ec) {
+        GenerateReport(NowNs(), g_last_present_ns.load(std::memory_order_acquire));
+        continue;
+      }
+    }
     // Load last_present before reading the clock for the gap so a present that
     // races this tick cannot make now < last_present and underflow the gap.
     const uint64_t last_present = g_last_present_ns.load(std::memory_order_acquire);
