From e6ebc241883e52983e9280e50466021498920805 Mon Sep 17 00:00:00 2001
From: PromethenDev <PromethenDev@users.noreply.github.com>
Date: Sat, 26 Sep 2026 18:59:56 -0700
Subject: [PATCH 50/97] shared memory: no heap allocation or sort per
 RequestRange(s) call

RequestRange (index buffers, changed vertex buffers, every draw) went through RequestRanges, which built a new
std::vector and sorted it per call. A member scratch vector (requests come from the command processor thread,
like upload_ranges_; nothing inside re-enters RequestRanges) and no sort for a single range.
Replay A/B (2 heavy entrance traces x300, 3 rounds): -1.4% / -0.4% frame time, images pixel-identical.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 include/rex/graphics/shared_memory.h |  1 +
 src/graphics/shared_memory.cpp       | 16 ++++++++++------
 2 files changed, 11 insertions(+), 6 deletions(-)

diff --git a/include/rex/graphics/shared_memory.h b/include/rex/graphics/shared_memory.h
index 208359b..abb870f 100644
--- a/include/rex/graphics/shared_memory.h
+++ b/include/rex/graphics/shared_memory.h
@@ -179,6 +179,7 @@ class SharedMemory {
   // Ranges that need to be uploaded, generated by GetRangesToUpload (a
   // persistently allocated vector).
   std::vector<std::pair<uint32_t, uint32_t>> upload_ranges_;
+  std::vector<std::pair<uint32_t, uint32_t>> request_ranges_scratch_;
 
   // GPU-written memory downloading for traces. <Start address, length>.
   std::vector<std::pair<uint32_t, uint32_t>> trace_download_ranges_;
diff --git a/src/graphics/shared_memory.cpp b/src/graphics/shared_memory.cpp
index 078ddd0..2b5b4db 100644
--- a/src/graphics/shared_memory.cpp
+++ b/src/graphics/shared_memory.cpp
@@ -431,8 +431,10 @@ bool SharedMemory::RequestRanges(const std::pair<uint32_t, uint32_t>* ranges, si
   }
 
   // Some texture or buffer is empty, for example - safe to draw in this case.
-  std::vector<std::pair<uint32_t, uint32_t>> merged_ranges;
-  merged_ranges.reserve(count);
+  // Member scratch (like upload_ranges_; requests come from the command processor thread): no heap allocation
+  // per request - this runs for index and vertex buffers on every draw.
+  std::vector<std::pair<uint32_t, uint32_t>>& merged_ranges = request_ranges_scratch_;
+  merged_ranges.clear();
   for (size_t i = 0; i < count; ++i) {
     uint32_t start = ranges[i].first;
     uint32_t length = ranges[i].second;
@@ -450,10 +452,12 @@ bool SharedMemory::RequestRanges(const std::pair<uint32_t, uint32_t>* ranges, si
 
   SCOPE_profile_cpu_f("gpu");
 
-  std::sort(merged_ranges.begin(), merged_ranges.end(),
-            [](const std::pair<uint32_t, uint32_t>& a, const std::pair<uint32_t, uint32_t>& b) {
-              return a.first < b.first;
-            });
+  if (merged_ranges.size() > 1) {
+    std::sort(merged_ranges.begin(), merged_ranges.end(),
+              [](const std::pair<uint32_t, uint32_t>& a, const std::pair<uint32_t, uint32_t>& b) {
+                return a.first < b.first;
+              });
+  }
   size_t merged_write = 0;
   for (size_t i = 1; i < merged_ranges.size(); ++i) {
     std::pair<uint32_t, uint32_t>& range_previous = merged_ranges[merged_write];
