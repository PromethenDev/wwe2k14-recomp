+namespace rex::input::mnk {
+
+inline bool KeyboardTextEnabled() {
+  static const bool enabled = [] {
+    const char* value = std::getenv("WWE2K14_KEYBOARD_TEXT");
+    return value && std::strcmp(value, "1") == 0;
+  }();
+  return enabled;
+}
+
+constexpr bool IsKeyboardTextAnyDeviceQuery(uint32_t flags) {
+  return (flags & 0xFF) == 0x02;
+}
+
+constexpr bool IsKeyboardTextBindKey(uint16_t virtual_key) {
+  return (virtual_key >= 'A' && virtual_key <= 'Z') ||
+         (virtual_key >= '0' && virtual_key <= '9');
+}
+
+constexpr bool ShouldSuppressKeyboardTextBind(uint16_t virtual_key,
+                                               bool keyboard_text_enabled,
+                                               bool title_polling_active) {
+  return keyboard_text_enabled && title_polling_active &&
+         IsKeyboardTextBindKey(virtual_key);
+}
+
+inline void FilterKeyboardTextBindKeys(const bool (&source)[256],
+                                       bool keyboard_text_enabled,
+                                       bool title_polling_active,
+                                       bool (&filtered)[256]) {
+  for (uint16_t virtual_key = 0; virtual_key < 256; ++virtual_key) {
+    filtered[virtual_key] =
+        source[virtual_key] &&
+        !ShouldSuppressKeyboardTextBind(virtual_key, keyboard_text_enabled,
+                                        title_polling_active);
+  }
+}
+
+constexpr int64_t kKeyboardTextPollingWindowNanoseconds = 500'000'000;
+
+constexpr bool KeyboardTextPollingIsRecent(int64_t now_nanoseconds,
+                                            int64_t last_poll_nanoseconds) {
+  return last_poll_nanoseconds > 0 && now_nanoseconds >= last_poll_nanoseconds &&
+         now_nanoseconds - last_poll_nanoseconds <=
+             kKeyboardTextPollingWindowNanoseconds;
+}
+
+inline std::atomic<int64_t>& LastKeyboardTextPollNanoseconds() {
+  static std::atomic<int64_t> last_poll{0};
+  return last_poll;
+}
+
+inline void NoteKeyboardTextKeystrokePoll(uint32_t flags) {
+  if (!KeyboardTextEnabled() || !IsKeyboardTextAnyDeviceQuery(flags)) {
+    return;
+  }
+  const auto now = std::chrono::steady_clock::now().time_since_epoch();
+  const auto nanoseconds = std::chrono::duration_cast<std::chrono::nanoseconds>(now).count();
+  LastKeyboardTextPollNanoseconds().store(nanoseconds, std::memory_order_release);
+}
+
+inline bool KeyboardTextPollingActive() {
+  if (!KeyboardTextEnabled()) {
+    return false;
+  }
+  const auto now = std::chrono::steady_clock::now().time_since_epoch();
+  const auto now_nanoseconds =
+      std::chrono::duration_cast<std::chrono::nanoseconds>(now).count();
+  const int64_t last_poll =
+      LastKeyboardTextPollNanoseconds().load(std::memory_order_acquire);
+  return KeyboardTextPollingIsRecent(now_nanoseconds, last_poll);
+}
+
+enum class KeyboardTextTraceCategory : uint8_t {
+  kCapability,
+  kKeystroke,
+  kHostInput,
+};
+
+// Each trace category is limited to 256 emitted lines per second and 4096
+// emitted lines per process. Calls beyond either budget are counted and the
+// dropped-call count is included in the next emitted line.
+inline bool KeyboardTextTracePermit(KeyboardTextTraceCategory category,
+                                    uint32_t* dropped_since_last = nullptr) {
+  if (!KeyboardTextEnabled()) {
+    return false;
+  }
+
+  struct Bucket {
+    std::mutex mutex;
+    int64_t window_start_milliseconds = 0;
+    uint32_t emitted_this_window = 0;
+    uint32_t emitted_total = 0;
+    uint32_t dropped = 0;
+  };
+  static std::array<Bucket, 3> buckets{};
+
+  const auto now = std::chrono::steady_clock::now().time_since_epoch();
+  const int64_t now_milliseconds =
+      std::chrono::duration_cast<std::chrono::milliseconds>(now).count();
+  Bucket& bucket = buckets[static_cast<std::size_t>(category)];
+  std::lock_guard lock(bucket.mutex);
+  if (bucket.window_start_milliseconds == 0 ||
+      now_milliseconds - bucket.window_start_milliseconds >= 1000) {
+    bucket.window_start_milliseconds = now_milliseconds;
+    bucket.emitted_this_window = 0;
+  }
+  if (bucket.emitted_this_window >= 256 || bucket.emitted_total >= 4096) {
+    ++bucket.dropped;
+    return false;
+  }
+
+  ++bucket.emitted_this_window;
+  ++bucket.emitted_total;
+  if (dropped_since_last) {
+    *dropped_since_last = bucket.dropped;
+  }
+  bucket.dropped = 0;
+  return true;
+}
+
+// Return the standard keyboard VK for the basic Latin characters consumed by
+// the title's custom name grid. The caller retains the original Unicode value.
+constexpr uint16_t MapKeyboardTextVirtualKey(uint16_t unicode) {
+  if (unicode >= 'A' && unicode <= 'Z') {
+    return unicode;
+  }
+  if (unicode >= 'a' && unicode <= 'z') {
+    return static_cast<uint16_t>(unicode - ('a' - 'A'));
+  }
+  if (unicode >= '0' && unicode <= '9') {
+    return unicode;
+  }
+  return 0;
+}
+
+}  // namespace rex::input::mnk
