+bool VulkanCommandProcessor::DumpEdram(std::vector<uint8_t>& out) {
+  if (!BeginSubmission(true)) {
+    return false;
+  }
+  if (!render_target_cache_->InitializeTraceSubmitDownloads()) {
+    return false;
+  }
+  if (!AwaitAllQueueOperationsCompletion()) {
+    return false;
+  }
+  return render_target_cache_->CompleteEdramDownloadTo(out);
+}
