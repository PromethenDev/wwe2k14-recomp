                      "After the window is closed, force the process to exit if shutdown has not "
@@ -358,6 +362,28 @@ bool ReXApp::OnInitialize() {
             }
             if (f) std::fclose(f);
           }
+          const std::string edram_dump_path = REXCVAR_GET(replay_trace_edram_dump);
+          if (!edram_dump_path.empty()) {
+            auto* command_processor = replay_graphics->command_processor();
+            std::vector<uint8_t> edram;
+            bool edram_ok = false;
+            if (command_processor) {
+              std::promise<bool> edram_result;
+              std::future<bool> edram_future = edram_result.get_future();
+              command_processor->CallInThread([command_processor, &edram, &edram_result]() {
+                edram_result.set_value(command_processor->DumpEdram(edram));
+              });
+              edram_ok = edram_future.get();
+            }
+            FILE* f = edram_ok ? std::fopen(edram_dump_path.c_str(), "wb") : nullptr;
+            if (!f || std::fwrite(edram.data(), 1, edram.size(), f) != edram.size()) {
+              REXLOG_ERROR("Replay dump: could not write the EDRAM to {}", edram_dump_path);
+              dumps_ok = false;
+            } else {
+              REXLOG_INFO("Replay dump: EDRAM ({} bytes) -> {}", edram.size(), edram_dump_path);
+            }
+            if (f) std::fclose(f);
+          }
           if (partial && stop_after_draw < 0) {
             REXLOG_INFO("Replay {}: partial frame, no image", dumps_ok ? "wrote" : "FAILED");
             app_context().CallInUIThread([this]() { app_context().QuitFromUIThread(); });
