+void CommandProcessor::DumpEdramAfterDraw(uint32_t ordinal) {
+  const std::string& spec = REXCVAR_GET(draw_edram_dump);
+  if (spec.empty()) {
+    return;
+  }
+  static std::vector<uint32_t> ordinals;
+  static std::string dir;
+  static bool parsed = false;
+  if (!parsed) {
+    parsed = true;
+    const size_t colon = spec.find(':');
+    if (colon == std::string::npos) {
+      REXGPU_ERROR("draw_edram_dump: expected ORD1,ORD2,...:DIR, got '{}'", spec);
+      return;
+    }
+    dir = spec.substr(colon + 1);
+    size_t pos = 0;
+    const std::string list = spec.substr(0, colon);
+    while (pos < list.size()) {
+      size_t end = list.find(',', pos);
+      if (end == std::string::npos) end = list.size();
+      ordinals.push_back(uint32_t(std::strtoul(list.substr(pos, end - pos).c_str(), nullptr, 0)));
+      pos = end + 1;
+    }
+  }
+  if (std::find(ordinals.begin(), ordinals.end(), ordinal) == ordinals.end()) {
+    return;
+  }
+  std::vector<uint8_t> edram;
+  const std::string path = dir + "/sdk-edram-" + std::to_string(ordinal) + ".bin";
+  FILE* f = DumpEdram(edram) ? std::fopen(path.c_str(), "wb") : nullptr;
+  if (!f || std::fwrite(edram.data(), 1, edram.size(), f) != edram.size()) {
+    REXGPU_ERROR("draw_edram_dump: could not write the EDRAM after draw {} to {}", ordinal, path);
+  } else {
+    REXGPU_INFO("draw_edram_dump: EDRAM after draw {} -> {}", ordinal, path);
+  }
+  if (f) std::fclose(f);
+}
+
 void CommandProcessor::DumpDrawState(uint32_t ordinal, uint32_t draw_initiator,
                                      const IndexBufferInfo* index_info) {
   const std::string& spec = REXCVAR_GET(draw_state_dump);
@@ -1983,6 +2026,7 @@ bool CommandProcessor::ExecutePacketType3Draw(memory::RingBuffer* reader, uint32
   // for instance, features not supported by the host), don't terminate command
   // buffer processing as that would leave rendering in a way more inconsistent
   // state than just a single dropped draw command.
+  DumpEdramAfterDraw(current_draw_ordinal_);
   return true;
 }
 
