+// Read a config stream into memory so parsing is independent of the host
+// filesystem's narrow-path encoding. Kept separate from LoadConfig so the
+// byte-reading behavior can be exercised through the cvar config-loading API.
+bool ReadFileContents(FILE* file, std::string& contents) {
+  char buffer[65536];
+  size_t read_count;
+  while ((read_count = std::fread(buffer, 1, sizeof(buffer), file)) > 0) {
+    contents.append(buffer, read_count);
+  }
+  return std::ferror(file) == 0;
+}
