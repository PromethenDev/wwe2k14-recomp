@@ -36,6 +45,77 @@ namespace rex {
 
 namespace {
 
+#if REX_PLATFORM_WIN32
+// spdlog's default file sink opens narrow paths using the active Windows code
+// page. This sink accepts UTF-8 paths and opens them with the SDK's _wfopen
+// wrapper instead.
+class Utf8PathFileSink final : public spdlog::sinks::base_sink<std::mutex> {
+ public:
+  Utf8PathFileSink(const std::string& utf8_path, bool truncate) : utf8_path_(utf8_path) {
+    const std::filesystem::path path = rex::to_path(utf8_path);
+    std::error_code ec;
+    if (!path.parent_path().empty()) {
+      std::filesystem::create_directories(path.parent_path(), ec);
+    }
+    // Same open policy as spdlog's file_helper: truncate first, then keep the live stream in
+    // append mode, and retry a few times (a sync client or virus scanner may hold the file briefly).
+    constexpr int kOpenTries = 5;
+    for (int attempt = 0; attempt < kOpenTries && !file_; ++attempt) {
+      if (attempt) {
+        std::this_thread::sleep_for(std::chrono::milliseconds(10));
+      }
+      if (truncate) {
+        if (FILE* truncated = rex::filesystem::OpenFile(path, "wb")) {
+          std::fclose(truncated);
+        } else {
+          continue;
+        }
+      }
+      file_ = rex::filesystem::OpenFile(path, "ab");
+    }
+    if (!file_) {
+      throw spdlog::spdlog_ex("Failed opening log file " + utf8_path + " for writing", errno);
+    }
+  }
+
+  ~Utf8PathFileSink() override {
+    if (file_) {
+      std::fclose(file_);
+      file_ = nullptr;
+    }
+  }
+
+ protected:
+  void sink_it_(const spdlog::details::log_msg& msg) override {
+    spdlog::memory_buf_t formatted;
+    formatter_->format(msg, formatted);
+    if (std::fwrite(formatted.data(), 1, formatted.size(), file_) != formatted.size()) {
+      throw spdlog::spdlog_ex("Failed writing to log file " + utf8_path_, errno);
+    }
+  }
+
+  void flush_() override {
+    if (file_ && std::fflush(file_) != 0) {
+      throw spdlog::spdlog_ex("Failed flushing log file " + utf8_path_, errno);
+    }
+  }
+
+ private:
+  std::string utf8_path_;
+  FILE* file_ = nullptr;
+};
+#endif  // REX_PLATFORM_WIN32
+
+// Use the ordinary spdlog sink off Windows; on Windows route the same UTF-8
+// cvar path through the SDK's wide-file API.
+spdlog::sink_ptr MakeFileSink(const std::string& utf8_path, bool truncate) {
+#if REX_PLATFORM_WIN32
+  return std::make_shared<Utf8PathFileSink>(utf8_path, truncate);
+#else
+  return std::make_shared<spdlog::sinks::basic_file_sink_mt>(utf8_path, truncate);
+#endif
+}
+
 // Category registry — indices 0..kBuiltinCount-1 are SDK built-ins.
 std::vector<LogCategoryEntry> g_registry;
 
@@ -123,8 +203,17 @@ void InitLogging(const LogConfig& config) {
       new_sinks.push_back(std::move(sink));
