+    spdlog::sink_ptr file_sink;
     if (config.log_file && (!g_file_sink || g_file_path != config.log_file)) {
-      auto sink = std::make_shared<spdlog::sinks::basic_file_sink_mt>(config.log_file, true);
+      // A log file that cannot be opened (read-only or cloud-synced folder) must not stop the game.
+      try {
+        file_sink = MakeFileSink(config.log_file, true);
+      } catch (const spdlog::spdlog_ex& e) {
+        std::fprintf(stderr, "Logging: %s; continuing without a log file\n", e.what());
+      }
+    }
+    if (file_sink) {
+      auto sink = std::move(file_sink);
       sink->set_level(spdlog::level::trace);
       sink->set_pattern(config.file_pattern);
       replaced_file_sink = std::move(g_file_sink);
@@ -163,7 +252,7 @@ void InitLogging(const LogConfig& config) {
 
   // Create file sink
   if (config.log_file) {
-    auto sink = std::make_shared<spdlog::sinks::basic_file_sink_mt>(config.log_file, true);
