+// XMPSetPlaybackBehavior repeat word (0x70008, third word) values that restart the single custom
+// selection at end of file. EVIDENCE: the 2K14 title sends repeat=1 after a custom play
+// (generated/wwe2k14_recomp.70.cpp:24776-24786). INFERENCE (unproven): 1 = repeat-one, 2 =
+// repeat-all (no guest site sends 2); the SDK enum names only 0 (kUnknown). Both loop because a
+// custom selection is a single song. Settle with the [xmp-fix] repeat log lines of one owner run.
+constexpr uint32_t kCustomRepeatOneCandidate = 1;
+constexpr uint32_t kCustomRepeatAllCandidate = 2;
+constexpr bool CustomRepeatModeLoops(uint32_t repeat_mode) {
+  return repeat_mode == kCustomRepeatOneCandidate || repeat_mode == kCustomRepeatAllCandidate;
+}
