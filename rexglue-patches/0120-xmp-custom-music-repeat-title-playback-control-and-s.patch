+/**
+ * @file custom_music_player_test.cpp
+ * @brief Host-side tests for decoded custom XMP music behavior.
+ */
+
+#include <array>
+#include <chrono>
+#include <cstdint>
+#include <filesystem>
+#include <fstream>
+#include <stdexcept>
+#include <string>
+#include <thread>
+#include <vector>
+
+#include <catch2/catch_approx.hpp>
+#include <catch2/catch_test_macros.hpp>
+
+#include <rex/audio/custom_music_player.h>
+
+namespace {
+
+void WriteU16(std::ofstream& stream, uint16_t value) {
+  const std::array<char, 2> bytes = {static_cast<char>(value & 0xFF),
+                                     static_cast<char>((value >> 8) & 0xFF)};
+  stream.write(bytes.data(), bytes.size());
+}
+
+void WriteU32(std::ofstream& stream, uint32_t value) {
+  const std::array<char, 4> bytes = {static_cast<char>(value & 0xFF),
+                                     static_cast<char>((value >> 8) & 0xFF),
+                                     static_cast<char>((value >> 16) & 0xFF),
+                                     static_cast<char>((value >> 24) & 0xFF)};
+  stream.write(bytes.data(), bytes.size());
+}
+
+struct TempWave {
+  std::filesystem::path path;
+
+  ~TempWave() {
+    std::error_code error;
+    std::filesystem::remove(path, error);
+  }
+};
+
+TempWave MakeShortWave() {
+  constexpr uint32_t kRate = 48000;
+  constexpr std::array<int16_t, 4> kSamples = {8192, 16384, 24576, 32767};
+  constexpr uint32_t kDataBytes = kSamples.size() * sizeof(int16_t);
+  const auto unique = std::chrono::steady_clock::now().time_since_epoch().count();
+  TempWave wave{std::filesystem::temp_directory_path() /
+                ("rex_xmp_music_test_" + std::to_string(unique) + ".wav")};
+
+  std::ofstream stream(wave.path, std::ios::binary | std::ios::trunc);
+  if (!stream) {
+    throw std::runtime_error("could not create test WAV");
+  }
+  stream.write("RIFF", 4);
+  WriteU32(stream, 36 + kDataBytes);
+  stream.write("WAVEfmt ", 8);
+  WriteU32(stream, 16);
+  WriteU16(stream, 1);  // PCM
+  WriteU16(stream, 1);  // mono
+  WriteU32(stream, kRate);
+  WriteU32(stream, kRate * sizeof(int16_t));
+  WriteU16(stream, sizeof(int16_t));
+  WriteU16(stream, 16);
+  stream.write("data", 4);
+  WriteU32(stream, kDataBytes);
+  for (const int16_t sample : kSamples) {
+    WriteU16(stream, static_cast<uint16_t>(sample));
+  }
+  stream.close();
+  if (!stream) {
+    throw std::runtime_error("could not finish test WAV");
+  }
+  return wave;
+}
+
+bool WaitForPlaying(rex::audio::CustomMusicPlayer& player) {
+  for (uint32_t attempt = 0; attempt < 2000; ++attempt) {
+    if (player.IsPlaying()) {
+      return true;
+    }
+    std::this_thread::sleep_for(std::chrono::milliseconds(1));
+  }
+  return false;
+}
+
+void StartTrack(rex::audio::CustomMusicPlayer& player, const std::filesystem::path& path,
+               uint32_t repeat_mode) {
+  player.Stop();
+  player.SetTitleHasPlaybackControl(false);
+  player.SetRepeatMode(repeat_mode);
+  REQUIRE(player.Play(path, "unit test"));
+  REQUIRE(WaitForPlaying(player));
+}
+
+}  // namespace
+
+TEST_CASE("custom XMP music decodes WAV and follows repeat/pause/stop state", "[custom_music]") {
+  using rex::audio::CustomMusicPlayer;
+
+  TempWave wave = MakeShortWave();
+  std::string error;
+  auto decoded = rex::audio::DecodeCustomMusicFile(wave.path, 48000, &error);
+  REQUIRE(decoded);
+  CHECK(decoded->decoder == "dr_wav");
+  REQUIRE(decoded->samples.size() == 8);
+  CHECK(decoded->samples[0] == Catch::Approx(0.25f).margin(0.0001f));
+  CHECK(decoded->samples[1] == 0.0f);
+
+  auto& player = CustomMusicPlayer::instance();
+  player.SetVolume(1.0f);
+
+  SECTION("repeat-one and repeat-playlist restart the selected custom track") {
+    for (const uint32_t repeat_mode : {1u, 2u}) {
+      StartTrack(player, wave.path, repeat_mode);
+      std::array<float, 12> output{};
+      player.MixFrames(output.data(), 6, 48000, 2);
+      CHECK(output[0] == Catch::Approx(0.25f).margin(0.0001f));
+      CHECK(output[2] == Catch::Approx(0.5f).margin(0.0001f));
+      CHECK(output[4] == Catch::Approx(0.75f).margin(0.0001f));
+      CHECK(output[6] == Catch::Approx(32767.0f / 32768.0f).margin(0.0001f));
+      CHECK(output[8] == Catch::Approx(0.25f).margin(0.0001f));
+      CHECK(output[10] == Catch::Approx(0.5f).margin(0.0001f));
+      CHECK(player.IsActive());
+    }
+    player.Stop();
+  }
+
+  SECTION("no-repeat stops at EOF and becomes inactive") {
+    StartTrack(player, wave.path, 0);
+    std::array<float, 12> output{};
+    player.MixFrames(output.data(), 6, 48000, 2);
+    CHECK(output[0] == Catch::Approx(0.25f).margin(0.0001f));
+    CHECK(output[6] == Catch::Approx(32767.0f / 32768.0f).margin(0.0001f));
+    CHECK(output[8] == 0.0f);
+    CHECK(output[10] == 0.0f);
+    CHECK_FALSE(player.IsActive());
+    CHECK_FALSE(player.IsPlaying());
+    std::array<float, 2> stopped_output{};
+    player.MixFrames(stopped_output.data(), 1, 48000, 2);
+    CHECK(stopped_output[0] == 0.0f);
+    CHECK(stopped_output[1] == 0.0f);
+  }
+
+  SECTION("pause and title control silence without advancing; stop silences") {
+    StartTrack(player, wave.path, 1);
+    std::array<float, 2> output{};
+    player.MixFrames(output.data(), 1, 48000, 2);
+    CHECK(output[0] == Catch::Approx(0.25f).margin(0.0001f));
+
+    player.Pause(true);
+    output.fill(0.0f);
+    player.MixFrames(output.data(), 1, 48000, 2);
+    CHECK(output[0] == 0.0f);
+    player.Continue();
+    output.fill(0.0f);
+    player.MixFrames(output.data(), 1, 48000, 2);
+    CHECK(output[0] == Catch::Approx(0.5f).margin(0.0001f));
+
+    player.SetTitleHasPlaybackControl(true);
+    output.fill(0.0f);
+    player.MixFrames(output.data(), 1, 48000, 2);
+    CHECK(output[0] == 0.0f);
+    player.SetTitleHasPlaybackControl(false);
+    output.fill(0.0f);
+    player.MixFrames(output.data(), 1, 48000, 2);
+    CHECK(output[0] == Catch::Approx(0.75f).margin(0.0001f));
+
+    player.Stop();
+    output.fill(0.0f);
+    player.MixFrames(output.data(), 1, 48000, 2);
+    CHECK(output[0] == 0.0f);
+    CHECK_FALSE(player.IsActive());
+  }
+  SECTION("repeat mapping constants: only the named candidates loop") {
+    CHECK_FALSE(rex::audio::CustomRepeatModeLoops(0));
+    CHECK(rex::audio::CustomRepeatModeLoops(rex::audio::kCustomRepeatOneCandidate));
+    CHECK(rex::audio::CustomRepeatModeLoops(rex::audio::kCustomRepeatAllCandidate));
+    CHECK_FALSE(rex::audio::CustomRepeatModeLoops(3));
+    StartTrack(player, wave.path, 3);
+    std::array<float, 12> output{};
+    player.MixFrames(output.data(), 6, 48000, 2);
+    CHECK(output[8] == 0.0f);
+    CHECK_FALSE(player.IsActive());
+  }
+
+  SECTION("explicit stop after a loop ends playback even with repeat on") {
+    StartTrack(player, wave.path, 1);
+    std::array<float, 12> output{};
+    player.MixFrames(output.data(), 6, 48000, 2);
+    CHECK(output[8] == Catch::Approx(0.25f).margin(0.0001f));  // looped once
+    player.Stop();
+    output.fill(0.0f);
+    player.MixFrames(output.data(), 2, 48000, 2);
+    CHECK(output[0] == 0.0f);
+    CHECK_FALSE(player.IsActive());
+  }
+
+  SECTION("pause under title control, then release control: stays silent until continue") {
+    StartTrack(player, wave.path, 1);
+    player.SetTitleHasPlaybackControl(true);
+    player.Pause(true);  // XMPPause while the title has control
+    player.SetTitleHasPlaybackControl(false);
+    std::array<float, 2> output{};
+    player.MixFrames(output.data(), 1, 48000, 2);
+    CHECK(output[0] == 0.0f);  // explicit pause survives the release
+    CHECK(player.IsPaused());
+    player.Continue();
+    output.fill(0.0f);
+    player.MixFrames(output.data(), 1, 48000, 2);
+    CHECK(output[0] == Catch::Approx(0.25f).margin(0.0001f));
+    player.Stop();
+  }
+
+  SECTION("pause then continue under title control: release resumes (no stuck latch)") {
+    StartTrack(player, wave.path, 1);
+    player.SetTitleHasPlaybackControl(true);
+    player.Pause(true);
+    player.Continue();  // XMPContinue always reaches the player now
+    CHECK_FALSE(player.IsExplicitlyPaused());
+    std::array<float, 2> output{};
+    player.MixFrames(output.data(), 1, 48000, 2);
+    CHECK(output[0] == 0.0f);  // still silent: the title has control
+    player.SetTitleHasPlaybackControl(false);
+    CHECK(player.IsPlaying());
+    player.MixFrames(output.data(), 1, 48000, 2);
+    CHECK(output[0] == Catch::Approx(0.25f).margin(0.0001f));
+    player.Stop();
+  }
+}
