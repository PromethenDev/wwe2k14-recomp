+// Control-ownership mapping for 0x7001A (XMPSetPlaybackController {client, controller, word2}).
+//
+// PROVEN (generated code): the title polls 0x7001B through sub_82E1E2A0
+// (generated/wwe2k14_recomp.98.cpp:28442-28490), which outputs 1 only when BOTH returned words are
+// zero. Its caller (wwe2k14_recomp.104.cpp:64484-64515) sets bit 0x8 on a music object when that
+// output is 0 and then calls sub_82EED138 (an indirect vtable call with a float argument). The
+// title acquires with (controller=0, word2=1) in sub_82E1DBD8 (98.cpp:27455-27480) and releases
+// with (0,0) or (4,0) in sub_82E1DCB0 (98.cpp:27580-27625).
+// NOT PROVEN: what word2 means. The SDK enum (xmp_app.h) names 0=kSystem, 1=kTitle, but those
+// names are a guess carried over from Xenia. kPoll (default) follows the poll: "title has
+// playback control" == (controller==0 && word2==0), the Xbox 360 XMPTitleHasPlaybackControl
+// meaning, under which the game's own music is audible and the custom song must be silent.
+// kEnum follows the SDK enum names: title owns playback when word2 == kTitle(1).
+// WWE2K14_XMP_CONTROL_MAP=enum selects kEnum for A/B diagnosis; the [xmp-fix] controller lines
+// log both interpretations on every transition so one owner run decides.
+bool XmpControlMapEnum() {
+  static const bool enum_map = [] {
+    const char* value = std::getenv("WWE2K14_XMP_CONTROL_MAP");
+    return value && std::strcmp(value, "enum") == 0;
+  }();
+  return enum_map;
+}
+
+bool TitleHasPlaybackControlFor(uint32_t controller, uint32_t word2) {
+  if (XmpControlMapEnum()) {
+    return word2 == static_cast<uint32_t>(XmpApp::PlaybackClient::kTitle);
+  }
+  return controller == 0 && word2 == 0;
+}
+
+// Bounded [xmp-fix] event lines (repeat value, controller transitions, play/pause/continue/stop):
+// the first 256, then one in 50.
+bool XmpFixEventLog() {
+  if (!XmpFixEnabled()) {
+    return false;
+  }
+  static std::atomic<uint64_t> count{0};
+  const uint64_t n = count.fetch_add(1, std::memory_order_relaxed) + 1;
+  return n <= 256 || n % 50 == 0;
+}
+
+void LogXmpMessage(uint32_t message, uint32_t buffer_length, const uint8_t* buffer) {
+  struct DiagnosticState {
+    std::mutex mutex;
+    uint64_t total = 0;
+    std::chrono::steady_clock::time_point last_summary = std::chrono::steady_clock::now();
+    // At most kMaxTrackedIds distinct ids are tracked (the rest share one overflow counter) so the
+    // map and the summary line stay bounded whatever the guest sends.
+    size_t max_tracked_ids = 64;
+    std::map<uint32_t, uint64_t> per_message;
+    uint64_t overflow = 0;
+  };
+  static DiagnosticState diagnostic;
+
+  std::lock_guard<std::mutex> guard(diagnostic.mutex);
+  ++diagnostic.total;
+  if (diagnostic.per_message.count(message) || diagnostic.per_message.size() < diagnostic.max_tracked_ids) {
+    ++diagnostic.per_message[message];
+  } else {
+    ++diagnostic.overflow;
+  }
+  if (diagnostic.total <= 200) {
+    const uint32_t word_count = std::min<uint32_t>(buffer_length / sizeof(uint32_t), 4);
+    std::ostringstream words;
+    words << std::hex << std::uppercase << std::setfill('0');
+    for (uint32_t i = 0; i < word_count; ++i) {
+      if (i) {
+        words << ',';
+      }
+      words << "0x" << std::setw(8)
+            << memory::load_and_swap<uint32_t>(buffer + i * sizeof(uint32_t));
+    }
+    REXKRNL_INFO("[xmp-message] app=0xFA id=0x{:08X} len={} words=[{}] total={}", message,
+                 buffer_length, words.str(), diagnostic.total);
+    return;
+  }
+
+  const auto now = std::chrono::steady_clock::now();
+  if (now - diagnostic.last_summary < std::chrono::seconds(60)) {
+    return;
+  }
+  std::ostringstream counts;
+  counts << std::hex << std::uppercase << std::setfill('0');
+  for (const auto& [id, count] : diagnostic.per_message) {
+    if (counts.tellp() > 0) {
+      counts << ',';
+    }
+    counts << "0x" << std::setw(8) << id << '=' << std::dec << count << std::hex;
+  }
+  REXKRNL_INFO("[xmp-message-counts] total={} per_id={} other_ids={}", diagnostic.total,
+               counts.str(), diagnostic.overflow);
+  diagnostic.last_summary = now;
+}
+
