From 591170195331a86febb91f28a3f93bf13cee5100 Mon Sep 17 00:00:00 2001
From: PromethenDev <PromethenDev@users.noreply.github.com>
Date: Mon, 28 Sep 2026 10:25:09 -0700
Subject: [PATCH 60/97] debug_ui cvar (default off): gate built-in overlays, F9
 trace, console log capture and the Windows console; player-visible window
 title via GetWindowTitle()

Release profile for WWE '13 Classic v1.0 (game ACTION-LIST D1). Wine gate PASS (d1-release-rerun, exe dad8aa66).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 include/rex/rex_app.h            |  3 ++
 src/ui/rex_app.cpp               | 50 +++++++++++++++++++-------------
 src/ui/windowed_app_main_win.cpp |  3 +-
 3 files changed, 35 insertions(+), 21 deletions(-)

diff --git a/include/rex/rex_app.h b/include/rex/rex_app.h
index e644ab3..6865a50 100644
--- a/include/rex/rex_app.h
+++ b/include/rex/rex_app.h
@@ -91,6 +91,9 @@ class ReXApp : public ui::WindowedApp, public ui::WindowListener, public ui::Win
   /// Called after runtime is fully initialized, before window creation.
   virtual void OnPostSetup() {}
 
+  /// Window title shown to the player. Defaults to the application name.
+  virtual std::string_view GetWindowTitle() const { return GetName(); }
+
   /// Called after ImGui drawer is created. Add custom dialogs here.
   virtual void OnCreateDialogs(ui::ImGuiDrawer* drawer) { (void)drawer; }
 
diff --git a/src/ui/rex_app.cpp b/src/ui/rex_app.cpp
index f99e258..43a8813 100644
--- a/src/ui/rex_app.cpp
+++ b/src/ui/rex_app.cpp
@@ -55,6 +55,9 @@ REXCVAR_DEFINE_INT32(replay_trace_repeat, 1, "GPU",
 REXCVAR_DEFINE_STRING(replay_trace_out, "", "GPU",
                       "Output image (.ppm) for replay_trace; default: trace path + .ppm");
 REXCVAR_DEFINE_STRING(update_data_root, "", "Runtime", "Override update data path");
+REXCVAR_DEFINE_BOOL(debug_ui, false, "UI/Debug",
+                    "Enable developer overlays, hotkeys, and the Windows console")
+    .lifecycle(rex::cvar::Lifecycle::kRequiresRestart);
 
 namespace rex {
 
@@ -113,17 +116,24 @@ bool ReXApp::OnInitialize() {
   rex::InitLogging(log_config);
   rex::RegisterLogLevelCallback();
 
-  // Attach log capture sink to all loggers for the console overlay
-  log_sink_ = std::make_shared<rex::LogCaptureSink>();
-  rex::AddSink(log_sink_);
-
   // Load saved config (CVARs) before anything reads them
+  // The launch profile is a runtime choice, not a saved preference. Keep the
+  // command-line/environment value authoritative if a config contains it.
+  const bool debug_ui_requested = REXCVAR_GET(debug_ui);
   auto config_path = exe_dir / (std::string(GetName()) + ".toml");
   if (std::filesystem::exists(config_path)) {
     rex::cvar::LoadConfig(config_path);
+    REXCVAR_SET(debug_ui, debug_ui_requested);
     REXLOG_INFO("Loaded config: {}", config_path.filename().string());
   }
 
+  // Capture logs only when the debug console is available.
+  if (REXCVAR_GET(debug_ui)) {
+    log_sink_ = std::make_shared<rex::LogCaptureSink>();
+    rex::AddSink(log_sink_);
+  }
+  REXLOG_INFO("[ui] debug_ui={}", REXCVAR_GET(debug_ui) ? "true" : "false");
+
   REXLOG_INFO("{} starting", GetName());
   REXLOG_INFO("  Game directory: {}", game_data_root_.string());
   if (!user_data_root_.empty()) {
@@ -196,17 +206,13 @@ bool ReXApp::OnInitialize() {
   // Notify subclass
   OnPostSetup();
 
-  // Create window
-  window_ = rex::ui::Window::Create(app_context(), GetName(), 1280, 720);
+  // Create window with the consumer-provided, player-visible title.
+  window_ = rex::ui::Window::Create(app_context(), GetWindowTitle(), 1280, 720);
   if (!window_) {
     REXLOG_ERROR("Failed to create window");
     return false;
   }
 
-  // Set window title with SDK build stamp
-  std::string title = std::string(GetName()) + " " + REXGLUE_BUILD_TITLE;
-  window_->SetTitle(title);
-
   window_->AddListener(this);
   window_->AddInputListener(this, 0);
 
@@ -234,11 +240,13 @@ bool ReXApp::OnInitialize() {
         immediate_drawer_->SetPresenter(presenter);
         imgui_drawer_ = std::make_unique<rex::ui::ImGuiDrawer>(window_.get(), 64);
         imgui_drawer_->SetPresenterAndImmediateDrawer(presenter, immediate_drawer_.get());
-        // Built-in overlays
-        debug_overlay_ = std::make_unique<ui::DebugOverlayDialog>(imgui_drawer_.get());
-        console_overlay_ = std::make_unique<ui::ConsoleDialog>(imgui_drawer_.get(), log_sink_);
-        settings_overlay_ = std::make_unique<ui::SettingsDialog>(
-            imgui_drawer_.get(), exe_dir / (std::string(GetName()) + ".toml"));
+        // Built-in overlays are developer UI and do not exist in the release profile.
+        if (REXCVAR_GET(debug_ui)) {
+          debug_overlay_ = std::make_unique<ui::DebugOverlayDialog>(imgui_drawer_.get());
+          console_overlay_ = std::make_unique<ui::ConsoleDialog>(imgui_drawer_.get(), log_sink_);
+          settings_overlay_ = std::make_unique<ui::SettingsDialog>(
+              imgui_drawer_.get(), exe_dir / (std::string(GetName()) + ".toml"));
+        }
 
         // Allow subclass to add custom dialogs
         OnCreateDialogs(imgui_drawer_.get());
@@ -257,11 +265,13 @@ bool ReXApp::OnInitialize() {
 
     // Single-frame GPU trace (.xtr) written to trace_gpu_prefix, for offline
     // inspection with the trace dump tool.
-    rex::ui::RegisterBind("bind_gpu_frame_trace", "F9", "Capture a single-frame GPU trace",
-                          [graphics_system] {
-                            REXLOG_INFO("GPU frame trace requested");
-                            graphics_system->RequestFrameTrace();
-                          });
+    if (REXCVAR_GET(debug_ui)) {
+      rex::ui::RegisterBind("bind_gpu_frame_trace", "F9", "Capture a single-frame GPU trace",
+                            [graphics_system] {
+                              REXLOG_INFO("GPU frame trace requested");
+                              graphics_system->RequestFrameTrace();
+                            });
+    }
   }
 
   if (!REXCVAR_GET(replay_trace).empty()) {
diff --git a/src/ui/windowed_app_main_win.cpp b/src/ui/windowed_app_main_win.cpp
index 33092ba..3f223c4 100644
--- a/src/ui/windowed_app_main_win.cpp
+++ b/src/ui/windowed_app_main_win.cpp
@@ -23,6 +23,7 @@
 #include <rex/ui/windowed_app_context_win.h>
 
 REXCVAR_DEFINE_BOOL(enable_console, true, "UI/Window", "Enable console window on Windows");
+REXCVAR_DECLARE(bool, debug_ui);
 
 namespace {
 
@@ -69,7 +70,7 @@ int WINAPI wWinMain(HINSTANCE hinstance, HINSTANCE hinstance_prev, LPWSTR comman
   rex::cvar::ApplyEnvironment();
 
   // Allocate a console for debugging if enabled
-  if (REXCVAR_GET(enable_console)) {
+  if (REXCVAR_GET(debug_ui) && REXCVAR_GET(enable_console)) {
     AllocConsole();
     FILE* fp;
     freopen_s(&fp, "CONOUT$", "w", stdout);
-- 
