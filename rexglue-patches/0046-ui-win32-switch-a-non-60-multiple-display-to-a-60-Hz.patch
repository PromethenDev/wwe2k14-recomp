 void Win32Window::ApplyFullscreenEntry(WindowDestructionReceiver& destruction_receiver) {
   if (!IsFullscreen()) {
     return;
@@ -703,14 +824,19 @@ void Win32Window::ApplyFullscreenEntry(WindowDestructionReceiver& destruction_re
