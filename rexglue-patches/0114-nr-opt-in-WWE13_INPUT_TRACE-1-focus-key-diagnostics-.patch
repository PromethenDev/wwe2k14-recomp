 namespace {
 
+// Opt-in input diagnostics for the window message pump. The environment
+// variable is read once on first use; when unset, the checks are constant false
+// and no message is logged.
+bool InputTraceEnabled() {
+  static const bool enabled = std::getenv("WWE13_INPUT_TRACE") != nullptr;
+  return enabled;
+}
+
+// Logs the focus/activation transitions and the first 20 WM_KEYDOWN messages.
+void LogInputTraceWindowMessage(HWND hWnd, UINT message, WPARAM wParam) {
+  switch (message) {
+    case WM_SETFOCUS:
+      REXLOG_INFO("[input-trace] wm_setfocus hwnd={}", static_cast<const void*>(hWnd));
+      break;
+    case WM_KILLFOCUS:
+      REXLOG_INFO("[input-trace] wm_killfocus hwnd={}", static_cast<const void*>(hWnd));
+      break;
+    case WM_ACTIVATE:
+      REXLOG_INFO("[input-trace] wm_activate wparam={} hwnd={}", static_cast<uint32_t>(wParam),
+                  static_cast<const void*>(hWnd));
+      break;
+    case WM_KEYDOWN: {
+      static uint32_t keydown_log_count = 0;
+      if (keydown_log_count < 20) {
+        ++keydown_log_count;
+        REXLOG_INFO("[input-trace] wm_keydown vk={} count={} hwnd={}",
+                    static_cast<uint32_t>(wParam), keydown_log_count,
+                    static_cast<const void*>(hWnd));
+      }
+    } break;
+    default:
+      break;
+  }
+}
+
 uint32_t ResolveWindowWidth(uint32_t requested_width) {
   if (REXCVAR_GET(window_width) > 0) {
     return uint32_t(REXCVAR_GET(window_width));
@@ -1184,6 +1220,9 @@ void Win32Window::AutoHideCursorTimerCallback(void* parameter, BOOLEAN timer_or_
 }
 
 LRESULT Win32Window::WndProc(HWND hWnd, UINT message, WPARAM wParam, LPARAM lParam) {
+  if (InputTraceEnabled()) {
+    LogInputTraceWindowMessage(hWnd, message, wParam);
+  }
   if (message >= WM_MOUSEFIRST && message <= WM_MOUSELAST) {
     WindowDestructionReceiver destruction_receiver(this);
     // Returning immediately anyway - no need to check
