@@ -149,7 +159,61 @@ X_STATUS GraphicsSystem::Setup(runtime::FunctionDispatcher* function_dispatcher,
         uint64_t next_deadline = chrono::Clock::QueryGuestTickCount() + interval_ticks;
         // Avoid replaying missed vblanks after a long stall or suspend.
         constexpr uint64_t kResyncAfterIntervals = 3;
+        // vsync_host_display: guest vblanks on the host display's vertical blanks (every Nth when the display runs
+        // at N times the guest rate) instead of a free-running timer. A timer drifts against the display, and when
+        // presents land near the display's refresh they alternate between making and missing it (repeated and
+        // skipped frames at a steady 60). Falls back to the timer when the display rate is not a multiple, the wait
+        // fails or returns implausibly fast, or a wait blocks for longer than a few periods.
+        using SteadyClock = std::chrono::steady_clock;
+        const auto guest_period =
+            std::chrono::duration_cast<SteadyClock::duration>(std::chrono::duration<double>(1.0 / refresh_rate_hz));
+        auto host_refresh_check_time = SteadyClock::time_point();
+        auto host_sync_suspended_until = SteadyClock::time_point();
+        auto last_host_vblank_time = SteadyClock::time_point();
+        uint32_t host_divider = 0;
+        uint32_t logged_host_divider = UINT32_MAX;
+        uint64_t host_vblank_index = 0;
         while (vsync_worker_running_) {
+          if (vsync_enabled && REXCVAR_GET(vsync_host_display) && presenter()) {
+            auto now = SteadyClock::now();
+            if (now >= host_refresh_check_time) {
+              host_refresh_check_time = now + std::chrono::seconds(1);
+              const uint32_t host_hz = presenter()->GetHostDisplayRefreshHz();
+              host_divider = 0;
+              for (uint32_t divider = 1; divider <= 4 && host_hz; ++divider) {
+                if (std::abs(double(host_hz) - refresh_rate_hz * divider) <= 1.5) {
+                  host_divider = divider;
+                  break;
+                }
+              }
+              if (host_divider != logged_host_divider) {
+                logged_host_divider = host_divider;
+                REXGPU_INFO("[host-vsync] display {} Hz: {}", host_hz,
+                            host_divider ? fmt::format("guest vblank on every {} display vblank(s)", host_divider)
+                                         : std::string("not a multiple of the guest rate, timer vblank"));
+              }
+            }
+            if (host_divider && now >= host_sync_suspended_until) {
+              const auto wait_start = SteadyClock::now();
+              const bool waited = presenter()->WaitForHostDisplayVBlank();
+              now = SteadyClock::now();
+              const auto host_period = guest_period / host_divider;
+              if (waited && now - wait_start > host_period * 4) {
+                // Display asleep or the output is stalling: don't hold the guest to it.
+                REXGPU_WARN("[host-vsync] display vblank wait took {} ms, timer vblank for 5 s",
+                            std::chrono::duration_cast<std::chrono::milliseconds>(now - wait_start).count());
+                host_sync_suspended_until = now + std::chrono::seconds(5);
+              } else if (waited && now - last_host_vblank_time >= host_period / 2) {
+                last_host_vblank_time = now;
+                if (++host_vblank_index % host_divider == 0) {
+                  MarkVblank();
+                  // Keep the timer path's phase right after this vblank if it takes over.
+                  next_deadline = chrono::Clock::QueryGuestTickCount() + interval_ticks;
+                }
+                continue;
+              }
+            }
+          }
           uint64_t current_time = chrono::Clock::QueryGuestTickCount();
           const bool current_vsync_enabled = REXCVAR_GET(vsync);
           if (current_vsync_enabled != vsync_enabled) {
@@ -183,6 +247,12 @@ X_STATUS GraphicsSystem::Setup(runtime::FunctionDispatcher* function_dispatcher,
