+// One per blocked multi-object (or alertable) wait; lives on the waiting thread's stack. Signal
+// operations and queued user callbacks set `notified` and wake the waiter, which re-checks its
+// handles. This replaces the former trylock/yield/1 ms polling loop (which burned a core).
+struct WaitBlock {
+  std::mutex mutex;
+  std::condition_variable cv;
+  bool notified = false;  // Protected by mutex.
+
+  void Notify() {
+    {
+      std::lock_guard<std::mutex> lock(mutex);
+      notified = true;
+    }
+    cv.notify_one();
+  }
+};
