+    const auto elapsed = std::chrono::steady_clock::now() - start;
+    signaler.join();
+    CHECK(result.first == WaitResult::kSuccess);
+    CHECK(result.second == 0);
+    CHECK(elapsed < 1000ms);
+    // Auto-reset was consumed.
+    CHECK(rex::thread::WaitAny(handles, alertable, 0ms).first == WaitResult::kTimeout);
+  }
+}
+
+TEST_CASE("WaitAll needs every handle and consumes them atomically", "[threading][wait]") {
+  auto a = Event::CreateAutoResetEvent(false);
+  auto b = Event::CreateAutoResetEvent(false);
+  std::vector<WaitHandle*> handles{a.get(), b.get()};
+  a->Set();
+  // Only one of two is set: the wait times out and must NOT consume the set one.
+  CHECK(rex::thread::WaitAll(handles, false, kShort) == WaitResult::kTimeout);
+  CHECK(Wait(a.get(), false, 0ms) == WaitResult::kSuccess);
+  a->Set();
+
+  std::thread signaler([&] {
+    std::this_thread::sleep_for(30ms);
+    b->Set();
+  });
+  CHECK(rex::thread::WaitAll(handles, false, 2000ms) == WaitResult::kSuccess);
+  signaler.join();
+  // Both auto-reset events were consumed together.
+  CHECK(Wait(a.get(), false, 0ms) == WaitResult::kTimeout);
+  CHECK(Wait(b.get(), false, 0ms) == WaitResult::kTimeout);
+}
+
+TEST_CASE("semaphore releases wake exactly that many WaitAny waiters", "[threading][wait]") {
+  auto sem = Semaphore::Create(0, 100);
+  auto never = Event::CreateManualResetEvent(false);
+  std::atomic<int> woke{0};
+  std::vector<std::thread> waiters;
+  for (int i = 0; i < 4; ++i) {
+    waiters.emplace_back([&] {
+      std::vector<WaitHandle*> handles{never.get(), sem.get()};
+      if (rex::thread::WaitAny(handles, false, 400ms).first == WaitResult::kSuccess) {
+        woke.fetch_add(1);
+      }
+    });
+  }
+  std::this_thread::sleep_for(50ms);
+  REQUIRE(sem->Release(2, nullptr));
+  for (auto& t : waiters) t.join();
+  CHECK(woke.load() == 2);
+}
+
+TEST_CASE("many WaitAny and WaitAll waiters all wake", "[threading][wait]") {
+  constexpr int kWaiters = 24;
+  auto gate = Event::CreateManualResetEvent(false);
+  auto other = Event::CreateManualResetEvent(false);
+  auto sem = Semaphore::Create(0, kWaiters);
+  std::atomic<int> any_ok{0}, all_ok{0};
+  std::vector<std::thread> waiters;
+  for (int i = 0; i < kWaiters; ++i) {
+    waiters.emplace_back([&, i] {
+      if (i % 2 == 0) {
+        std::vector<WaitHandle*> handles{sem.get(), gate.get()};
+        if (rex::thread::WaitAny(handles, false, 3000ms).first == WaitResult::kSuccess) {
+          any_ok.fetch_add(1);
+        }
+      } else {
+        std::vector<WaitHandle*> handles{other.get(), gate.get()};
+        if (rex::thread::WaitAll(handles, false, 3000ms) == WaitResult::kSuccess) {
+          all_ok.fetch_add(1);
+        }
+      }
+    });
+  }
+  std::this_thread::sleep_for(50ms);
+  gate->Set();
+  std::this_thread::sleep_for(20ms);
+  other->Set();
+  for (auto& t : waiters) t.join();
+  CHECK(any_ok.load() == kWaiters / 2);
+  CHECK(all_ok.load() == kWaiters / 2);
+}
