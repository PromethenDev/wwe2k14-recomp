+TEST_CASE("WaitAny returns the signaled index, immediately when already set", "[threading][wait]") {
+  auto a = Event::CreateManualResetEvent(false);
+  auto b = Event::CreateManualResetEvent(false);
+  std::vector<WaitHandle*> handles{a.get(), b.get()};
+  CHECK(rex::thread::WaitAny(handles, false, 0ms).first == WaitResult::kTimeout);
+  b->Set();
+  auto result = rex::thread::WaitAny(handles, false, 0ms);
+  CHECK(result.first == WaitResult::kSuccess);
+  CHECK(result.second == 1);
+  // Manual-reset stays signaled.
+  CHECK(rex::thread::WaitAny(handles, false, 0ms).second == 1);
+}
