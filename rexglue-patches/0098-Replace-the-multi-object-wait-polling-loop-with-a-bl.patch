+#if REX_PLATFORM_LINUX
+TEST_CASE("blocked multi-object waits do not burn CPU", "[threading][wait][cpu]") {
+  auto a = Event::CreateManualResetEvent(false);
+  auto b = Event::CreateAutoResetEvent(false);
+  std::vector<WaitHandle*> handles{a.get(), b.get()};
+  for (bool alertable : {false, true}) {
+    for (bool wait_all : {false, true}) {
+      double cpu_ms = -1;
+      std::thread waiter([&] {
+        const double before = ThreadCpuMs();
+        rex::thread::WaitMultiple(handles.data(), handles.size(), wait_all, alertable, 300ms);
+        cpu_ms = ThreadCpuMs() - before;
+      });
+      waiter.join();
+      // 300 ms blocked: a polling/spinning implementation uses ~300 ms of CPU.
+      CHECK(cpu_ms < 30.0);
+    }
+  }
+  // Single-object alertable wait too.
+  double cpu_ms = -1;
+  std::thread waiter([&] {
+    const double before = ThreadCpuMs();
+    Wait(a.get(), true, 300ms);
+    cpu_ms = ThreadCpuMs() - before;
+  });
+  waiter.join();
+  CHECK(cpu_ms < 30.0);
+}
+#endif
