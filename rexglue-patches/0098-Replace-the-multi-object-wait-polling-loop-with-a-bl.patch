+// Blocks until the wait is satisfied, the timeout elapses or (alertable) a user callback was
+// dispatched. The thread sleeps on its own WaitBlock; every handle's Signal-like operation (and
+// QueueUserCallback for alertable waits) wakes it, so there is no polling.
+//
+// Correctness of the wakeup protocol: `notified` is cleared BEFORE the callback / handle checks. A
+// state change that the checks miss happens after the clear and therefore sets `notified` after it,
+// so the final cv wait returns immediately. Wait-all atomicity: all distinct handles are locked in
+// address order (a global order, so concurrent multi-waits cannot deadlock; single-object operations
+// lock one mutex at a time), checked, and consumed under those locks.
+std::pair<WaitResult, size_t> WaitMultipleCore(std::vector<PosixConditionBase*> handles,
+                                               bool wait_all, std::chrono::milliseconds timeout,
+                                               bool alertable) {
+  using Clock = std::chrono::steady_clock;
+  assert_true(!handles.empty());
+  constexpr size_t kNone = std::numeric_limits<size_t>::max();
+
+  // Ten years: treat anything longer as infinite (also avoids time_point overflow).
+  const bool infinite = timeout >= std::chrono::hours(24 * 365 * 10);
+  const auto deadline = infinite ? Clock::time_point::max() : Clock::now() + timeout;
+
+  std::vector<PosixConditionBase*> lock_order = handles;
+  std::sort(lock_order.begin(), lock_order.end());
+  lock_order.erase(std::unique(lock_order.begin(), lock_order.end()), lock_order.end());
+
+  // Locks every handle, tests the wait condition, consumes on success.
+  auto try_complete = [&](size_t& index_out) -> bool {
+    for (auto* handle : lock_order) {
+      handle->LockForMultiWait();
+    }
+    bool met = false;
+    size_t first = kNone;
+    if (wait_all) {
+      met = true;
+      for (auto* handle : handles) {
+        if (!handle->signaled()) {
+          met = false;
+          break;
+        }
+      }
+      if (met) {
+        first = 0;
+        for (auto* handle : lock_order) {
+          handle->post_execution();
+        }
+      }
+    } else {
+      for (size_t i = 0; i < handles.size(); ++i) {
+        if (handles[i]->signaled()) {
+          first = i;
+          met = true;
+          handles[i]->post_execution();
+          break;
+        }
+      }
+    }
+    for (auto it = lock_order.rbegin(); it != lock_order.rend(); ++it) {
+      (*it)->UnlockForMultiWait();
+    }
+    index_out = first;
+    return met;
+  };
 
