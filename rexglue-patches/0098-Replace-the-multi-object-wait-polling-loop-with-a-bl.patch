+TEST_CASE("mutant ownership transfers through a multi-object wait", "[threading][wait]") {
+  auto mutant = Mutant::Create(true);  // owned by this thread
+  auto never = Event::CreateManualResetEvent(false);
+  std::atomic<bool> acquired{false};
+  std::thread other([&] {
+    std::vector<WaitHandle*> handles{never.get(), mutant.get()};
+    auto result = rex::thread::WaitAny(handles, false, 2000ms);
+    acquired.store(result.first == WaitResult::kSuccess && result.second == 1);
+  });
+  std::this_thread::sleep_for(40ms);
+  CHECK_FALSE(acquired.load());
+  REQUIRE(mutant->Release());
+  other.join();
+  CHECK(acquired.load());
+}
+
+TEST_CASE("a queued user callback wakes an alertable multi-object wait", "[threading][wait]") {
+  auto a = Event::CreateManualResetEvent(false);
+  auto b = Event::CreateManualResetEvent(false);
+  std::atomic<bool> callback_ran{false};
+  std::atomic<int> wait_result{-1};
+  std::atomic<bool> entered{false};
+  auto thread = Thread::Create(Thread::CreationParameters{}, [&] {
+    std::vector<WaitHandle*> handles{a.get(), b.get()};
+    entered.store(true);
+    wait_result.store(int(rex::thread::WaitAny(handles, true, 5000ms).first));
+  });
+  REQUIRE(thread != nullptr);
+  REQUIRE(WaitFor([&] { return entered.load(); }));
+  std::this_thread::sleep_for(40ms);
+  const auto start = std::chrono::steady_clock::now();
+  thread->QueueUserCallback([&] { callback_ran.store(true); });
+  REQUIRE(Wait(thread.get(), false, 2000ms) == WaitResult::kSuccess);
+  CHECK(std::chrono::steady_clock::now() - start < 1000ms);
+  CHECK(callback_ran.load());
+  CHECK(wait_result.load() == int(WaitResult::kUserCallback));
+}
+
+TEST_CASE("a non-alertable wait is not woken by a user callback", "[threading][wait]") {
+  auto a = Event::CreateManualResetEvent(false);
+  auto b = Event::CreateManualResetEvent(false);
+  std::atomic<int> wait_result{-1};
+  std::atomic<bool> entered{false};
+  auto thread = Thread::Create(Thread::CreationParameters{}, [&] {
+    std::vector<WaitHandle*> handles{a.get(), b.get()};
+    entered.store(true);
+    wait_result.store(int(rex::thread::WaitAny(handles, false, 150ms).first));
+  });
+  REQUIRE(thread != nullptr);
+  REQUIRE(WaitFor([&] { return entered.load(); }));
+  thread->QueueUserCallback([] {});
+  REQUIRE(Wait(thread.get(), false, 2000ms) == WaitResult::kSuccess);
+  CHECK(wait_result.load() == int(WaitResult::kTimeout));
+}
