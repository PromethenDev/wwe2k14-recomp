       return X_STATUS_SUCCESS;
     }
-    scan_count++;
-    slot = (slot + 1) % table_capacity_;
-    if (slot == 0) {
-      // Never allow 0 handles.
+  } else {
+    // Find a free slot.
+    uint32_t slot = last_free_entry_;
+    uint32_t scan_count = 0;
+    while (scan_count < table_capacity_) {
