 namespace rex::system {
 
+namespace {
+bool ObjFixEnabled() {
+  static const bool enabled = [] {
+    const char* v = std::getenv("WWE2K14_OBJ_FIX");
+    return v == nullptr || std::strcmp(v, "0") != 0;
+  }();
+  return enabled;
+}
+
+// Expected XObject::Type for a dispatch header type; false when there is no expectation.
+bool ExpectedTypeForHeader(int32_t t, XObject::Type* out) {
+  switch (t) {
+    case 0:
+    case 1:
+      *out = XObject::Type::Event;
+      return true;
+    case 2:
+      *out = XObject::Type::Mutant;
+      return true;
+    case 5:
+      *out = XObject::Type::Semaphore;
+      return true;
+    case 6:
+      *out = XObject::Type::Thread;
+      return true;
+    case 8:
+    case 9:
+      *out = XObject::Type::Timer;
+      return true;
+    default:
+      return false;
+  }
+}
+
+void LogStale(void* native_ptr, uint32_t handle, int32_t as_type, bool exists, uint32_t actual_type,
+                uintptr_t bound) {
+  static std::mutex mutex;
+  static std::set<std::pair<uintptr_t, uint32_t>> reported;
+  static uint64_t count = 0;
+  std::lock_guard<std::mutex> lock(mutex);
+  ++count;
+  if (!reported.emplace(reinterpret_cast<uintptr_t>(native_ptr), handle).second) {
+    return;
+  }
+  REXLOG_WARN("[obj-fix] stale native object host_ptr={:#x} handle={:#x} header_type={} object={} "
+              "actual_type={} bound_host={:#x} -> re-initialising (total_stale={})",
+              reinterpret_cast<uintptr_t>(native_ptr), handle, as_type, exists ? "other" : "gone",
+              actual_type, bound, count);
+}
+}  // namespace
+
 XObject::XObject(Type type) : kernel_state_(nullptr), pointer_ref_count_(1), type_(type) {
   handles_.reserve(10);
 }
@@ -398,13 +457,37 @@ object_ref<XObject> XObject::GetNativeObject(KernelState* kernel_state, void* na
 
   if (header->wait_list_flink == kXObjSignature) {
     // Already initialized.
-    // TODO: assert if the type of the object != as_type
     uint32_t handle = header->wait_list_blink;
     auto object = kernel_state->object_table()->LookupObject<XObject>(handle);
-
-    // TODO(benvanik): assert nothing has been changed in the struct.
-    return object;
-  } else {
+    if (!ObjFixEnabled()) {
+      return object;
+    }
+    XObject::Type expected_type = XObject::Type::Undefined;
+    bool has_expectation = ExpectedTypeForHeader(as_type, &expected_type);
+    bool type_ok = !has_expectation || (object && object->type() == expected_type);
+    // Identity: the object must be bound to THIS guest struct. Objects created through
+    // CreateNative/SetNativePointer carry guest_object(); lazily bound ones carry
+    // bound_native_host_. Unknown (0) is accepted (e.g. restored from a save).
+    uintptr_t expected_host = 0;
+    if (object) {
+      if (object->guest_object()) {
+        expected_host = reinterpret_cast<uintptr_t>(
+            kernel_state->memory()->TranslateVirtual(object->guest_object()));
+      } else {
+        expected_host = object->bound_native_host();
+      }
+    }
+    if (rex::system::util::objfix::NativeObjectIdentityOk(
+            object != nullptr, type_ok, expected_host, reinterpret_cast<uintptr_t>(native_ptr))) {
+      // TODO(benvanik): assert nothing has been changed in the struct.
+      return object;
+    }
+    LogStale(native_ptr, handle, as_type, object != nullptr,
+             object ? static_cast<uint32_t>(object->type()) : 0, expected_host);
+    // Stale header: fall through and treat it as first use (fresh native object built from the
+    // header's current state) so the guest's signal is not lost.
+  }
+  {
     // First use, create new.
     // https://www.nirsoft.net/kernel_struct/vista/KOBJECTS.html
     XObject* object = nullptr;
@@ -451,6 +534,7 @@ object_ref<XObject> XObject::GetNativeObject(KernelState* kernel_state, void* na
     // Stash pointer in struct.
     // FIXME: This assumes the object contains a dispatch header (some don't!)
     StashHandle(header, object->handle());
+    object->bound_native_host_ = reinterpret_cast<uintptr_t>(native_ptr);
 
     return object_ref<XObject>(object);
   }
diff --git a/tests/obj-fix-test.cpp b/tests/obj-fix-test.cpp
new file mode 100644
index 00000000..c2c7fe13
--- /dev/null
+++ b/tests/obj-fix-test.cpp
@@ -0,0 +1,50 @@
+#include <cstdio>
+#include <vector>
+#include "rex/system/util/obj_fix.h"
+using namespace rex::system::util::objfix;
+static int fails = 0;
+#define CHECK(c) do { if (!(c)) { std::printf("FAIL line %d: %s\n", __LINE__, #c); ++fails; } } while (0)
+
+int main() {
+  const uint32_t cap = 16;
+  std::vector<bool> used(cap, false);
+  auto is_free = [&](uint32_t s) { return !used[s]; };
+  uint32_t last = 0, slot = 0;
+
+  // first alloc is never 0
+  CHECK(FindFreeSlotRoundRobin(is_free, cap, &last, &slot)); CHECK(slot == 1); used[slot] = true;
+  // free + alloc does not give the same number back
+  used[1] = false;
+  CHECK(FindFreeSlotRoundRobin(is_free, cap, &last, &slot)); CHECK(slot == 2); used[2] = true;
+  // fill the table; slot 0 stays untouched
+  uint32_t n = 0;
+  while (FindFreeSlotRoundRobin(is_free, cap, &last, &slot)) { CHECK(slot != 0 && slot < cap); used[slot] = true; ++n; }
+  CHECK(n == 14);  // slots 3..15 then wrapped to freed 1
+  CHECK(used[1] && !used[0]);
+  // wrap: free slot 5, last is after 15 -> wraps to 1.. and finds 5
+  used[5] = false; used[9] = false;
+  CHECK(FindFreeSlotRoundRobin(is_free, cap, &last, &slot)); CHECK(slot == 5); used[5] = true;
+  // freed 5 again: next alloc must prefer 9 (rotation), not 5
+  used[5] = false;
+  CHECK(FindFreeSlotRoundRobin(is_free, cap, &last, &slot)); CHECK(slot == 9); used[9] = true;
+  CHECK(FindFreeSlotRoundRobin(is_free, cap, &last, &slot)); CHECK(slot == 5); used[5] = true;
+  // full -> false
+  CHECK(!FindFreeSlotRoundRobin(is_free, cap, &last, &slot));
+  // a handle freed is not reused for a whole cycle
+  std::vector<bool> u2(cap, false); last = 0;
+  auto f2 = [&](uint32_t s) { return !u2[s]; };
+  FindFreeSlotRoundRobin(f2, cap, &last, &slot); u2[slot] = true; uint32_t first = slot; u2[slot] = false;
+  for (uint32_t i = 0; i < cap - 2; ++i) { FindFreeSlotRoundRobin(f2, cap, &last, &slot); CHECK(slot != first); u2[slot] = false; }
+  // degenerate
+  CHECK(!FindFreeSlotRoundRobin(is_free, 1, &last, &slot));
+  CHECK(!FindFreeSlotRoundRobin(is_free, 0, &last, &slot));
+
+  // identity
+  CHECK(NativeObjectIdentityOk(true, true, 0x1000, 0x1000));
+  CHECK(NativeObjectIdentityOk(true, true, 0, 0x1000));       // unknown binding accepted
+  CHECK(!NativeObjectIdentityOk(false, true, 0x1000, 0x1000));  // handle gone
+  CHECK(!NativeObjectIdentityOk(true, false, 0x1000, 0x1000));  // wrong type (XFile)
+  CHECK(!NativeObjectIdentityOk(true, true, 0x2000, 0x1000));   // bound to another struct
+  std::printf(fails ? "FAILED %d\n" : "obj-fix-test OK\n", fails);
+  return fails != 0;
+}
