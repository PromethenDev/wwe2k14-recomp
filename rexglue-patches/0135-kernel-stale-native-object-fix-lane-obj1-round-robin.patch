+// WWE2K14 obj-fix: pure helpers (no SDK dependencies) so they can be host-tested.
+#pragma once
+#include <cstdint>
+
+namespace rex::system::util::objfix {
+
+// Round-robin slot search. `is_free(slot)` reports whether a slot is unused.
+// Scans from *last_free (never slot 0), wraps, and on success advances *last_free
+// to the slot AFTER the one handed out, so a just-freed number is not reused
+// until the table has cycled. Returns false when the table is full.
+template <typename IsFree>
+bool FindFreeSlotRoundRobin(IsFree&& is_free, uint32_t capacity, uint32_t* last_free,
+                            uint32_t* out_slot) {
+  if (capacity < 2) {
+    return false;
+  }
+  uint32_t slot = *last_free;
+  if (slot == 0 || slot >= capacity) {
+    slot = 1;
+  }
+  for (uint32_t scanned = 1; scanned < capacity; ++scanned) {  // slots 1..capacity-1
+    if (is_free(slot)) {
+      *out_slot = slot;
+      uint32_t next = slot + 1;
+      *last_free = (next >= capacity) ? 1 : next;
+      return true;
+    }
+    slot = slot + 1;
+    if (slot >= capacity) {
+      slot = 1;
+    }
+  }
+  return false;
+}
+
+// Decision for an "already initialised" guest dispatch header.
+//   object_exists   : handle resolved to an object
+//   type_ok         : object type equals the type expected for the header (or no expectation)
+//   expected_host   : host address of the guest struct the object was bound to (0 = unknown)
+//   native_host     : host address of the guest struct being looked up
+// Returns true when the object may be used, false when the header is stale.
+inline bool NativeObjectIdentityOk(bool object_exists, bool type_ok, uintptr_t expected_host,
+                                   uintptr_t native_host) {
+  if (!object_exists || !type_ok) {
+    return false;
+  }
+  if (expected_host != 0 && expected_host != native_host) {
+    return false;
+  }
+  return true;
+}
+
+}  // namespace rex::system::util::objfix
