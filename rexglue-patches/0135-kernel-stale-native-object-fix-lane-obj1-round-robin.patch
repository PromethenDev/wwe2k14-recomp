@@ -81,8 +96,11 @@ X_STATUS ObjectTable::FindFreeSlot(uint32_t* out_slot) {
   }
 
   // Never allow 0 handles.
-  slot = ++last_free_entry_;
+  uint32_t slot = ++last_free_entry_;
   *out_slot = slot;
+  if (obj_fix) {
+    last_free_entry_ = (slot + 1 >= table_capacity_) ? 1 : slot + 1;
+  }
 
   return X_STATUS_SUCCESS;
 }
