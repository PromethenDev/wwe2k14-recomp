+bool VulkanCommandProcessor::CaptureLastRenderTarget(ui::RawImage& image_out) {
+  VkImage image = VK_NULL_HANDLE;
+  VkFormat format = VK_FORMAT_UNDEFINED;
+  VkExtent2D image_extent{};
+  VkSampleCountFlagBits samples = VK_SAMPLE_COUNT_1_BIT;
+  VkPipelineStageFlags source_stage = 0;
+  VkAccessFlags source_access = 0;
+  VkImageLayout source_layout = VK_IMAGE_LAYOUT_UNDEFINED;
+  if (!render_target_cache_ ||
+      !render_target_cache_->GetLastUpdateColorTargetInfo(
+          0, image, format, image_extent, samples, source_stage, source_access, source_layout)) {
+    REXGPU_WARN("Trace RT capture: no host color target 0 is available");
+    return false;
+  }
+  if (format != VK_FORMAT_R8G8B8A8_UNORM || samples != VK_SAMPLE_COUNT_1_BIT) {
+    REXGPU_WARN("Trace RT capture: unsupported target format {} or sample count {}",
+                uint32_t(format), uint32_t(samples));
+    return false;
+  }
+
+  draw_util::Scissor scissor{};
+  draw_util::GetScissor(*register_file_, scissor);
+  const uint64_t right = uint64_t(scissor.offset[0]) + scissor.extent[0];
+  const uint64_t bottom = uint64_t(scissor.offset[1]) + scissor.extent[1];
+  if (!scissor.extent[0] || !scissor.extent[1] || right > image_extent.width ||
+      bottom > image_extent.height) {
+    REXGPU_WARN("Trace RT capture: scissor {}x{}+{},{} is outside the {}x{} target",
+                scissor.extent[0], scissor.extent[1], scissor.offset[0], scissor.offset[1],
+                image_extent.width, image_extent.height);
+    return false;
+  }
+
+  const VkDeviceSize readback_size =
+      VkDeviceSize(scissor.extent[0]) * scissor.extent[1] * sizeof(uint32_t);
+  const ui::vulkan::VulkanDevice* const vulkan_device = GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  const VkDevice device = vulkan_device->device();
+  VkBuffer readback_buffer = VK_NULL_HANDLE;
+  VkDeviceMemory readback_memory = VK_NULL_HANDLE;
+  uint32_t readback_memory_type = UINT32_MAX;
+  VkDeviceSize readback_memory_size = 0;
+  if (!ui::vulkan::util::CreateDedicatedAllocationBuffer(
+          vulkan_device, readback_size, VK_BUFFER_USAGE_TRANSFER_DST_BIT,
+          ui::vulkan::util::MemoryPurpose::kReadback, readback_buffer, readback_memory,
+          &readback_memory_type, &readback_memory_size)) {
+    REXGPU_ERROR("Trace RT capture: failed to create a {} byte readback buffer", readback_size);
+    return false;
+  }
+  auto destroy_readback = [&] {
+    ui::vulkan::util::DestroyAndNullHandle(dfn.vkDestroyBuffer, device, readback_buffer);
+    ui::vulkan::util::DestroyAndNullHandle(dfn.vkFreeMemory, device, readback_memory);
+  };
+
+  if (!BeginSubmission(false)) {
+    destroy_readback();
+    return false;
+  }
+  VkImageSubresourceRange image_range{};
+  image_range.aspectMask = VK_IMAGE_ASPECT_COLOR_BIT;
+  image_range.levelCount = 1;
+  image_range.layerCount = 1;
+  PushImageMemoryBarrier(image, image_range, source_stage, VK_PIPELINE_STAGE_TRANSFER_BIT,
+                         source_access, VK_ACCESS_TRANSFER_READ_BIT, source_layout,
+                         VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL);
+  SubmitBarriers(true);
+
+  VkBufferImageCopy copy_region{};
+  copy_region.imageSubresource.aspectMask = VK_IMAGE_ASPECT_COLOR_BIT;
+  copy_region.imageSubresource.layerCount = 1;
+  copy_region.imageOffset = {int32_t(scissor.offset[0]), int32_t(scissor.offset[1]), 0};
+  copy_region.imageExtent = {scissor.extent[0], scissor.extent[1], 1};
+  deferred_command_buffer_.CmdVkCopyImageToBuffer(image, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL,
+                                                   readback_buffer, 1, &copy_region);
+  PushImageMemoryBarrier(image, image_range, VK_PIPELINE_STAGE_TRANSFER_BIT, source_stage,
+                         VK_ACCESS_TRANSFER_READ_BIT, source_access,
+                         VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, source_layout,
+                         VK_QUEUE_FAMILY_IGNORED, VK_QUEUE_FAMILY_IGNORED, false);
+  PushBufferMemoryBarrier(readback_buffer, 0, readback_size, VK_PIPELINE_STAGE_TRANSFER_BIT,
+                          VK_PIPELINE_STAGE_HOST_BIT, VK_ACCESS_TRANSFER_WRITE_BIT,
+                          VK_ACCESS_HOST_READ_BIT);
+
+  const uint64_t submission_to_wait = GetCurrentSubmission();
+  if (!EndSubmission(false)) {
+    destroy_readback();
+    return false;
+  }
+  CheckSubmissionFenceAndDeviceLoss(submission_to_wait);
+  if (device_lost_) {
+    destroy_readback();
+    return false;
+  }
+
+  void* mapping = nullptr;
+  if (dfn.vkMapMemory(device, readback_memory, 0, readback_memory_size, 0, &mapping) != VK_SUCCESS) {
+    REXGPU_ERROR("Trace RT capture: failed to map the readback buffer");
+    destroy_readback();
+    return false;
+  }
+  if (!(vulkan_device->memory_types().host_coherent & (uint32_t(1) << readback_memory_type))) {
+    VkMappedMemoryRange invalidate_range{};
+    invalidate_range.sType = VK_STRUCTURE_TYPE_MAPPED_MEMORY_RANGE;
+    invalidate_range.memory = readback_memory;
+    invalidate_range.size = std::min(
+        rex::round_up(readback_size, vulkan_device->properties().nonCoherentAtomSize),
+        readback_memory_size);
+    if (dfn.vkInvalidateMappedMemoryRanges(device, 1, &invalidate_range) != VK_SUCCESS) {
+      dfn.vkUnmapMemory(device, readback_memory);
+      REXGPU_ERROR("Trace RT capture: failed to invalidate the readback buffer");
+      destroy_readback();
+      return false;
+    }
+  }
+  image_out.width = scissor.extent[0];
+  image_out.height = scissor.extent[1];
+  image_out.stride = size_t(image_out.width) * sizeof(uint32_t);
+  image_out.data.resize(size_t(readback_size));
+  std::memcpy(image_out.data.data(), mapping, image_out.data.size());
+  dfn.vkUnmapMemory(device, readback_memory);
+  destroy_readback();
+  REXGPU_INFO("Trace RT capture: {}x{} format={} msaa=1", image_out.width, image_out.height,
+              uint32_t(format));
+  return true;
+}
