+bool VulkanRenderTargetCache::GetLastUpdateColorTargetInfo(
+    uint32_t color_rt_index, VkImage& image_out, VkFormat& format_out,
+    VkExtent2D& extent_out, VkSampleCountFlagBits& samples_out,
+    VkPipelineStageFlags& stage_mask_out, VkAccessFlags& access_mask_out,
+    VkImageLayout& layout_out) const {
+  if (color_rt_index >= xenos::kMaxColorRenderTargets ||
+      GetPath() != Path::kHostRenderTargets ||
+      !(GetLastUpdateBoundRenderTargets() & (uint32_t(1) << (1 + color_rt_index)))) {
+    return false;
+  }
+  RenderTarget* target_base = last_update_accumulated_render_targets()[1 + color_rt_index];
+  if (!target_base) {
+    return false;
+  }
+  auto* target = static_cast<VulkanRenderTarget*>(target_base);
+  if (target->key().is_depth) {
+    return false;
+  }
+  image_out = target->image();
+  format_out = GetColorVulkanFormat(target->key().GetColorFormat());
+  extent_out.width = target->key().GetWidth() * draw_resolution_scale_x();
+  extent_out.height = GetRenderTargetHeight(target->key().pitch_tiles_at_32bpp,
+                                             target->key().msaa_samples) *
+                      draw_resolution_scale_y();
+  samples_out = target->key().msaa_samples == xenos::MsaaSamples::k2X &&
+                        !msaa_2x_attachments_supported_
+                    ? VK_SAMPLE_COUNT_4_BIT
+                    : VkSampleCountFlagBits(uint32_t(1) << uint32_t(target->key().msaa_samples));
+  stage_mask_out = target->current_stage_mask();
+  access_mask_out = target->current_access_mask();
+  layout_out = target->current_layout();
+  return image_out != VK_NULL_HANDLE && format_out != VK_FORMAT_UNDEFINED && extent_out.width &&
+         extent_out.height;
+}
