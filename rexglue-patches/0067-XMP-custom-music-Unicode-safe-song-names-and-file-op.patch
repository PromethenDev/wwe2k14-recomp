       }
-      const uint32_t format = LowerAscii(candidate.path.extension().string()) == ".mp3" ? 1 : 0;
-      custom_music_songs_.push_back(
-          {static_cast<uint32_t>(custom_music_songs_.size() + 1), candidate.path,
-           std::move(name), format});
-    }
 
