   if (with_presentation) {
     provider->ui_samplers_ = UISamplers::Create(provider->vulkan_device_.get());
diff --git a/src/ui/windowed_app_main_win.cpp b/src/ui/windowed_app_main_win.cpp
index 3f223c4..1005821 100644
--- a/src/ui/windowed_app_main_win.cpp
+++ b/src/ui/windowed_app_main_win.cpp
@@ -114,8 +114,12 @@ int WINAPI wWinMain(HINSTANCE hinstance, HINSTANCE hinstance_prev, LPWSTR comman
     app->InvokeOnDestroy();
   }
 
