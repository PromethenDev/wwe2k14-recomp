From 8a370e6b410c38fe79930ca67642f3238a58e7bd Mon Sep 17 00:00:00 2001
From: PromethenDev <PromethenDev@users.noreply.github.com>
Date: Sat, 3 Oct 2026 00:53:46 -0700
Subject: [PATCH 88/97] wwe2k14: XMPGetPlaybackController reports idle (0,0)
 for title 545408B2 until the title's first explicit setter (2K14 mutes its
 music otherwise); WWE 13 path unchanged

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 include/rex/kernel/xam/apps/xmp_app.h |  1 +
 src/kernel/xam/apps/xmp_app.cpp       | 48 +++++++++++++++++++--------
 2 files changed, 35 insertions(+), 14 deletions(-)

diff --git a/include/rex/kernel/xam/apps/xmp_app.h b/include/rex/kernel/xam/apps/xmp_app.h
index 921ae8d..f9577d4 100644
--- a/include/rex/kernel/xam/apps/xmp_app.h
+++ b/include/rex/kernel/xam/apps/xmp_app.h
@@ -127,6 +127,7 @@ class XmpApp : public system::xam::App {
 
   State state_;
   PlaybackClient playback_client_;
+  std::atomic<bool> playback_controller_set_{false};
   PlaybackMode playback_mode_;
   RepeatMode repeat_mode_;
   uint32_t unknown_flags_;
diff --git a/src/kernel/xam/apps/xmp_app.cpp b/src/kernel/xam/apps/xmp_app.cpp
index a276d42..3f08142 100644
--- a/src/kernel/xam/apps/xmp_app.cpp
+++ b/src/kernel/xam/apps/xmp_app.cpp
@@ -42,6 +42,8 @@ using namespace rex::system;
 
 namespace {
 
+constexpr uint32_t kWwe2k14TitleId = 0x545408B2;
+
 std::string LowerAscii(std::string value) {
   std::transform(value.begin(), value.end(), value.begin(), [](unsigned char character) {
     return static_cast<char>(std::tolower(character));
@@ -61,6 +63,14 @@ bool XmpStateProbeEnabled() {
   return enabled;
 }
 
+bool XmpReportIdlePlaybackController() {
+  static const bool report_idle = [] {
+    const char* value = std::getenv("REX_XMP_REPORT_IDLE");
+    return value && std::strcmp(value, "1") == 0;
+  }();
+  return report_idle;
+}
+
 // Notification traces fire on every XMP state/behaviour/controller change; keep them bounded even
 // with the probe on (first 64 lines, then 1 in 100).
 bool XmpStateProbeNotifyLog() {
@@ -652,11 +662,14 @@ X_HRESULT XmpApp::DispatchMessageSync(uint32_t message, uint32_t buffer_ptr,
                     uint32_t(args->playback_client));
 
       playback_client_ = PlaybackClient(uint32_t(args->playback_client));
+      playback_controller_set_.store(true, std::memory_order_release);
+      if (XmpStateProbeEnabled()) {
+        REXKRNL_INFO("[xmp-state-probe] XMPSetPlaybackController controller={} client={}",
+                     uint32_t(args->controller), uint32_t(args->playback_client));
+      }
       if (XmpStateProbeNotifyLog()) {
-        REXKRNL_INFO(
-            "[xmp-state-probe] XMPSetPlaybackController controller={} client={} -> notify 0x0a000003 param={}",
-            uint32_t(args->controller), uint32_t(args->playback_client),
-            static_cast<uint32_t>(!args->playback_client));
+        REXKRNL_INFO("[xmp-state-probe] notify 0x0a000003 param={}",
+                     static_cast<uint32_t>(!args->playback_client));
       }
       kernel_state_->BroadcastNotification(kMsgPlaybackControllerChanged, !args->playback_client);
       return X_E_SUCCESS;
@@ -674,22 +687,29 @@ X_HRESULT XmpApp::DispatchMessageSync(uint32_t message, uint32_t buffer_ptr,
       assert_true(args->xmp_client == 0x00000002);
       REXKRNL_DEBUG("XMPGetPlaybackController({:08X}, {:08X}, {:08X})", uint32_t(args->xmp_client),
                     uint32_t(args->controller_ptr), uint32_t(args->locked_ptr));
-      // Report the playback state stored by XMPSetPlaybackController instead of a
-      // hardcoded idle (0, 0): the guest poll chain (sub_829BCF48) treats the pair
-      // as the live controller state and only sees "not active" while both words
+      // Report the playback state stored by XMPSetPlaybackController instead of
+      // a hardcoded idle (0, 0): the Wwise poll wrappers (WWE '13 sub_82CBBD20 /
+      // 2K14 sub_82E1E2A0) treat title playback as active only while both words
       // are zero. The controller word is not tracked by this app and the title's
-      // own setter calls always pass controller == 0, so it stays 0.
+      // own setter calls always pass controller == 0, so it stays 0. WWE 2K14
+      // starts with the stock idle answer until its title explicitly sets a
+      // playback client; REX_XMP_REPORT_IDLE remains available for an opt-in
+      // forced-idle A/B for any title.
+      const bool title_default_idle =
+          !playback_controller_set_.load(std::memory_order_acquire) &&
+          kernel_state_->title_id() == kWwe2k14TitleId;
+      const bool report_idle = XmpReportIdlePlaybackController() || title_default_idle;
+      const uint32_t client = static_cast<uint32_t>(playback_client_);
+      const uint32_t locked = report_idle ? 0 : client;
       memory::store_and_swap<uint32_t>(memory_->TranslateVirtual(args->controller_ptr), 0);
       memory::store_and_swap<uint32_t>(memory_->TranslateVirtual(args->locked_ptr),
-                                       static_cast<uint32_t>(playback_client_));
+                                       locked);
       if (XmpStateProbeEnabled()) {
         const uint64_t count =
             get_playback_controller_log_count_.load(std::memory_order_relaxed);
-        if (count <= 3 || count % 1000 == 0) {
-          REXKRNL_INFO(
-              "[xmp-state-probe] XMPGetPlaybackController controller={} locked={} client={}", 0,
-              static_cast<uint32_t>(playback_client_), static_cast<uint32_t>(playback_client_));
-        }
+        REXKRNL_INFO(
+            "[xmp-state-probe] XMPGetPlaybackController count={} controller={} locked={} client={} report_idle={}",
+            count, 0, locked, client, report_idle);
       }
 
       if (!XThread::GetCurrentThread()->main_thread()) {
-- 
