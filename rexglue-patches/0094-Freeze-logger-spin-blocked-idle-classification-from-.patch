+// R9: for each candidate spinning slot, collect kMaxSpinSamples leaf host PCs
+// over ~1 s (all candidates in parallel). A spinning thread takes the capture
+// signal promptly; a blocked one is skipped by the caller.
+void SampleSpinPcs(const int* indices, int count) {
+  if (count <= 0) return;
+  for (int n = 0; n < count; ++n) {
+    ThreadSlot& slot = g_slots[indices[n]];
+    slot.spin_count.store(0, std::memory_order_release);
+    for (uint32_t i = 0; i < kMaxSpinSamples; ++i) {
+      slot.spin_pc[i].store(0, std::memory_order_relaxed);
+    }
+  }
+  g_spin_sampling.store(true, std::memory_order_release);
+  for (int round = 0; round < kMaxSpinSamples; ++round) {
+    for (int n = 0; n < count; ++n) {
+      RequestCapture(&g_slots[indices[n]]);
+    }
+    std::this_thread::sleep_for(std::chrono::milliseconds(kSpinSampleIntervalMs));
+  }
+  g_spin_sampling.store(false, std::memory_order_release);
+}
