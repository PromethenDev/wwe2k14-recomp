diff --git a/include/rex/graphics/draw_observer.h b/include/rex/graphics/draw_observer.h
index 1d1a5dee..8c152460 100644
--- a/include/rex/graphics/draw_observer.h
+++ b/include/rex/graphics/draw_observer.h
@@ -41,8 +41,17 @@ class DrawObserver {
   // A trace replay restored the EDRAM from a snapshot (raw 2048 tiles x 5120 bytes, the guest
   // layout), before the frame's first draw.
   virtual void OnEdramSnapshot(const void* data, size_t size) { (void)data; (void)size; }
+  // Compare window (--nr_compare_dump_dir, off by default): begin = true at the frame boundary
+  // that starts a requested compare frame (followed by OnEdramSnapshot with the SDK's EDRAM in a
+  // live run), begin = false at the next frame boundary. frame = the swap counter used in the
+  // frame-trace (.xtr) file name, so an F9-style trace of the same frame has the same number.
+  virtual void OnCompareFrame(bool begin, uint32_t frame) { (void)begin; (void)frame; }
 };
 
+// Request a compare window for the next frame (thread-safe; a no-op unless
+// --nr_compare_dump_dir is set).
+void RequestNrCompareFrame();
+
 // Not thread-safe to change while the GPU thread runs; set before the title or replay starts.
 void SetDrawObserver(DrawObserver* observer);
 DrawObserver* GetDrawObserver();
