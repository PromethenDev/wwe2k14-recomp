 REXCVAR_DEFINE_STRING(draw_edram_dump, "", "GPU",
                       "Native-renderer evidence: ORD1,ORD2,...:DIR - after each listed draw packet "
                       "(numbered as draw_state_dump), write the whole EDRAM (guest layout, every "
@@ -1243,6 +1251,7 @@ bool CommandProcessor::ExecutePacketType3(memory::RingBuffer* reader, uint32_t p
 
   trace_writer_.WritePacketEnd();
   if (opcode == PM4_XE_SWAP) {
+    NrCompareOnSwap();
     // End the trace writer frame.
     if (trace_writer_.is_open()) {
       trace_writer_.WriteEvent(EventCommand::Type::kSwap);
@@ -1842,8 +1851,74 @@ void CommandProcessor::DumpDrawState(uint32_t ordinal, uint32_t draw_initiator,
 
 // resolve_dump_dir: the destination extent of a resolve, as it is in guest memory after the
 // backend's copy (readback_resolve=full writes it back synchronously).
+namespace {
+std::atomic<bool> g_nr_compare_request{false};
+bool g_nr_compare_active = false;
+bool g_nr_compare_started_at_start = false;
+uint32_t g_nr_compare_frame = 0;
+std::string NrCompareSdkDir() {
+  return fmt::format("{}/frame-{}/sdk", REXCVAR_GET(nr_compare_dump_dir), g_nr_compare_frame);
+}
+}  // namespace
+
+void RequestNrCompareFrame() {
+  if (!REXCVAR_GET(nr_compare_dump_dir).empty()) {
+    g_nr_compare_request.store(true, std::memory_order_relaxed);
+  }
+}
+
+// Frame boundary (XE_SWAP packet end): close an open compare window, open a requested one. A
+// live window starts from the SDK's own EDRAM, handed to the observer as a snapshot.
+void CommandProcessor::NrCompareOnSwap() {
+  if (REXCVAR_GET(nr_compare_dump_dir).empty()) {
+    return;
+  }
+  DrawObserver* observer = GetDrawObserver();
+  if (g_nr_compare_active) {
+    g_nr_compare_active = false;
+    REXGPU_INFO("nr_compare: window for frame {} closed", g_nr_compare_frame);
+    if (observer) observer->OnCompareFrame(false, g_nr_compare_frame);
+  }
+  if (!g_nr_compare_request.exchange(false, std::memory_order_relaxed)) {
+    return;
+  }
+  g_nr_compare_frame = counter_ - 1;
+  std::error_code ec;
+  std::filesystem::create_directories(NrCompareSdkDir(), ec);
+  g_nr_compare_active = true;
+  REXGPU_INFO("nr_compare: window for frame {} opened ({})", g_nr_compare_frame, NrCompareSdkDir());
+  if (observer) {
+    observer->OnCompareFrame(true, g_nr_compare_frame);
+    std::vector<uint8_t> edram;
+    if (DumpEdram(edram)) {
+      observer->OnEdramSnapshot(edram.data(), edram.size());
+    } else {
+      REXGPU_ERROR("nr_compare: EDRAM download failed for frame {}", g_nr_compare_frame);
+    }
+  }
+}
+
+void CommandProcessor::NrCompareAtStart() {
+  if (g_nr_compare_started_at_start || !REXCVAR_GET(nr_compare_at_start) ||
+      REXCVAR_GET(nr_compare_dump_dir).empty()) {
+    return;
+  }
+  g_nr_compare_started_at_start = true;
+  g_nr_compare_frame = 0;
+  std::error_code ec;
+  std::filesystem::create_directories(NrCompareSdkDir(), ec);
+  g_nr_compare_active = true;
+  if (DrawObserver* observer = GetDrawObserver()) observer->OnCompareFrame(true, 0);
+}
+
 void CommandProcessor::DumpResolveResult() {
-  const std::string& dir = REXCVAR_GET(resolve_dump_dir);
+  if (g_nr_compare_active) {
+    DumpResolveResultTo(NrCompareSdkDir());
+  }
+  DumpResolveResultTo(REXCVAR_GET(resolve_dump_dir));
+}
+
+void CommandProcessor::DumpResolveResultTo(const std::string& dir) {
   if (dir.empty() || register_file_->Get<reg::RB_MODECONTROL>().edram_mode != xenos::EdramMode::kCopy) {
     return;
   }
@@ -1957,6 +2032,7 @@ bool CommandProcessor::ExecutePacketType3Draw(memory::RingBuffer* reader, uint32
     static std::atomic<uint32_t> draw_ordinal{0};
     const uint32_t ordinal = draw_ordinal.fetch_add(1, std::memory_order_relaxed);
     current_draw_ordinal_ = ordinal;
+    NrCompareAtStart();
     DumpDrawState(ordinal, vgt_draw_initiator.value, is_indexed ? &index_buffer_info : nullptr);
     if (DrawObserver* observer = g_draw_observer) {
       string::StringBuffer disasm;
