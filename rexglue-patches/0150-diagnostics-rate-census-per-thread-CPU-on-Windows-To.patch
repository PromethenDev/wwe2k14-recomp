From 2763d50f12c8ddb1ee33a65807c10a1767557b22 Mon Sep 17 00:00:00 2001
From: PromethenDev <PromethenDev@users.noreply.github.com>
Date: Mon, 23 Nov 2026 18:16:15 -0800
Subject: [PATCH 150/150] diagnostics: rate census per-thread CPU on Windows
 (Toolhelp32 + GetThreadTimes, thread descriptions); SLOWLOAD 11-23

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/core/rate_census.cpp | 58 ++++++++++++++++++++++++++++++++++++++++
 1 file changed, 58 insertions(+)

diff --git a/src/core/rate_census.cpp b/src/core/rate_census.cpp
index 07dfff36..83f47260 100644
--- a/src/core/rate_census.cpp
+++ b/src/core/rate_census.cpp
@@ -37,11 +37,34 @@
 #include <signal.h>
 #include <sys/syscall.h>
 #include <unistd.h>
+#elif REX_PLATFORM_WIN32
+#include <windows.h>
+#include <tlhelp32.h>
 #endif
 
 namespace rex::diagnostics::rate_census {
 namespace {
 
+#if REX_PLATFORM_WIN32
+// Windows thread name (SetThreadDescription), "?" if none. Diagnostic only.
+std::string WinThreadName(HANDLE thread) {
+  using GetThreadDescriptionFn = HRESULT(WINAPI*)(HANDLE, PWSTR*);
+  static const auto get_description = reinterpret_cast<GetThreadDescriptionFn>(
+      GetProcAddress(GetModuleHandleW(L"kernel32.dll"), "GetThreadDescription"));
+  std::string name = "?";
+  PWSTR wide = nullptr;
+  if (get_description && SUCCEEDED(get_description(thread, &wide)) && wide) {
+    const int size = WideCharToMultiByte(CP_UTF8, 0, wide, -1, nullptr, 0, nullptr, nullptr);
+    if (size > 1) {
+      name.assign(size_t(size - 1), '\0');
+      WideCharToMultiByte(CP_UTF8, 0, wide, -1, name.data(), size, nullptr, nullptr);
+    }
+    LocalFree(wide);
+  }
+  return name;
+}
+#endif
+
 constexpr size_t kCpPhaseCount = size_t(CpPhase::kCount);
 static_assert(kCpPhaseCount == sizeof(Sample::cp_phase_ms) / sizeof(double));
 
@@ -60,6 +83,12 @@ std::string ThreadName(uint32_t tid) {
   if (comm && std::getline(comm, name)) {
     return name;
   }
+#elif REX_PLATFORM_WIN32
+  if (HANDLE thread = OpenThread(THREAD_QUERY_LIMITED_INFORMATION, FALSE, tid)) {
+    std::string name = WinThreadName(thread);
+    CloseHandle(thread);
+    return name;
+  }
 #endif
   return "?";
 }
@@ -242,6 +271,33 @@ ThreadTickMap ReadThreadTicks() {
       result.emplace(tid, std::move(ticks));
     }
   }
+#elif REX_PLATFORM_WIN32
+  // Ticks are 100 ns units here (FILETIME); CalculateThreadCpu uses the matching rate.
+  HANDLE snapshot = CreateToolhelp32Snapshot(TH32CS_SNAPTHREAD, 0);
+  if (snapshot != INVALID_HANDLE_VALUE) {
+    const DWORD pid = GetCurrentProcessId();
+    THREADENTRY32 entry{};
+    entry.dwSize = sizeof(entry);
+    for (BOOL ok = Thread32First(snapshot, &entry); ok; ok = Thread32Next(snapshot, &entry)) {
+      if (entry.th32OwnerProcessID != pid) {
+        continue;
+      }
+      HANDLE thread = OpenThread(THREAD_QUERY_LIMITED_INFORMATION, FALSE, entry.th32ThreadID);
+      if (!thread) {
+        continue;
+      }
+      FILETIME created, exited, kernel, user;
+      if (GetThreadTimes(thread, &created, &exited, &kernel, &user)) {
+        ThreadTicks ticks;
+        ticks.name = WinThreadName(thread);
+        ticks.utime = (uint64_t(user.dwHighDateTime) << 32) | user.dwLowDateTime;
+        ticks.stime = (uint64_t(kernel.dwHighDateTime) << 32) | kernel.dwLowDateTime;
+        result.emplace(uint32_t(entry.th32ThreadID), std::move(ticks));
+      }
+      CloseHandle(thread);
+    }
+    CloseHandle(snapshot);
+  }
 #endif
   return result;
 }
@@ -267,6 +323,8 @@ ThreadCpuReport CalculateThreadCpu(const ThreadTickMap& previous,
 
 #if REX_PLATFORM_LINUX
   const long clock_ticks = std::max<long>(1, sysconf(_SC_CLK_TCK));
+#elif REX_PLATFORM_WIN32
+  constexpr long clock_ticks = 10'000'000;  // FILETIME 100 ns units (ReadThreadTicks)
 #else
   constexpr long clock_ticks = 100;
 #endif
