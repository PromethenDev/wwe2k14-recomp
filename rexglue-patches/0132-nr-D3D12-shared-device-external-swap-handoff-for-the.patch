 DrawObserver* GetDrawObserver() { return g_draw_observer; }
 
+// [wwe2k14 nr] card C3: backend-neutral storage for the D3D12 shared-present handoff.
+namespace {
+NrD3D12Device g_nr_d3d12_device;
+bool g_nr_d3d12_device_set = false;
+NrD3D12ExternalSwap g_nr_d3d12_swap;
+bool g_nr_d3d12_swap_set = false;
+std::atomic<uint64_t> g_nr_d3d12_swap_completion{0};
+}  // namespace
+
+void NrSetD3D12Device(const NrD3D12Device* device) {
+  g_nr_d3d12_device_set = device != nullptr;
+  g_nr_d3d12_device = device ? *device : NrD3D12Device{};
+}
+
+bool GetNrD3D12Device(NrD3D12Device* out) {
+  if (!out || !g_nr_d3d12_device_set || !REXCVAR_GET(nr_d3d12_shared_device)) return false;
+  *out = g_nr_d3d12_device;
+  return true;
+}
+
+void SetNrD3D12ExternalSwap(const NrD3D12ExternalSwap& swap) {
+  g_nr_d3d12_swap = swap;
+  g_nr_d3d12_swap_set = swap.resource != nullptr;
+}
+
+bool NrTakeD3D12ExternalSwap(NrD3D12ExternalSwap* out) {
+  if (!g_nr_d3d12_swap_set || !out) return false;
+  *out = g_nr_d3d12_swap;
+  g_nr_d3d12_swap_set = false;
+  return true;
+}
+
+void NrNoteD3D12SwapSubmission(uint64_t submission) {
+  g_nr_d3d12_swap_completion.store(submission, std::memory_order_release);
+}
+
+uint64_t GetNrD3D12SwapCompletion() {
+  return g_nr_d3d12_swap_completion.load(std::memory_order_acquire);
+}
+
+#if !REX_HAS_VULKAN
+// D3D12-only builds still link the Vulkan direct-present entry points used by the native app.
+bool GetNrVulkanDevice(NrVulkanDevice* out) {
+  (void)out;
+  return false;
+}
+void SetNrExternalSwap(const NrExternalSwap& swap) { (void)swap; }
+#endif
