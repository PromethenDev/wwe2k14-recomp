diff --git a/include/rex/graphics/draw_observer.h b/include/rex/graphics/draw_observer.h
index 00479468..d71f93b5 100644
--- a/include/rex/graphics/draw_observer.h
+++ b/include/rex/graphics/draw_observer.h
@@ -141,6 +141,41 @@ struct NrExternalSwap {
   uint64_t external_cpu_fence_value = 0;
 };
 void SetNrExternalSwap(const NrExternalSwap& swap);
+// [wwe2k14 nr] card C3: D3D12 shared-device direct presentation. Opaque pointers keep D3D12 headers out of this
+// backend-neutral observer interface.
+struct NrD3D12Device {
+  void* device = nullptr;        // ID3D12Device*
+  void* direct_queue = nullptr;  // ID3D12CommandQueue*
+  void* dxgi_factory = nullptr;  // IDXGIFactory2*
+  uint32_t adapter_luid_low = 0;
+  int32_t adapter_luid_high = 0;
+  void* submission_fence = nullptr;  // ID3D12Fence*, signalled with the SDK submission number
+};
+// False unless the D3D12 command-processor context is up and nr_d3d12_shared_device is enabled. Returned pointers are
+// SDK-owned and valid until command-processor shutdown; a caller retaining one beyond the call must AddRef it.
+bool GetNrD3D12Device(NrD3D12Device* out);
+// The next D3D12 IssueSwap presents this resource in place of the guest frontbuffer; fetch constant 0 is not read.
+// Consume by calling on the GPU command-processor thread (DrawObserver::OnBeforeSwap). The resource must be a
+// one-mip, single-sample TEXTURE2D created on the device returned by GetNrD3D12Device. Once wait_fence reaches
+// wait_value (or the producer's earlier same-queue submission completes when wait_fence is null), it must be in a
+// state containing NON_PIXEL_SHADER_RESOURCE. The SDK samples it through an SRV and issues no barrier; it leaves
+// the state unchanged. The producer retains the resource until GetNrD3D12SwapCompletion reaches the value returned
+// after this swap (or until a later swap sampling another resource completes).
+struct NrD3D12ExternalSwap {
+  void* resource = nullptr;  // ID3D12Resource*
+  // Presented area. The swap samples by pixel index from (0, 0).
+  uint32_t width = 0, height = 0;
+  // Guest frontbuffer size; zero means width / height.
+  uint32_t width_unscaled = 0, height_unscaled = 0;
+  uint32_t srv_format = 0;         // DXGI_FORMAT; 0 = DXGI_FORMAT_R8G8B8A8_UNORM
+  uint32_t component_mapping = 0;  // D3D12 Shader4ComponentMapping; 0 = D3D12_DEFAULT_SHADER_4_COMPONENT_MAPPING
+  void* wait_fence = nullptr;      // ID3D12Fence*, GPU-waited by the SDK's direct queue
+  uint64_t wait_value = 0;
+};
+// The SDK applies its guest 8-bit gamma table to this frontbuffer, as for k_8_8_8_8.
+void SetNrD3D12ExternalSwap(const NrD3D12ExternalSwap& swap);
+// Submission number of the latest SDK swap that sampled an external resource; 0 before the first such swap.
+uint64_t GetNrD3D12SwapCompletion();
 // [wwe2k14 nr] card S3-44: called on the guest thread for every CP_RB_WPTR write (the guest kicked the ring past
 // everything it wrote so far). Set before the title starts; null = off.
 using NrWritePointerHook = void (*)(uint32_t value);
