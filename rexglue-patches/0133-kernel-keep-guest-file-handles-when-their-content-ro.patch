diff --git a/src/system/util/object_table.cpp b/src/system/util/object_table.cpp
index 3af117e4..b66cea94 100644
--- a/src/system/util/object_table.cpp
+++ b/src/system/util/object_table.cpp
@@ -12,12 +12,24 @@
 #include <algorithm>
 #include <cstring>
 
+#include <rex/cvar.h>
 #include <rex/logging.h>
+#include <rex/memory.h>
 #include <rex/stream.h>
 #include <rex/system/util/object_table.h>
 #include <rex/system/xobject.h>
