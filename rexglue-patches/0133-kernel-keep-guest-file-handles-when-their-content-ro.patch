   auto* state = rex::runtime::ThreadState::Get();
   return state ? uint64_t(state->context()->lr) : 0;
 }
+
+// Card S5-2: hands the freeze logger the guest call chain of this wait and, for a file object, its path. PPC back
+// chain: [sp] = caller's sp, the caller's saved LR sits at caller_sp - 8. The walk stays inside the thread's stack
+// (PCR stack_end_ptr..stack_base_ptr), so a bad chain ends the walk instead of touching unmapped memory.
+uint32_t GuestStack(uint32_t* lrs, uint32_t max_frames) {
+  auto* state = rex::runtime::ThreadState::Get();
+  if (!state) return 0;
+  auto* memory = REX_KERNEL_MEMORY();
+  auto* pcr = memory->TranslateVirtual<X_KPCR*>(static_cast<uint32_t>(state->context()->r13.u64));
+  const uint32_t stack_low = pcr ? uint32_t(pcr->stack_end_ptr) : 0;
+  const uint32_t stack_high = pcr ? uint32_t(pcr->stack_base_ptr) : 0;
+  uint32_t count = 0;
+  uint32_t sp = state->context()->r1.u32;
+  while (count < max_frames && stack_low && sp >= stack_low && sp + 4 <= stack_high) {
+    const uint32_t caller_sp = memory::load_and_swap<uint32_t>(memory->TranslateVirtual(sp));
+    if (caller_sp <= sp || caller_sp > stack_high || caller_sp - 8 < stack_low) break;
+    lrs[count++] = memory::load_and_swap<uint32_t>(memory->TranslateVirtual(caller_sp - 8));
+    sp = caller_sp;
+  }
+  return count;
+}
+
+void RecordWaitContext(XObject* object) {
+  if (!freeze_logger::IsEnabled() || !object) return;
+  uint32_t lrs[freeze_logger::kMaxWaitFrames];
+  const uint32_t count = GuestStack(lrs, freeze_logger::kMaxWaitFrames);
+  std::string path;
+  if (object->type() == XObject::Type::File) {
+    path = static_cast<XFile*>(object)->path();
+    uint32_t type = 0, closer[rex::system::util::ObjectTable::kClosedFrames] = {};
+    if (REX_KERNEL_OBJECTS()->LastClosed(object->handle(), &type, closer)) {
+      path += fmt::format(" | number last held type {} closed by {:08X} {:08X} {:08X} {:08X}", type, closer[0],
+                          closer[1], closer[2], closer[3]);
+    }
+  }
+  freeze_logger::RecordWaitContext(lrs, count, path.c_str());
+}
+
+// Card S5-2: a guest wait on a handle that is no longer open. Logs what the handle last held and the guest LR that
+// closed it (at most 32 lines per session), so a stale handle in game code is visible in player logs.
+void NoteStaleWait(uint32_t handle) {
+  static std::atomic<uint32_t> notes{0};
+  if (handle < XObject::kHandleBase || notes.fetch_add(1, std::memory_order_relaxed) >= 32) return;
+  uint32_t type = 0, closer[rex::system::util::ObjectTable::kClosedFrames] = {};
+  const bool closed = REX_KERNEL_OBJECTS()->LastClosed(handle, &type, closer);
+  uint32_t lrs[6] = {};
+  const uint32_t n = GuestStack(lrs, 6);
+  REXLOG_WARN("[stale-handle] wait on closed handle 0x{:08X} (last held type {}, closed by 0x{:08X} 0x{:08X} 0x{:08X} "
+              "0x{:08X}) waiter lr 0x{:08X} stack 0x{:08X} 0x{:08X} 0x{:08X} 0x{:08X} (frames {})",
+              handle, closed ? int(type) : -1, closer[0], closer[1], closer[2], closer[3], uint32_t(GuestLr()),
+              lrs[0], lrs[1], lrs[2], lrs[3], n);
+}
 }  // namespace
 
