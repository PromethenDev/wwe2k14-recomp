+// Card S5-2 (endless loading on Windows, GitHub #29/#72/#83/#84): the free-slot scan restarted at slot 0, so a closed
+// handle number was handed to the very next new object. A game that still waits on a handle it closed then waited on
+// an unrelated object - in the s52w-3 freeze report the audio lock's mutex handle 0xF8000770 had become the file
+// sound\DLC_01.pck, which never signals. Round-robin allocation reuses a number only after the whole table has
+// cycled, so a stale handle stays invalid (the wait fails at once) instead of aliasing a new object.
+REXCVAR_DEFINE_BOOL(WWE2K14_HANDLE_ROUND_ROBIN, false, "Kernel",
+                    "Allocate guest handles round-robin so closed handle numbers are not reused at once");
+
 namespace rex::system::util {
 
 ObjectTable::ObjectTable() {}
@@ -108,6 +120,9 @@ X_STATUS ObjectTable::AddHandle(XObject* object, X_HANDLE* out_handle) {
 
     // Stash.
     if (XSUCCEEDED(result)) {
+      if (REXCVAR_GET(WWE2K14_HANDLE_ROUND_ROBIN)) {
+        last_free_entry_ = slot + 1 < table_capacity_ ? slot + 1 : 1;
+      }
       ObjectTableEntry& entry = table_[slot];
       entry.object = object;
       entry.handle_ref_count = 1;
@@ -192,6 +207,14 @@ X_STATUS ObjectTable::RemoveHandle(X_HANDLE handle) {
   if (entry->object) {
     auto object = entry->object;
     entry->object = nullptr;
+    const uint32_t slot = GetHandleSlot(handle);
+    if (closed_.size() < table_capacity_) closed_.resize(table_capacity_);
+    if (slot < closed_.size()) {
+      ClosedSlot& closed = closed_[slot];
+      closed = {};
+      closed.type = uint32_t(object->type()) + 1;
+      CloserStack(closed.closer_lrs);
+    }
     assert_zero(entry->handle_ref_count);
     entry->handle_ref_count = 0;
 
@@ -214,6 +237,37 @@ X_STATUS ObjectTable::RemoveHandle(X_HANDLE handle) {
   return X_STATUS_SUCCESS;
 }
 
+// Guest LR of the closing call plus the next back-chain return addresses (PPC: [sp] = caller sp, saved LR at
+// caller_sp - 8), kept inside the thread's stack bounds from its PCR. Host threads record nothing.
+void ObjectTable::CloserStack(uint32_t* lrs) {
+  auto* state = rex::runtime::ThreadState::Get();
+  if (!state) return;
+  auto* context = state->context();
+  lrs[0] = uint32_t(context->lr);
+  auto* memory = context->kernel_state ? context->kernel_state->memory() : nullptr;
+  if (!memory) return;
+  auto* pcr = memory->TranslateVirtual<X_KPCR*>(static_cast<uint32_t>(context->r13.u64));
+  const uint32_t low = pcr ? uint32_t(pcr->stack_end_ptr) : 0, high = pcr ? uint32_t(pcr->stack_base_ptr) : 0;
+  uint32_t sp = context->r1.u32;
+  for (uint32_t n = 1; n < kClosedFrames && low && sp >= low && sp + 4 <= high; ++n) {
+    const uint32_t caller_sp = rex::memory::load_and_swap<uint32_t>(memory->TranslateVirtual(sp));
+    if (caller_sp <= sp || caller_sp > high || caller_sp - 8 < low) break;
+    lrs[n] = rex::memory::load_and_swap<uint32_t>(memory->TranslateVirtual(caller_sp - 8));
+    sp = caller_sp;
+  }
+}
+
+bool ObjectTable::LastClosed(X_HANDLE handle, uint32_t* out_type, uint32_t* out_closer_lrs) {
+  auto global_lock = global_critical_region_.Acquire();
+  handle = TranslateHandle(handle);
+  if (handle < XObject::kHandleBase) return false;
+  const uint32_t slot = GetHandleSlot(handle);
+  if (slot >= closed_.size() || !closed_[slot].type) return false;
+  *out_type = closed_[slot].type - 1;
+  std::memcpy(out_closer_lrs, closed_[slot].closer_lrs, sizeof(closed_[slot].closer_lrs));
+  return true;
+}
+
 std::vector<object_ref<XObject>> ObjectTable::GetAllObjects() {
   auto lock = global_critical_region_.Acquire();
   std::vector<object_ref<XObject>> results;
