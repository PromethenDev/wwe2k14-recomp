@@ -438,7 +444,15 @@ void ContentManager::CloseOpenedFilesFromContent(const std::string_view root_nam
     bool is_file_inside_content = rex::string::utf8_starts_with(file_path, resolved_path);
 
     if (is_file_inside_content) {
-      file->ReleaseHandle();
+      // Card S5-2 (endless loading, GitHub #29/#72/#83/#84): releasing here frees a handle the guest still owns.
+      // When the guest later closes "its" file, the number may already belong to a new object (s52w-3: Bink's
+      // mutex), which is then closed under the guest and the number reused again (sound\DLC_01.pck) -> the Bink
+      // lock waits on a file forever. WWE2K14_CONTENT_CLOSE_KEEP_FILES=1 keeps the guest's handles (the guest
+      // closes them itself); either way the release is logged.
+      const bool keep = REXCVAR_GET(WWE2K14_CONTENT_CLOSE_KEEP_FILES);
+      REXSYS_WARN("[content-close] root {} {} guest file handle 0x{:08X} {}", root_name,
+                  keep ? "keeps" : "releases", file->handle(), file_path);
+      if (!keep) file->ReleaseHandle();
     }
   }
 }
