diff --git a/include/rex/codegen/function_types.h b/include/rex/codegen/function_types.h
index ef36b6a..f292eee 100644
--- a/include/rex/codegen/function_types.h
+++ b/include/rex/codegen/function_types.h
@@ -238,6 +238,12 @@ struct JumpTable {
   uint32_t bctrAddress;           // Address of bctr instruction
   uint32_t tableAddress;          // Address of jump table data
   uint8_t indexRegister;          // Register holding switch index
+  int32_t indexBias = 0;          // Value ADDED to the switch index before the table lookup;
+                                  // emitted case labels become bias+i. 0 = no bias, and 0 in
+                                  // union mode: when the bias is conditional (a sibling path
+                                  // reaches the shared bctr un-biased), targets[] is read from
+                                  // the un-biased base over the union window [0, bias+count)
+                                  // and the switch emits plain case 0..N-1 labels.
   std::vector<uint32_t> targets;  // Resolved case targets (internal labels)
 };
 
diff --git a/include/rex/codegen/vtable_scanner.h b/include/rex/codegen/vtable_scanner.h
index cb449e6..109e236 100644
--- a/include/rex/codegen/vtable_scanner.h
+++ b/include/rex/codegen/vtable_scanner.h
@@ -68,8 +68,13 @@ class VTableScanner {
   // Find all Complete Object Locators in .rdata
   std::vector<uint32_t> findCompleteObjectLocators();
 
-  // Find the vtable that references a given COL (COL is at vtable[-1])
-  std::optional<uint32_t> findVTableForCOL(uint32_t colAddr);
+  // Find EVERY vtable that references a given COL (the COL sits at vtable[-1]).
+  // Returns all matches, not just the first: a class with multiple inheritance
+  // has one vtable per base subobject with a vfptr, and the linker may fold
+  // identical COLs (/OPT:ICF) so several vtables share one. Returning only the
+  // first silently drops every secondary-base vtable -- and adjustor/dispatch
+  // thunks live precisely in those.
+  std::vector<uint32_t> findVTablesForCOL(uint32_t colAddr);
 
   // Read all function slots from a vtable (until non-executable address)
   std::vector<uint32_t> readVTableSlots(uint32_t vtableStart);
