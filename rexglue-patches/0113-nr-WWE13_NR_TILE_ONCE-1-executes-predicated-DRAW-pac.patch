From 5f7522cda0440c63a5947fb0c54318447d67604e Mon Sep 17 00:00:00 2001
From: PromethenDev <PromethenDev@users.noreply.github.com>
Date: Thu, 8 Oct 2026 13:04:38 -0700
Subject: [PATCH 113/149] nr: WWE13_NR_TILE_ONCE=1 executes predicated DRAW
 packets regardless of the bin check

The native renderer's tile-once draws the predicated-tiled scene once (pass 1, full width) and drops passes 2-4,
so pass 1 must see draws binned only to tiles 2-4. Opt-in; other predicated packets unchanged.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
(cherry picked from commit 9de81543940bf928af63f298377187335dcee131)
---
 src/graphics/command_processor.cpp | 11 +++++++++++
 1 file changed, 11 insertions(+)

diff --git a/src/graphics/command_processor.cpp b/src/graphics/command_processor.cpp
index ce2fcb4c..45625d07 100644
--- a/src/graphics/command_processor.cpp
+++ b/src/graphics/command_processor.cpp
@@ -1125,6 +1125,17 @@ bool CommandProcessor::ExecutePacketType3(memory::RingBuffer* reader, uint32_t p
   // We also skip predicated swaps, as they are never valid (probably?).
   if (packet & 1) {
     bool any_pass = (bin_select_ & bin_mask_) != 0;
+    // nr tile-once (WWE13_NR_TILE_ONCE=1, opt-in): the native renderer draws the predicated-tiled scene ONCE
+    // (tiling pass 1, full width) and drops passes 2-4, so pass 1 must see every scene draw, including those
+    // binned only to tiles 2-4. Execute predicated DRAW packets regardless of the bin check; the observer
+    // drops the duplicates of passes 2-4 by PA_SC_WINDOW_OFFSET. Other predicated packets are unchanged.
+    static const bool nr_tile_once = [] {
+      const char* e = std::getenv("WWE13_NR_TILE_ONCE");
+      return e != nullptr && std::strcmp(e, "1") == 0;
+    }();
+    if (nr_tile_once && !any_pass && (opcode == PM4_DRAW_INDX || opcode == PM4_DRAW_INDX_2)) {
+      any_pass = true;
+    }
     if (!any_pass || opcode == PM4_XE_SWAP) {
       reader->AdvanceRead(count * sizeof(uint32_t));
       trace_writer_.WritePacketEnd();
