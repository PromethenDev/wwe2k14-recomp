+// draw_state_dump: one binary file per draw ("NRDS" v1, little-endian):
+//   u32 magic 'NRDS', u32 version 1, u32 ordinal, u32 VGT_DRAW_INITIATOR,
+//   u32 indexed, u32 index guest_base, u32 index length bytes, u32 index endianness,
+//   u32 register_count, u32 registers[register_count],
+//   u32 vs_dwords, u64 vs_hash, u32 vs_ucode[vs_dwords] (host order),
+//   u32 ps_dwords, u64 ps_hash, u32 ps_ucode[ps_dwords]
+void CommandProcessor::DumpDrawState(uint32_t draw_initiator, const IndexBufferInfo* index_info) {
+  static std::atomic<uint32_t> ordinal_counter{0};
+  const uint32_t ordinal = ordinal_counter.fetch_add(1, std::memory_order_relaxed);
+  const std::string& spec = REXCVAR_GET(draw_state_dump);
+  if (spec.empty()) {
+    return;
+  }
+  static uint32_t first = 0, last = 0;
+  static std::string dir;
+  static bool parsed = false, valid = false;
+  if (!parsed) {
+    parsed = true;
+    const size_t c1 = spec.find(':');
+    const size_t c2 = c1 == std::string::npos ? c1 : spec.find(':', c1 + 1);
+    if (c2 != std::string::npos) {
+      first = uint32_t(std::strtoul(spec.substr(0, c1).c_str(), nullptr, 0));
+      last = uint32_t(std::strtoul(spec.substr(c1 + 1, c2 - c1 - 1).c_str(), nullptr, 0));
+      dir = spec.substr(c2 + 1);
+      valid = true;
+    } else {
+      REXGPU_ERROR("draw_state_dump: expected FIRST:LAST:DIR, got '{}'", spec);
+    }
+  }
+  if (!valid || ordinal < first || ordinal > last) {
+    return;
+  }
+  std::vector<uint32_t> out;
+  auto put = [&out](uint32_t v) { out.push_back(v); };
+  put(0x5344524E);  // 'NRDS'
+  put(1);
+  put(ordinal);
+  put(draw_initiator);
+  put(index_info ? 1 : 0);
+  put(index_info ? index_info->guest_base : 0);
+  put(index_info ? index_info->length : 0);
+  put(index_info ? uint32_t(index_info->endianness) : 0);
+  put(uint32_t(RegisterFile::kRegisterCount));
+  out.insert(out.end(), register_file_->values, register_file_->values + RegisterFile::kRegisterCount);
+  uint64_t hashes[2] = {0, 0};
+  const Shader* shaders[2] = {active_vertex_shader(), active_pixel_shader()};
+  for (int i = 0; i < 2; ++i) {
+    const Shader* sh = shaders[i];
+    const uint32_t n = sh ? uint32_t(sh->ucode_dword_count()) : 0;
+    hashes[i] = sh ? sh->ucode_data_hash() : 0;
+    put(n);
+    put(uint32_t(hashes[i]));
+    put(uint32_t(hashes[i] >> 32));
+    if (n) out.insert(out.end(), sh->ucode_dwords(), sh->ucode_dwords() + n);
+  }
+  const std::string path = fmt::format("{}/draw-{:06}.bin", dir, ordinal);
+  if (FILE* f = std::fopen(path.c_str(), "wb")) {
+    std::fwrite(out.data(), sizeof(uint32_t), out.size(), f);
+    std::fclose(f);
+  } else {
+    REXGPU_ERROR("draw_state_dump: cannot write {}", path);
+    return;
+  }
+  // The SDK's own analysis of both shaders: which fetch constants they really
+  // read (texture fetch slot + dimension, vertex fetch constant + layout) and
+  // the disassembly - the independent record a native renderer's bindings are
+  // checked against.
+  if (FILE* f = std::fopen(fmt::format("{}/draw-{:06}.txt", dir, ordinal).c_str(), "wb")) {
+    string::StringBuffer disasm;
+    for (int i = 0; i < 2; ++i) {
+      Shader* sh = i == 0 ? active_vertex_shader() : active_pixel_shader();
+      std::fprintf(f, "%s %016llX\n", i == 0 ? "VS" : "PS", (unsigned long long)hashes[i]);
+      if (!sh) continue;
+      if (!sh->is_ucode_analyzed()) sh->AnalyzeUcode(disasm);
+      for (const auto& tb : sh->texture_bindings()) {
+        std::fprintf(f, "  texture fetch=%u dim=%u opcode=%s\n", tb.fetch_constant,
+                     uint32_t(tb.fetch_instr.dimension),
+                     tb.fetch_instr.opcode_name ? tb.fetch_instr.opcode_name : "?");
+      }
+      for (const auto& vb : sh->vertex_bindings()) {
+        std::fprintf(f, "  vertex fetch=%u stride_words=%u\n", vb.fetch_constant, vb.stride_words);
+        for (const auto& a : vb.attributes) {
+          std::fprintf(f, "    attr format=%u offset=%d signed=%d integer=%d exp_adjust=%d\n",
+                       uint32_t(a.fetch_instr.attributes.data_format), a.fetch_instr.attributes.offset,
+                       int(a.fetch_instr.attributes.is_signed), int(a.fetch_instr.attributes.is_integer),
+                       a.fetch_instr.attributes.exp_adjust);
+        }
+      }
+      std::fprintf(f, "%s\n", sh->ucode_disassembly().c_str());
+    }
+    std::fclose(f);
+  }
+  if (FILE* f = std::fopen((dir + "/draws.tsv").c_str(), "ab")) {
+    std::fprintf(f, "%u\t%08X\t%u\t%016llX\t%016llX\n", ordinal, draw_initiator,
+                 uint32_t(register_file_->Get<reg::RB_MODECONTROL>().edram_mode),
+                 (unsigned long long)hashes[0], (unsigned long long)hashes[1]);
+    std::fclose(f);
+  }
+}
