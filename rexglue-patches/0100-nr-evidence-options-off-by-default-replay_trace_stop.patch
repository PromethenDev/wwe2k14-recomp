                       "Replay this single-frame GPU trace (.xtr) instead of launching the "
@@ -301,8 +309,48 @@ bool ReXApp::OnInitialize() {
         if (player->Open(trace_path.string()) && player->frame_count() > 0) {
           REXLOG_INFO("Replaying trace {} ({} frames)", trace_path.string(), player->frame_count());
           player->SeekFrame(0);
-          player->SeekCommand(static_cast<int>(player->current_frame()->commands.size() - 1));
+          const int32_t command_count = static_cast<int32_t>(player->current_frame()->commands.size());
+          const int32_t stop_after = REXCVAR_GET(replay_trace_stop_after_command);
+          const bool partial = stop_after >= 0 && stop_after < command_count - 1;
+          player->SeekCommand(partial ? stop_after : command_count - 1);
           player->WaitOnPlayback();
+          REXLOG_INFO("Replay played commands 0..{} of {}", partial ? stop_after : command_count - 1,
+                      command_count);
+          // Guest memory ranges after playback (e.g. a resolve's destination with
+          // readback_resolve=full). Each written file is logged with its size.
+          bool dumps_ok = true;
+          const std::string dump_spec = REXCVAR_GET(replay_trace_dump);
+          size_t pos = 0;
+          while (pos < dump_spec.size()) {
+            size_t end = dump_spec.find(';', pos);
+            if (end == std::string::npos) end = dump_spec.size();
+            const std::string item = dump_spec.substr(pos, end - pos);
+            pos = end + 1;
+            const size_t c1 = item.find(':');
+            const size_t c2 = c1 == std::string::npos ? c1 : item.find(':', c1 + 1);
+            if (c2 == std::string::npos) {
+              REXLOG_ERROR("Replay dump: bad item '{}'", item);
+              dumps_ok = false;
+              continue;
+            }
+            const uint32_t address = uint32_t(std::stoul(item.substr(0, c1), nullptr, 16));
+            const uint32_t length = uint32_t(std::stoul(item.substr(c1 + 1, c2 - c1 - 1), nullptr, 0));
+            const std::string file = item.substr(c2 + 1);
+            const uint8_t* src = runtime_->memory()->TranslatePhysical<const uint8_t*>(address);
+            FILE* f = src ? std::fopen(file.c_str(), "wb") : nullptr;
+            if (!f || std::fwrite(src, 1, length, f) != length) {
+              REXLOG_ERROR("Replay dump: could not write {:08X}+{} to {}", address, length, file);
+              dumps_ok = false;
+            } else {
+              REXLOG_INFO("Replay dump: {:08X}+{} -> {}", address, length, file);
+            }
+            if (f) std::fclose(f);
+          }
+          if (partial) {
+            REXLOG_INFO("Replay {}: partial frame, no image", dumps_ok ? "wrote" : "FAILED");
+            app_context().CallInUIThread([this]() { app_context().QuitFromUIThread(); });
+            return;
+          }
           const int32_t repeat = REXCVAR_GET(replay_trace_repeat);
           if (repeat > 1) {
             const auto start = std::chrono::steady_clock::now();
