From 4604f375651753529baf2162213173fca87dfd8b Mon Sep 17 00:00:00 2001
From: PromethenDev <PromethenDev@users.noreply.github.com>
Date: Sat, 26 Sep 2026 00:28:05 -0700
Subject: [PATCH 42/97] kernel: log the unimplemented
 XFileXctdCompressionInformation query once

WWE 13 issues it for thousands of files (log miner: 7,446 lines across sessions;
bursts overlap slow seconds 80% of the time) and every error line forces a
disk flush. Same X_STATUS_INVALID_PARAMETER result; one log line per session
(seen in the srb gate logs: "logged once").

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/kernel/xboxkrnl/xboxkrnl_io_info.cpp | 13 ++++++++++---
 1 file changed, 10 insertions(+), 3 deletions(-)

diff --git a/src/kernel/xboxkrnl/xboxkrnl_io_info.cpp b/src/kernel/xboxkrnl/xboxkrnl_io_info.cpp
index 1615ab4..80e430c 100644
--- a/src/kernel/xboxkrnl/xboxkrnl_io_info.cpp
+++ b/src/kernel/xboxkrnl/xboxkrnl_io_info.cpp
@@ -12,6 +12,8 @@
 // Disable warnings about unused parameters for kernel functions
 #pragma GCC diagnostic ignored "-Wunused-parameter"
 
+#include <mutex>
+
 #include <rex/filesystem/device.h>
 #include <rex/kernel/xboxkrnl/private.h>
 #include <rex/logging.h>
@@ -151,9 +153,14 @@ ppc_u32_result_t NtQueryInformationFile_entry(ppc_u32_t file_handle,
       break;
     }
     case XFileXctdCompressionInformation: {
-      REXKRNL_ERROR(
-          "NtQueryInformationFile(XFileXctdCompressionInformation) "
-          "unimplemented");
+      // WWE 13 asks this for thousands of files (log-miner: 7,446 lines, bursts aligned with slow seconds, and
+      // every error line forces a disk flush). The answer is always the same; say so once per session.
+      static std::once_flag xctd_logged;
+      std::call_once(xctd_logged, [] {
+        REXKRNL_ERROR(
+            "NtQueryInformationFile(XFileXctdCompressionInformation) "
+            "unimplemented (logged once; returns X_STATUS_INVALID_PARAMETER)");
+      });
       // Files that are XCTD compressed begin with the magic 0x0FF512ED but we
       // shouldn't detect this that way. There's probably a flag somewhere
       // (attributes?) that defines if it's compressed or not.
-- 
