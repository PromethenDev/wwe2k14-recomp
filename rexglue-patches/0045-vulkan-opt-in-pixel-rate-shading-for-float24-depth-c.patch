From 5858f4ba40248c5c8fef496fa376d476429e2daf Mon Sep 17 00:00:00 2001
From: PromethenDev <PromethenDev@users.noreply.github.com>
Date: Sat, 26 Sep 2026 12:05:40 -0700
Subject: [PATCH 45/97] vulkan: opt-in pixel-rate shading for float24 depth
 conversion

With depth_float24_convert_in_pixel_shader on and 4xMSAA render targets,
every pixel shader that does not write depth ran at sample rate (whole PS
4x per pixel) only to get per-sample depth. vulkan_float24_depth_pixel_rate
(default false) converts pixel-centre FragCoord.z at pixel rate instead
(no sampleShading, no gl_SampleID, DepthReplacing without DepthLess). The
mode is keyed into the pixel shader modification and the pipeline
description; pipeline storage version bumped.

Replay of one entrance frame x1500 (RTX 5060 Ti), same binary off/on:
2x GPU 20.1-20.2 -> 17.1-17.2 ms/frame (-15%), 87-92 W -> 76 W; images
deterministic per mode, on vs off mean |diff| 0.12, 93% of differing
pixels by 1 level. Reviewer ACCEPT: static check + fixed-entrance Linux
gates PASS with the option on and off.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../pipeline/shader/spirv_translator.h         |  9 +++++++--
 include/rex/graphics/vulkan/pipeline_cache.h   |  3 ++-
 .../pipeline/shader/spirv_translator.cpp       |  6 ++++--
 .../pipeline/shader/spirv_translator_rb.cpp    |  2 ++
 src/graphics/vulkan/pipeline_cache.cpp         | 18 +++++++++++++++---
 5 files changed, 30 insertions(+), 8 deletions(-)

diff --git a/include/rex/graphics/pipeline/shader/spirv_translator.h b/include/rex/graphics/pipeline/shader/spirv_translator.h
index c51ea54..df99bfd 100644
--- a/include/rex/graphics/pipeline/shader/spirv_translator.h
+++ b/include/rex/graphics/pipeline/shader/spirv_translator.h
@@ -88,6 +88,9 @@ class SpirvShaderTranslator : public ShaderTranslator {
       uint32_t param_gen_point : 1;
       // For host render targets - depth / stencil output mode.
       DepthStencilMode depth_stencil_mode : 3;
+      // For float24 conversion without a guest depth output, convert pixel-center
+      // FragCoord.z without forcing sample-rate shader execution.
+      uint32_t float24_depth_pixel_rate : 1;
     } pixel;
     uint64_t value = 0;
 
@@ -436,7 +439,8 @@ class SpirvShaderTranslator : public ShaderTranslator {
   // state of the translator.
   std::vector<uint8_t> CreateDepthOnlyFragmentShader(
       Modification::DepthStencilMode depth_stencil_mode =
-          Modification::DepthStencilMode::kNoModifiers);
+          Modification::DepthStencilMode::kNoModifiers,
+      bool float24_depth_pixel_rate = false);
 
   // Common functions useful not only for the translator, but also for EDRAM
   // emulation via conventional render targets.
@@ -552,7 +556,8 @@ class SpirvShaderTranslator : public ShaderTranslator {
   }
   bool IsSampleRate() const {
     assert_true(is_pixel_shader());
-    return IsWritingFloat24Depth() && !current_shader().writes_depth();
+    return IsWritingFloat24Depth() && !current_shader().writes_depth() &&
+           !GetSpirvShaderModification().pixel.float24_depth_pixel_rate;
   }
 
   uint32_t GetModificationInterpolatorMask() const {
diff --git a/include/rex/graphics/vulkan/pipeline_cache.h b/include/rex/graphics/vulkan/pipeline_cache.h
index 7b938b9..1e1cbf1 100644
--- a/include/rex/graphics/vulkan/pipeline_cache.h
+++ b/include/rex/graphics/vulkan/pipeline_cache.h
@@ -196,12 +196,13 @@ class VulkanPipelineCache {
     xenos::StencilOp stencil_back_depth_fail_op : 3;     // 6
     xenos::CompareFunction stencil_back_compare_op : 3;  // 9
     uint32_t sample_rate_shading : 1;                    // 10
+    uint32_t float24_depth_pixel_rate : 1;               // 11
 
     // Filled only for the attachments present in the render pass object.
     PipelineRenderTarget render_targets[xenos::kMaxColorRenderTargets];
 
     // Including all the padding, for a stable hash.
-    static constexpr uint32_t kVersion = 0x20260228;
+    static constexpr uint32_t kVersion = 0x20260926;
     PipelineDescription() {
       Reset();
     }
diff --git a/src/graphics/pipeline/shader/spirv_translator.cpp b/src/graphics/pipeline/shader/spirv_translator.cpp
index c709705..223b7c9 100644
--- a/src/graphics/pipeline/shader/spirv_translator.cpp
+++ b/src/graphics/pipeline/shader/spirv_translator.cpp
@@ -90,7 +90,7 @@ uint64_t SpirvShaderTranslator::GetDefaultPixelShaderModification(
 }
 
 std::vector<uint8_t> SpirvShaderTranslator::CreateDepthOnlyFragmentShader(
-    Modification::DepthStencilMode depth_stencil_mode) {
+    Modification::DepthStencilMode depth_stencil_mode, bool float24_depth_pixel_rate) {
   is_depth_only_fragment_shader_ = true;
   // TODO(Triang3l): Handle in a nicer way (is_depth_only_fragment_shader_ is a
   // leftover from when a Shader object wasn't used during translation).
@@ -99,6 +99,7 @@ std::vector<uint8_t> SpirvShaderTranslator::CreateDepthOnlyFragmentShader(
   shader.AnalyzeUcode(instruction_disassembly_buffer);
   Modification modification(GetDefaultPixelShaderModification(0));
   modification.pixel.depth_stencil_mode = depth_stencil_mode;
+  modification.pixel.float24_depth_pixel_rate = uint32_t(float24_depth_pixel_rate);
   Shader::Translation& translation = *shader.GetOrCreateTranslation(modification.value);
   TranslateAnalyzedShader(translation);
   is_depth_only_fragment_shader_ = false;
@@ -1108,7 +1109,8 @@ std::vector<uint8_t> SpirvShaderTranslator::CompleteTranslation() {
       builder_->addExecutionMode(function_main_, spv::ExecutionModeDepthReplacing);
       if (!current_shader().writes_depth() &&
           GetSpirvShaderModification().pixel.depth_stencil_mode ==
-              Modification::DepthStencilMode::kFloat24Truncating) {
+              Modification::DepthStencilMode::kFloat24Truncating &&
+          !GetSpirvShaderModification().pixel.float24_depth_pixel_rate) {
         builder_->addExecutionMode(function_main_, spv::ExecutionModeDepthLess);
       }
     }
diff --git a/src/graphics/pipeline/shader/spirv_translator_rb.cpp b/src/graphics/pipeline/shader/spirv_translator_rb.cpp
index 765c141..43144ba 100644
--- a/src/graphics/pipeline/shader/spirv_translator_rb.cpp
+++ b/src/graphics/pipeline/shader/spirv_translator_rb.cpp
@@ -1389,6 +1389,8 @@ void SpirvShaderTranslator::CompleteFragmentShaderInMain() {
           assert_true(input_sample_id_ != spv::NoResult);
           builder_->createLoad(input_sample_id_, spv::NoPrecision);
         }
+        // Without IsSampleRate(), this reads pixel-center FragCoord.z and does
+        // not introduce a gl_SampleID-driven sample interpolation.
         depth = builder_->createTriBuiltinCall(
             type_float_, ext_inst_glsl_std_450_, GLSLstd450NClamp,
             builder_->createNoContractionBinOp(spv::OpFMul, type_float_, depth,
diff --git a/src/graphics/vulkan/pipeline_cache.cpp b/src/graphics/vulkan/pipeline_cache.cpp
index 92eb966..e2fdd64 100644
--- a/src/graphics/vulkan/pipeline_cache.cpp
+++ b/src/graphics/vulkan/pipeline_cache.cpp
@@ -60,6 +60,10 @@ REXCVAR_DEFINE_BOOL(vulkan_tessellation_wireframe, false, "GPU/Vulkan",
                     "Render tessellation as wireframe")
     .lifecycle(rex::cvar::Lifecycle::kHotReload);
 
+REXCVAR_DEFINE_BOOL(vulkan_float24_depth_pixel_rate, false, "GPU",
+                    "Shade at pixel rate while converting float24 depth in Vulkan")
+    .lifecycle(rex::cvar::Lifecycle::kRequiresRestart);
+
 namespace rex::graphics::vulkan {
 
 namespace {
@@ -315,7 +319,8 @@ bool VulkanPipelineCache::Initialize() {
   } else {
     std::vector<uint8_t> depth_float24_truncate_fragment_shader_code =
         shader_translator_->CreateDepthOnlyFragmentShader(
-            SpirvShaderTranslator::Modification::DepthStencilMode::kFloat24Truncating);
+            SpirvShaderTranslator::Modification::DepthStencilMode::kFloat24Truncating,
+            REXCVAR_GET(vulkan_float24_depth_pixel_rate));
     depth_float24_truncate_fragment_shader_ = ui::vulkan::util::CreateShaderModule(
         vulkan_device,
         reinterpret_cast<const uint32_t*>(depth_float24_truncate_fragment_shader_code.data()),
@@ -328,7 +333,8 @@ bool VulkanPipelineCache::Initialize() {
     }
     std::vector<uint8_t> depth_float24_round_fragment_shader_code =
         shader_translator_->CreateDepthOnlyFragmentShader(
-            SpirvShaderTranslator::Modification::DepthStencilMode::kFloat24Rounding);
+            SpirvShaderTranslator::Modification::DepthStencilMode::kFloat24Rounding,
+            REXCVAR_GET(vulkan_float24_depth_pixel_rate));
     depth_float24_round_fragment_shader_ = ui::vulkan::util::CreateShaderModule(
         vulkan_device,
         reinterpret_cast<const uint32_t*>(depth_float24_round_fragment_shader_code.data()),
@@ -1017,6 +1023,8 @@ SpirvShaderTranslator::Modification VulkanPipelineCache::GetCurrentPixelShaderMo
       modification.pixel.depth_stencil_mode = render_target_cache_.depth_float24_round()
                                                   ? DepthStencilMode::kFloat24Rounding
                                                   : DepthStencilMode::kFloat24Truncating;
+      modification.pixel.float24_depth_pixel_rate =
+          uint32_t(REXCVAR_GET(vulkan_float24_depth_pixel_rate) && !shader.writes_depth());
     } else {
       if (shader.implicit_early_z_write_allowed() &&
           (!shader.writes_color_target(0) ||
@@ -1411,8 +1419,12 @@ bool VulkanPipelineCache::GetCurrentStateDescription(
         !pixel_shader->shader().writes_depth() &&
         (pixel_shader_modification.pixel.depth_stencil_mode ==
              DepthStencilMode::kFloat24Truncating ||
-         pixel_shader_modification.pixel.depth_stencil_mode == DepthStencilMode::kFloat24Rounding);
+         pixel_shader_modification.pixel.depth_stencil_mode == DepthStencilMode::kFloat24Rounding) &&
+        !pixel_shader_modification.pixel.float24_depth_pixel_rate;
   }
+  description_out.float24_depth_pixel_rate =
+      REXCVAR_GET(vulkan_float24_depth_pixel_rate) &&
+      render_target_cache_.depth_float24_convert_in_pixel_shader();
   description_out.render_pass_key = render_pass_key;
 
   bool tessellated = primitive_processing_result.IsTessellated();
