From 0b1637673367aad9490ddc957e3d169c67ef3316 Mon Sep 17 00:00:00 2001
From: PromethenDev <PromethenDev@users.noreply.github.com>
Date: Wed, 30 Sep 2026 22:37:14 -0700
Subject: [PATCH 76/97] UI c0 remap: skip draws that sample a scene-sized
 texture (WWE13 BUG-7: dark 320x320 box at 480p)

VS 8586E774714B131B draws both UI sprites (1280x720 units) and full-screen copies/fades of the reduced scene
(fetch 0 = the 640x480 scene texture, laid out in scene units). Remapping the latter to 1280x720 units shrank the
entrance/cutscene dimming quad into the top-left 320x320 of the 640x480 frame. Owner F9 traces (780M, 480p):
box present with the remap, absent without; with this check all three box frames replay uniform and in-match
frames are pixel-identical. 480p menu-return gate PASS (menus, pause, objectives card framed).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/graphics/vulkan/command_processor.cpp | 21 ++++++++++++++++++++-
 1 file changed, 20 insertions(+), 1 deletion(-)

diff --git a/src/graphics/vulkan/command_processor.cpp b/src/graphics/vulkan/command_processor.cpp
index 364a51b..f765126 100644
--- a/src/graphics/vulkan/command_processor.cpp
+++ b/src/graphics/vulkan/command_processor.cpp
@@ -329,6 +329,24 @@ bool GetUiC0RemapTarget(const UiC0RemapConfig& config, uint64_t vertex_shader_ha
   return false;
 }
 
+// A UI-shader draw whose fetch-0 texture has exactly the reduced scene size is a full-screen
+// scene copy/fade laid out in scene units (e.g. VS 8586E774714B131B dims the 640x480 scene
+// during entrances/cutscenes). Remapping it to 1280x720 units would shrink it into the
+// top-left (WWE13 BUG-7: dark 320x320 box at 480p), so leave such draws unchanged.
+bool UiC0DrawSamplesSceneSizedTexture(const UiC0RemapConfig& config, const RegisterFile& regs) {
+  if (!config.scene_width || !config.scene_height) {
+    return false;
+  }
+  const uint32_t fetch0 = regs[XE_GPU_REG_SHADER_CONSTANT_FETCH_00_0];
+  if ((fetch0 & 3) != 2) {
+    return false;
+  }
+  const uint32_t size = regs[XE_GPU_REG_SHADER_CONSTANT_FETCH_00_0 + 2];
+  const uint32_t width = (size & 0x1FFF) + 1;
+  const uint32_t height = ((size >> 13) & 0x1FFF) + 1;
+  return width == config.scene_width && height == config.scene_height;
+}
+
 constexpr size_t kFloatConstantBytes = sizeof(float) * 4;
 
 void CopyFloatConstantMapEntry(uint8_t*& mapping, const uint32_t* regs,
@@ -4713,7 +4731,8 @@ bool VulkanCommandProcessor::IssueDraw(xenos::PrimitiveType prim_type, uint32_t
       GetUiC0RemapTarget(GetUiC0RemapConfig(), vertex_shader->ucode_data_hash(),
                          regs[XE_GPU_REG_SHADER_CONSTANT_000_X],
                          regs[XE_GPU_REG_SHADER_CONSTANT_000_X + 1], ui_c0_target_x,
-                         ui_c0_target_y);
+                         ui_c0_target_y) &&
+      !UiC0DrawSamplesSceneSizedTexture(GetUiC0RemapConfig(), regs);
 
   // Update dynamic graphics pipeline state.
   UpdateDynamicState(viewport_info, primitive_polygonal, normalized_depth_control,
