+int main() {
+  rex::Runtime runtime(std::filesystem::current_path());
+  rex::RuntimeConfig config;
+  config.tool_mode = true;
+  if (runtime.Setup(std::move(config)) != 0) {
+    std::cerr << "Runtime::Setup(tool_mode=true) failed\n";
+    return 1;
+  }
+
+  REXCVAR_SET(WWE2K14_THREAD_FREE_STACK_ON_EXIT, false);
+  auto* kernel_state = runtime.kernel_state();
+  if (!RunRetentionCase(kernel_state, false) || !RunRetentionCase(kernel_state, true) ||
+      !RunOffDestructorReleaseCase(kernel_state) || !RunTerminateAfterExitCase(kernel_state) ||
+      !RunLiveThreadCase(kernel_state) || !RunExternalTerminateCase(kernel_state) ||
+      !RunSaveRestoreAfterReclaimCase(kernel_state)) {
+    return 1;
+  }
+
+  if (!RunRuntimeShutdownCase(runtime)) {
+    return 1;
+  }
+  std::cout << "thread-stack-reclamation PASS\n";
+  return 0;
+}
