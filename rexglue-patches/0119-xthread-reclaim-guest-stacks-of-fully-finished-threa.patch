+bool RunSaveRestoreAfterReclaimCase(KernelState* kernel_state) {
+  REXCVAR_SET(WWE2K14_THREAD_FREE_STACK_ON_EXIT, true);
+
+  auto completed = rex::system::object_ref<ImmediateExitThread>(
+      new ImmediateExitThread(kernel_state, 0xCA31));
+  if (completed->Create() != 0 || !WaitForGuestThread(completed.get())) {
+    std::cerr << "save/restore test thread did not finish\n";
+    return false;
+  }
+  auto trigger = rex::system::object_ref<ImmediateExitThread>(
+      new ImmediateExitThread(kernel_state, 0xCA32));
+  const auto trigger_create_status = trigger->Create();
+  const uint32_t completed_stack_after_create = completed->stack_base_for_test();
+  const bool trigger_waited = trigger_create_status == 0 && WaitForGuestThread(trigger.get());
+  const bool metadata_zero = completed->guest_stack_metadata_zero_for_test();
+  if (trigger_create_status != 0 || completed_stack_after_create != 0 || !trigger_waited ||
+      !metadata_zero) {
+    std::cerr << "save/restore reclaim mismatch: create_status=" << trigger_create_status
+              << " completed_stack=" << completed_stack_after_create
+              << " trigger_waited=" << trigger_waited << " guest_metadata_zero=" << metadata_zero
+              << '\n';
+    return false;
+  }
+
+  std::vector<uint8_t> saved_data(64 * 1024);
+  rex::stream::ByteStream save_stream(saved_data.data(), saved_data.size());
+  if (!completed->Save(&save_stream)) {
+    std::cerr << "reclaimed thread Save failed\n";
+    return false;
+  }
+
+  size_t state_offset = 0;
+  uint32_t saved_guest_object = 0;
+  SavedThreadStatePrefix saved_state{};
+  const bool saved_state_read =
+      ReadSavedThread(&saved_data, &state_offset, &saved_guest_object, &saved_state);
+  if (!saved_state_read || saved_state.is_running || saved_state.stack_base ||
+      saved_state.stack_limit || saved_state.stack_alloc_base || saved_state.stack_alloc_size) {
+    std::cerr << "reclaimed thread Save did not serialize a zero-stack completed state"
+              << " parsed=" << saved_state_read << " running=" << saved_state.is_running
+              << " stack_base=" << saved_state.stack_base
+              << " stack_limit=" << saved_state.stack_limit
+              << " stack_alloc_base=" << saved_state.stack_alloc_base
+              << " stack_alloc_size=" << saved_state.stack_alloc_size
+              << " state_offset=" << state_offset << '\n';
+    return false;
+  }
+
+  // Clone the guest allocations named by the saved record so the restored
+  // object can be tested independently after its source object is destroyed.
+  if (!MakeIndependentRestoreRecord(kernel_state, &saved_data, state_offset,
+                                    saved_guest_object, &saved_state)) {
+    std::cerr << "could not prepare isolated reclaimed-thread restore record\n";
+    return false;
+  }
+  auto invalid_data = saved_data;
+  auto invalid_state = saved_state;
+  if (!MakeIndependentRestoreRecord(kernel_state, &invalid_data, state_offset,
+                                    saved_guest_object, &invalid_state)) {
+    std::cerr << "could not prepare isolated invalid running-thread restore record\n";
+    return false;
+  }
+  invalid_state.is_running = true;
+  std::memcpy(invalid_data.data() + state_offset, &invalid_state, sizeof(invalid_state));
+
+  const uint32_t completed_handle = completed->handle();
+  if (kernel_state->object_table()->ReleaseHandle(completed_handle) != 0) {
+    std::cerr << "failed to close source thread handle before restore\n";
+    return false;
+  }
+  completed.reset();
+
+  rex::stream::ByteStream restore_stream(saved_data.data(), saved_data.size());
+  auto restored = XThread::Restore(kernel_state, &restore_stream);
+  const uint32_t restored_guest_object = ReadAt<uint32_t>(saved_data, 4);
+  if (!restored || restored->handle() != completed_handle ||
+      !GuestStackMetadataZero(kernel_state, restored_guest_object, saved_state.pcr_address)) {
+    std::cerr << "reclaimed thread Restore did not preserve zero-stack semantics\n";
+    return false;
+  }
+
+  std::vector<uint8_t> restored_data(64 * 1024);
+  rex::stream::ByteStream restored_save_stream(restored_data.data(), restored_data.size());
+  size_t restored_state_offset = 0;
+  uint32_t restored_save_guest_object = 0;
+  SavedThreadStatePrefix restored_state{};
+  if (!restored->Save(&restored_save_stream) ||
+      !ReadSavedThread(&restored_data, &restored_state_offset, &restored_save_guest_object,
+                       &restored_state) ||
+      restored_state.is_running ||
+      restored_state.stack_base || restored_state.stack_limit ||
+      restored_state.stack_alloc_base || restored_state.stack_alloc_size ||
+      !GuestStackMetadataZero(kernel_state, restored_save_guest_object,
+                              restored_state.pcr_address)) {
+    std::cerr << "restored completed thread did not retain zero stack metadata\n";
+    return false;
+  }
+
+  if (kernel_state->object_table()->ReleaseHandle(restored->handle()) != 0 ||
+      kernel_state->object_table()->ReleaseHandle(trigger->handle()) != 0) {
+    std::cerr << "failed to close save/restore regression handles\n";
+    return false;
+  }
+  restored.reset();
+  trigger.reset();
+  rex::stream::ByteStream invalid_restore_stream(invalid_data.data(), invalid_data.size());
+  if (XThread::Restore(kernel_state, &invalid_restore_stream)) {
+    std::cerr << "Restore accepted an is_running zero-stack record\n";
+    return false;
+  }
+  std::cout << "thread-stack-reclamation save_restore_reclaimed_stack=zero "
+               "guest_kthread_pcr=zero zero_stack_running_restore_rejected=1\n";
+  return true;
+}
+
+bool RunExternalTerminateCase(KernelState* kernel_state) {
+  REXCVAR_SET(WWE2K14_THREAD_FREE_STACK_ON_EXIT, true);
+  auto* stack_heap = kernel_state->memory()->LookupHeap(XThread::kStackAddressRangeBegin);
+  if (!stack_heap) {
+    std::cerr << "external-terminate stack arena lookup failed\n";
+    return false;
+  }
+
+  auto terminated = rex::system::object_ref<BlockingThread>(new BlockingThread(kernel_state));
+  if (terminated->Create() != 0) {
+    std::cerr << "external-terminate test thread create failed\n";
+    return false;
+  }
+  const auto started_deadline = std::chrono::steady_clock::now() + kWaitTimeout;
+  while (!terminated->started() && std::chrono::steady_clock::now() < started_deadline) {
+    std::this_thread::yield();
+  }
+  const uint32_t original_stack = terminated->stack_base_for_test();
+  const uint32_t original_stack_size = terminated->stack_size_for_test();
+  if (!terminated->started() || !original_stack ||
+      terminated->Terminate(0xCA41) != 0 || !terminated->external_termination_for_test() ||
+      !WaitForHostCompletion(terminated.get())) {
+    std::cerr << "external termination was not marked and joined within the test bound\n";
+    return false;
+  }
+
+  auto trigger = rex::system::object_ref<ImmediateExitThread>(
+      new ImmediateExitThread(kernel_state, 0xCA42));
+  if (trigger->Create() != 0 || !WaitForGuestThread(trigger.get()) ||
+      terminated->stack_base_for_test() != original_stack) {
+    std::cerr << "next Create reclaimed the externally terminated thread stack\n";
+    return false;
+  }
+
+  if (kernel_state->object_table()->ReleaseHandle(terminated->handle()) != 0 ||
+      kernel_state->object_table()->ReleaseHandle(trigger->handle()) != 0) {
+    std::cerr << "failed to close external-terminate regression handles\n";
+    return false;
+  }
+  terminated.reset();
+  trigger.reset();
+  rex::memory::HeapAllocationInfo retained_stack_info{};
+  const bool quarantined_stack_retained =
+      stack_heap->QueryRegionInfo(original_stack, &retained_stack_info) &&
+      retained_stack_info.allocation_base == original_stack &&
+      retained_stack_info.allocation_size == original_stack_size && retained_stack_info.state;
+  if (!quarantined_stack_retained) {
+    std::cerr << "external-terminate destructor released the quarantined guest stack\n";
+    return false;
+  }
+  std::cout << "thread-stack-reclamation external_terminate_stack_retained=1 "
+               "next_create_completed=1 destructor_stack_still_allocated=1\n";
+  return true;
+}
+
+bool RunLiveThreadCase(KernelState* kernel_state) {
+  REXCVAR_SET(WWE2K14_THREAD_FREE_STACK_ON_EXIT, true);
+
+  auto blocked = rex::system::object_ref<BlockingThread>(new BlockingThread(kernel_state));
+  if (blocked->Create() != 0) {
+    std::cerr << "blocking thread create failed\n";
+    return false;
+  }
+  const auto started_deadline = std::chrono::steady_clock::now() + kWaitTimeout;
+  while (!blocked->started() && std::chrono::steady_clock::now() < started_deadline) {
+    std::this_thread::yield();
+  }
+  if (!blocked->started()) {
+    std::cerr << "blocking thread did not enter Execute\n";
+    return false;
+  }
+  const uint32_t original_stack = blocked->stack_base_for_test();
+
+  auto completed = rex::system::object_ref<ImmediateExitThread>(
+      new ImmediateExitThread(kernel_state, 0xCA11));
+  if (completed->Create() != 0 || !WaitForGuestThread(completed.get()) ||
+      blocked->stack_base_for_test() != original_stack || !original_stack) {
+    std::cerr << "a still-running thread's stack was reclaimed\n";
+    return false;
+  }
+
+  blocked->Release();
+  if (!WaitForGuestThread(blocked.get())) {
+    std::cerr << "released blocking thread did not finish\n";
+    return false;
+  }
+  auto trigger = rex::system::object_ref<ImmediateExitThread>(
+      new ImmediateExitThread(kernel_state, 0xCA12));
+  if (trigger->Create() != 0 || blocked->stack_base_for_test() != 0 ||
+      !WaitForGuestThread(trigger.get()) || !blocked->guest_stack_metadata_zero_for_test()) {
+    std::cerr << "finished blocking thread was not reclaimed on the next create\n";
+    return false;
+  }
+
+  std::cout << "thread-stack-reclamation running_not_reclaimed=1 completed_reclaimed=1\n";
+  const bool handles_released =
+      kernel_state->object_table()->ReleaseHandle(blocked->handle()) == 0 &&
+      kernel_state->object_table()->ReleaseHandle(completed->handle()) == 0 &&
+      kernel_state->object_table()->ReleaseHandle(trigger->handle()) == 0;
+  return handles_released;
+}
+
+bool RunRuntimeShutdownCase(rex::Runtime& runtime) {
+  auto* kernel_state = runtime.kernel_state();
+  if (!kernel_state) {
+    std::cerr << "shutdown test has no KernelState\n";
+    return false;
+  }
+  REXCVAR_SET(WWE2K14_THREAD_FREE_STACK_ON_EXIT, true);
+
+  auto exited = rex::system::object_ref<ImmediateExitThread>(
+      new ImmediateExitThread(kernel_state, 0xCA21));
+  if (exited->Create() != 0 || !WaitForGuestThread(exited.get())) {
+    std::cerr << "shutdown test initial thread did not finish\n";
+    return false;
+  }
+  auto trigger = rex::system::object_ref<ImmediateExitThread>(
+      new ImmediateExitThread(kernel_state, 0xCA22));
+  if (trigger->Create() != 0 || exited->stack_base_for_test() != 0 ||
+      !WaitForGuestThread(trigger.get())) {
+    std::cerr << "shutdown test failed to reclaim a completed stack\n";
+    return false;
+  }
+
+  // Keep both handles in the object table, but drop local references. KernelState
+  // resets those handles before Runtime releases guest Memory.
+  exited.reset();
+  trigger.reset();
+  runtime.Shutdown();
+  if (runtime.kernel_state() || runtime.memory()) {
+    std::cerr << "Runtime::Shutdown left KernelState or Memory alive\n";
+    return false;
+  }
+  std::cout << "thread-stack-reclamation runtime_shutdown reclaimed_stack=1 handles_reset=1\n";
+  return true;
+}
