+bool RunRetentionCase(KernelState* kernel_state, bool enabled) {
+  REXCVAR_SET(WWE2K14_THREAD_FREE_STACK_ON_EXIT, enabled);
+  const auto* stack_heap = kernel_state->memory()->LookupHeap(XThread::kStackAddressRangeBegin);
+  if (!stack_heap) {
+    std::cerr << "stack arena lookup failed\n";
+    return false;
+  }
+  const uint32_t page_size = stack_heap->page_size();
+  const uint32_t rounded_stack =
+      ((kGuestStackRequest + page_size - 1) / page_size) * page_size;
+  const uint64_t bytes_per_stack = rounded_stack + 2 * page_size;
+
+  std::vector<rex::system::object_ref<ImmediateExitThread>> threads;
+  threads.reserve(kThreadCount);
+  for (uint32_t i = 0; i < kThreadCount; ++i) {
+    auto thread = rex::system::object_ref<ImmediateExitThread>(
+        new ImmediateExitThread(kernel_state, static_cast<int32_t>(0xCA00 + i)));
+    if (thread->Create() != 0 ||
+        (enabled ? !WaitForExitStarted(thread.get()) : !WaitForGuestThread(thread.get()))) {
+      std::cerr << "thread creation or completion barrier failed at index " << i << '\n';
+      return false;
+    }
+    if (!enabled && thread->guest_object<rex::system::X_KTHREAD>()->exit_status != 0xCA00 + i) {
+      std::cerr << "guest exit status changed before stack reclamation\n";
+      return false;
+    }
+    threads.push_back(std::move(thread));
+  }
+
+  uint64_t bytes_after_batch = 0;
+  const uint32_t held_after_batch = CountHeldStacks(threads, &bytes_after_batch);
+  const bool batch_measurement_ok =
+      enabled ? held_after_batch <= kThreadCount
+              : held_after_batch == kThreadCount &&
+                    bytes_after_batch == uint64_t(kThreadCount) * bytes_per_stack;
+  if (!batch_measurement_ok || bytes_after_batch != uint64_t(held_after_batch) * bytes_per_stack) {
+    std::cerr << "stack retention mismatch: option=" << (enabled ? "on" : "off")
+              << " held=" << held_after_batch << " bytes=" << bytes_after_batch
+              << " expected_per_stack=" << bytes_per_stack << '\n';
+    return false;
+  }
+
+  std::vector<rex::system::object_ref<ImmediateExitThread>> trigger_threads;
+  uint32_t held_after_trigger = held_after_batch;
+  uint64_t bytes_after_trigger = 0;
+  const auto reclaim_deadline = std::chrono::steady_clock::now() + kWaitTimeout;
+  do {
+    auto trigger = rex::system::object_ref<ImmediateExitThread>(
+        new ImmediateExitThread(kernel_state, 0xCAFE));
+    if (trigger->Create() != 0) {
+      std::cerr << "trigger thread create failed\n";
+      return false;
+    }
+    trigger_threads.push_back(std::move(trigger));
+    if (!WaitForGuestThread(trigger_threads.back().get())) {
+      std::cerr << "trigger thread failed to finish\n";
+      return false;
+    }
+    held_after_trigger = CountHeldStacks(threads, &bytes_after_trigger);
+  } while (enabled && held_after_trigger != 0 &&
+           std::chrono::steady_clock::now() < reclaim_deadline);
+
+  const uint32_t expected_after_trigger = enabled ? 0 : kThreadCount;
+  if (held_after_trigger != expected_after_trigger ||
+      bytes_after_trigger != uint64_t(expected_after_trigger) * bytes_per_stack) {
+    std::cerr << "next-create reclaim mismatch: option=" << (enabled ? "on" : "off")
+              << " held=" << held_after_trigger << " bytes=" << bytes_after_trigger << '\n';
+    return false;
+  }
+  for (uint32_t i = 0; i < threads.size(); ++i) {
+    if (threads[i]->guest_object<rex::system::X_KTHREAD>()->exit_status != 0xCA00 + i) {
+      std::cerr << "guest exit status changed after stack reclamation\n";
+      return false;
+    }
+    if (enabled && !threads[i]->guest_stack_metadata_zero_for_test()) {
+      std::cerr << "guest KTHREAD/PCR stack metadata remained after reclamation\n";
+      return false;
+    }
+  }
+
+  std::cout << "thread-stack-reclamation option=" << (enabled ? "on" : "off")
+            << " completed=" << kThreadCount << " after_batch_held=" << held_after_batch
+            << " after_batch_bytes=" << bytes_after_batch
+            << " after_next_create_held=" << held_after_trigger
+            << " after_next_create_bytes=" << bytes_after_trigger << '\n';
+
+  return ReleaseHandles(kernel_state, threads) && ReleaseHandles(kernel_state, trigger_threads);
+}
+
+bool RunOffDestructorReleaseCase(KernelState* kernel_state) {
+  REXCVAR_SET(WWE2K14_THREAD_FREE_STACK_ON_EXIT, false);
+
+  auto destructor_observed = std::make_shared<std::atomic<bool>>(false);
+  auto completed = rex::system::object_ref<ImmediateExitThread>(
+      new ImmediateExitThread(kernel_state, 0xCA51, destructor_observed));
+  // The guest wait is signaled by XThread exit before the native Windows thread
+  // handle is signaled. Wait for native completion too before testing destructor
+  // release/reuse; closing that handle in XThread::~XThread does not join it.
+  if (completed->Create() != 0 || !WaitForGuestThread(completed.get()) ||
+      !WaitForHostCompletion(completed.get())) {
+    std::cerr << "OFF-mode destructor test thread did not finish\n";
+    return false;
+  }
+  const uint32_t released_stack = completed->stack_base_for_test();
+  const uint32_t released_stack_size = completed->stack_size_for_test();
+  auto* stack_heap = kernel_state->memory()->LookupHeap(XThread::kStackAddressRangeBegin);
+  rex::memory::HeapAllocationInfo stack_info{};
+  if (!released_stack || !released_stack_size || !stack_heap ||
+      !stack_heap->QueryRegionInfo(released_stack, &stack_info) ||
+      stack_info.allocation_base != released_stack ||
+      stack_info.allocation_size != released_stack_size || !stack_info.state ||
+      kernel_state->object_table()->ReleaseHandle(completed->handle()) != 0) {
+    std::cerr << "OFF-mode destructor test could not release its thread handle\n";
+    return false;
+  }
+  // Keep a raw pointer only to drop the reference leaked by Windows ExitThread;
+  // it is dereferenced only after the shared flag proves ~XThread has not run.
+  ImmediateExitThread* completed_raw = completed.get();
+  completed.reset();
+
+  // XThread::Exit holds `auto self = retain_object(this)` and then calls
+  // rex::thread::Thread::Exit, which never returns. On POSIX that is
+  // pthread_exit, whose forced unwind runs the `self` destructor, so the reset
+  // above drops the last reference and ~XThread runs synchronously. On Windows
+  // it is ExitThread, which runs no C++ destructors, so `self` leaks exactly one
+  // pointer reference (base and lane alike) and ~XThread cannot run here. The
+  // test drops that one leaked reference itself to exercise the OFF destructor.
+  uint32_t leaked_self_refs = 0;
+  if (!destructor_observed->load(std::memory_order_acquire)) {
+#if REX_PLATFORM_WIN32
+    leaked_self_refs = 1;
+    completed_raw->Release();
+#else
+    std::cerr << "OFF-mode XThread destructor did not run after completed.reset()\n";
+    return false;
+#endif
+  }
+  completed_raw = nullptr;
+
+  // ~XThread runs synchronously inside the final Release; no waiting is needed.
+  rex::memory::HeapAllocationInfo released_info{};
+  if (!destructor_observed->load(std::memory_order_acquire)) {
+    std::cerr << "OFF-mode XThread destructor did not run after its last reference was dropped"
+              << " leaked_self_refs=" << leaked_self_refs << '\n';
+    return false;
+  }
+  if (!stack_heap->QueryRegionInfo(released_stack, &released_info) || released_info.state) {
+    std::cerr << "OFF-mode XThread destructor did not release the guest stack"
+              << " region_state=" << released_info.state << '\n';
+    return false;
+  }
+
+  auto replacement = rex::system::object_ref<ImmediateExitThread>(
+      new ImmediateExitThread(kernel_state, 0xCA52));
+  if (replacement->Create() != 0 || !WaitForGuestThread(replacement.get())) {
+    std::cerr << "OFF-mode replacement thread did not complete after stack release\n";
+    return false;
+  }
+  if (kernel_state->object_table()->ReleaseHandle(replacement->handle()) != 0) {
+    std::cerr << "OFF-mode destructor test could not release its replacement handle\n";
+    return false;
+  }
+  replacement.reset();
+  std::cout << "thread-stack-reclamation option=off_destructor destructor_observed=1 "
+               "stack_released=1 exit_path_leaked_self_refs="
+            << leaked_self_refs << '\n';
+  return true;
+}
+
+bool RunTerminateAfterExitCase(KernelState* kernel_state) {
+  REXCVAR_SET(WWE2K14_THREAD_FREE_STACK_ON_EXIT, true);
+
+  auto completed = rex::system::object_ref<ImmediateExitThread>(
+      new ImmediateExitThread(kernel_state, 0xCA53));
+  if (completed->Create() != 0 || !WaitForGuestThread(completed.get())) {
+    std::cerr << "terminate-after-exit test thread did not finish\n";
+    return false;
+  }
+  const uint32_t released_stack = completed->stack_base_for_test();
+  if (!released_stack || completed->Terminate(0xCA54) != 0 ||
+      completed->external_termination_for_test()) {
+    std::cerr << "terminate-after-exit was incorrectly marked as cancelled\n";
+    return false;
+  }
+  // On Windows the reset does not destroy the object (ExitThread leaks the
+  // Exit() self reference), so the next Create's sweep must free the stack.
+  completed.reset();
+
+  auto* stack_heap = kernel_state->memory()->LookupHeap(XThread::kStackAddressRangeBegin);
+  auto replacement = rex::system::object_ref<ImmediateExitThread>(
+      new ImmediateExitThread(kernel_state, 0xCA55));
+  rex::memory::HeapAllocationInfo released_info{};
+  const bool replacement_created = replacement->Create() == 0;
+  const bool released_or_reused =
+      replacement_created && stack_heap &&
+      (replacement->stack_base_for_test() == released_stack ||
+       (stack_heap->QueryRegionInfo(released_stack, &released_info) && !released_info.state));
+  if (!released_or_reused || !WaitForGuestThread(replacement.get())) {
+    std::cerr << "terminate-after-exit completed stack was neither released nor reused"
+              << " region_state=" << released_info.state << '\n';
+    return false;
+  }
+  if (kernel_state->object_table()->ReleaseHandle(replacement->handle()) != 0) {
+    std::cerr << "terminate-after-exit test could not release its replacement handle\n";
+    return false;
+  }
+  replacement.reset();
+  std::cout << "thread-stack-reclamation terminate_after_exit_cancel_issued=0 stack_released=1\n";
+  return true;
+}
