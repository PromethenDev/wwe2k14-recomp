+class TestThread : public XThread {
+ public:
+  explicit TestThread(KernelState* kernel_state)
+      : XThread(kernel_state, kGuestStackRequest, 0, 0, 0, 0, true) {}
+
+  uint32_t stack_base_for_test() const { return stack_alloc_base_; }
+  uint32_t stack_size_for_test() const { return stack_alloc_size_; }
+  bool external_termination_for_test() const {
+    return externally_cancelled_.load(std::memory_order_acquire);
+  }
+
+  bool guest_stack_metadata_zero_for_test() {
+    auto* kthread = guest_object<rex::system::X_KTHREAD>();
+    auto* pcr = memory()->TranslateVirtual<rex::system::X_KPCR*>(pcr_address_);
+    return !kthread->stack_base && !kthread->stack_limit && !kthread->stack_kernel &&
+           !kthread->stack_alloc_base && !pcr->stack_base_ptr && !pcr->stack_end_ptr;
+  }
+};
