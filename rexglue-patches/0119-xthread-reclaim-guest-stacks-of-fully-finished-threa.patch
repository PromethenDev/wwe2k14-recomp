+struct SavedThreadStatePrefix {
+  uint32_t thread_id;
+  bool is_main_thread;
+  bool is_running;
+  uint32_t apc_head;
+  uint32_t tls_static_address;
+  uint32_t tls_dynamic_address;
+  uint32_t tls_total_size;
+  uint32_t pcr_address;
+  uint32_t stack_base;
+  uint32_t stack_limit;
+  uint32_t stack_alloc_base;
+  uint32_t stack_alloc_size;
+};
+
+static_assert(offsetof(SavedThreadStatePrefix, pcr_address) == 24);
+static_assert(offsetof(SavedThreadStatePrefix, stack_base) == 28);
+
+constexpr uint32_t kThreadCount = 24;
+constexpr uint32_t kGuestStackRequest = 16 * 1024;
+constexpr auto kWaitTimeout = std::chrono::seconds(5);
+constexpr uint64_t kGuestWaitTimeoutTicks = uint64_t(-50000000ll);
+constexpr uint32_t kPcrSize = 0x2D8;
