+class ImmediateExitThread final : public TestThread {
+ public:
+  ImmediateExitThread(KernelState* kernel_state, int32_t exit_code,
+                      std::shared_ptr<std::atomic<bool>> destructor_observed = nullptr)
+      : TestThread(kernel_state), exit_code_(exit_code),
+        destructor_observed_(destructor_observed) {}
+
+  ~ImmediateExitThread() override {
+    if (destructor_observed_) {
+      destructor_observed_->store(true, std::memory_order_release);
+    }
+  }
+
+  void Execute() override {
+    exit_started_.store(true, std::memory_order_release);
+    Exit(exit_code_);
+  }
+
+  bool exit_started() const { return exit_started_.load(std::memory_order_acquire); }
+
+ private:
+  std::atomic<bool> exit_started_{false};
+  int32_t exit_code_;
+  std::shared_ptr<std::atomic<bool>> destructor_observed_;
+};
+
+class BlockingThread final : public TestThread {
+ public:
+  explicit BlockingThread(KernelState* kernel_state) : TestThread(kernel_state) {}
+
+  void Execute() override {
+    started_.store(true, std::memory_order_release);
+    while (!release_.load(std::memory_order_acquire)) {
+      std::this_thread::yield();
+    }
+    Exit(0xB10C);
+  }
+
+  bool started() const { return started_.load(std::memory_order_acquire); }
+  void Release() { release_.store(true, std::memory_order_release); }
+
+ private:
+  std::atomic<bool> started_{false};
+  std::atomic<bool> release_{false};
+};
+
+bool WaitForGuestThread(XThread* thread) {
+  uint64_t timeout_ticks = kGuestWaitTimeoutTicks;
+  return thread->Wait(0, 0, 0, &timeout_ticks) == 0;
+}
+
+bool WaitForExitStarted(const ImmediateExitThread* thread) {
+  const auto deadline = std::chrono::steady_clock::now() + kWaitTimeout;
+  while (!thread->exit_started() && std::chrono::steady_clock::now() < deadline) {
+    std::this_thread::yield();
+  }
+  return thread->exit_started();
+}
+
+bool WaitForHostCompletion(XThread* thread) {
+  const auto deadline = std::chrono::steady_clock::now() + kWaitTimeout;
+  while (std::chrono::steady_clock::now() < deadline) {
+    auto* host_thread = thread->thread();
+    if (host_thread && host_thread->TryJoinIfSignaledAndComplete()) {
+      return true;
+    }
+    std::this_thread::yield();
+  }
+  return false;
+}
