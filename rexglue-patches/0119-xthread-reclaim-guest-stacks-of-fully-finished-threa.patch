+template <typename T>
+T ReadAt(const std::vector<uint8_t>& data, size_t offset) {
+  T value{};
+  if (offset + sizeof(value) <= data.size()) {
+    std::memcpy(&value, data.data() + offset, sizeof(value));
+  }
+  return value;
+}
+
+template <typename T>
+bool WriteAt(std::vector<uint8_t>* data, size_t offset, T value) {
+  if (!data || offset + sizeof(value) > data->size()) {
+    return false;
+  }
+  std::memcpy(data->data() + offset, &value, sizeof(value));
+  return true;
+}
+
+bool ReadSavedThread(std::vector<uint8_t>* data, size_t* state_offset,
+                     uint32_t* guest_object_address, SavedThreadStatePrefix* state) {
+  if (!data || !state_offset || !guest_object_address || !state || data->size() < 20) {
+    return false;
+  }
+  const uint32_t handle_count = ReadAt<uint32_t>(*data, 8);
+  size_t offset = 12 + size_t(handle_count) * sizeof(uint32_t);
+  if (ReadAt<uint32_t>(*data, offset) != rex::system::kThreadSaveSignature) {
+    return false;
+  }
+  offset += sizeof(uint32_t);
+  const uint32_t name_size = ReadAt<uint32_t>(*data, offset);
+  offset += sizeof(uint32_t) + name_size;
+  if (offset + sizeof(*state) > data->size()) {
+    return false;
+  }
+  *guest_object_address = ReadAt<uint32_t>(*data, 4);
+  std::memcpy(state, data->data() + offset, sizeof(*state));
+  *state_offset = offset;
+  return *guest_object_address != 0;
+}
+
+bool MakeIndependentRestoreRecord(KernelState* kernel_state, std::vector<uint8_t>* data,
+                                  size_t state_offset, uint32_t source_guest_object,
+                                  SavedThreadStatePrefix* state) {
+  auto* memory = kernel_state->memory();
+  uint32_t object_allocation = 0;
+  uint32_t tls_allocation = 0;
+  uint32_t pcr_allocation = 0;
+  const uint32_t object_allocation_size = sizeof(rex::system::X_OBJECT_HEADER) +
+                                         sizeof(rex::system::X_KTHREAD);
+
+  object_allocation = memory->SystemHeapAlloc(object_allocation_size);
+  if (!object_allocation) {
+    return false;
+  }
+  memory->Copy(object_allocation, source_guest_object - sizeof(rex::system::X_OBJECT_HEADER),
+               object_allocation_size);
+  const uint32_t guest_object_address = object_allocation + sizeof(rex::system::X_OBJECT_HEADER);
+  auto* object_header = memory->TranslateVirtual<rex::system::X_OBJECT_HEADER*>(object_allocation);
+  // Restore does not consult the type object; leave ownership of the source's
+  // type allocation with the source object and avoid sharing it with the clone.
+  object_header->object_type_ptr = 0;
+
+  if (!state->tls_static_address || !state->tls_total_size || !state->pcr_address ||
+      state->tls_dynamic_address < state->tls_static_address ||
+      state->tls_dynamic_address - state->tls_static_address >= state->tls_total_size) {
+    memory->SystemHeapFree(object_allocation);
+    return false;
+  }
+  tls_allocation = memory->SystemHeapAlloc(state->tls_total_size);
+  pcr_allocation = memory->SystemHeapAlloc(kPcrSize);
+  if (!tls_allocation || !pcr_allocation) {
+    memory->SystemHeapFree(object_allocation);
+    memory->SystemHeapFree(tls_allocation);
+    memory->SystemHeapFree(pcr_allocation);
+    return false;
+  }
+  memory->Copy(tls_allocation, state->tls_static_address, state->tls_total_size);
+  memory->Copy(pcr_allocation, state->pcr_address, kPcrSize);
+
+  const uint32_t tls_dynamic_offset = state->tls_dynamic_address - state->tls_static_address;
+  state->tls_static_address = tls_allocation;
+  state->tls_dynamic_address = tls_allocation + tls_dynamic_offset;
+  state->pcr_address = pcr_allocation;
+
+  auto* kthread = memory->TranslateVirtual<rex::system::X_KTHREAD*>(guest_object_address);
+  auto* pcr = memory->TranslateVirtual<rex::system::X_KPCR*>(pcr_allocation);
+  kthread->tls_address = state->tls_dynamic_address;
+  kthread->a_prcb_ptr = pcr_allocation + offsetof(rex::system::X_KPCR, prcb_data);
+  kthread->another_prcb_ptr = pcr_allocation + offsetof(rex::system::X_KPCR, prcb_data);
+  pcr->tls_ptr = tls_allocation;
+  pcr->pcr_ptr = pcr_allocation;
+  pcr->prcb = pcr_allocation + offsetof(rex::system::X_KPCR, prcb_data);
+  pcr->prcb_data.current_thread = guest_object_address;
+
+  if (!WriteAt(data, 4, guest_object_address)) {
+    memory->SystemHeapFree(object_allocation);
+    memory->SystemHeapFree(tls_allocation);
+    memory->SystemHeapFree(pcr_allocation);
+    return false;
+  }
+  std::memcpy(data->data() + state_offset, state, sizeof(*state));
+  return true;
+}
+
+bool GuestStackMetadataZero(KernelState* kernel_state, uint32_t guest_object_address,
+                            uint32_t pcr_address) {
+  auto* kthread = kernel_state->memory()->TranslateVirtual<rex::system::X_KTHREAD*>(
+      guest_object_address);
+  auto* pcr = kernel_state->memory()->TranslateVirtual<rex::system::X_KPCR*>(pcr_address);
+  return !kthread->stack_base && !kthread->stack_limit && !kthread->stack_kernel &&
+         !kthread->stack_alloc_base && !pcr->stack_base_ptr && !pcr->stack_end_ptr;
+}
+
+uint32_t CountHeldStacks(const std::vector<rex::system::object_ref<ImmediateExitThread>>& threads,
+                         uint64_t* bytes_out) {
+  uint32_t count = 0;
+  uint64_t bytes = 0;
+  for (const auto& thread : threads) {
+    if (thread->stack_base_for_test()) {
+      ++count;
+      bytes += thread->stack_size_for_test();
+    }
+  }
+  if (bytes_out) {
+    *bytes_out = bytes;
+  }
+  return count;
+}
+
+bool ReleaseHandles(KernelState* kernel_state,
+                    const std::vector<rex::system::object_ref<ImmediateExitThread>>& threads) {
+  for (const auto& thread : threads) {
+    if (kernel_state->object_table()->ReleaseHandle(thread->handle()) != 0) {
+      std::cerr << "failed to close completed thread handle\n";
+      return false;
+    }
+  }
+  return true;
+}
