@@ -92,6 +93,18 @@ void XObject::Retain() {
   ++pointer_ref_count_;
 }
 
+bool XObject::TryRetain() {
+  int32_t ref_count = pointer_ref_count_.load(std::memory_order_relaxed);
+  while (ref_count > 0 && ref_count < std::numeric_limits<int32_t>::max()) {
+    if (pointer_ref_count_.compare_exchange_weak(ref_count, ref_count + 1,
+                                                std::memory_order_acquire,
+                                                std::memory_order_relaxed)) {
+      return true;
+    }
+  }
+  return false;
+}
+
