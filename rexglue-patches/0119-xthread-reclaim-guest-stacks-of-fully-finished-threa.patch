+void XThread::ReclaimExitedStacks() {
+  std::unique_lock<std::mutex> reclaim_lock(xthread_stack_reclaim_mutex_, std::try_to_lock);
+  if (!reclaim_lock.owns_lock() || !kernel_state_) {
+    return;
+  }
+
+  std::vector<object_ref<XThread>> threads;
+  if (!kernel_state_->TryGetThreadsSnapshot(threads)) {
+    return;
+  }
+
+  for (const auto& candidate : threads) {
+    if (candidate.get() == this) {
+      continue;
+    }
+
+    // Serialize termination with the completion query and release. A cancelled
+    // thread may have abandoned a heap mutex, so its stack must remain reserved.
+    std::unique_lock<std::mutex> thread_lock(candidate->thread_lock_, std::try_to_lock);
+    if (!thread_lock.owns_lock() || !candidate->thread_ ||
+        candidate->externally_cancelled_.load(std::memory_order_acquire)) {
+      continue;
+    }
+
+    // This nonblocking query requires both the host signaled state and actual
+    // native completion (joined on POSIX), so a terminating/running thread is
+    // never reclaimed just because the guest dispatcher state was signaled.
+    if (candidate->thread_->TryJoinIfSignaledAndComplete()) {
+      candidate->FreeStack();
+    }
+  }
+}
