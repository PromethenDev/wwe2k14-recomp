From 2659e1eb8395468030672393b743568045b4abda Mon Sep 17 00:00:00 2001
From: PromethenDev <PromethenDev@users.noreply.github.com>
Date: Sat, 10 Oct 2026 23:51:24 -0700
Subject: [PATCH 97/97] Window close: force exit if shutdown is still running
 after close_exit_timeout_seconds (default 3, 0 = off)

TerminateTitle() hangs forever on POSIX: guest threads are suspended in the suspend
signal handler, pthread_cancel does not end them, and ObjectTable::PurgeAllObjects()
destroys XThread objects whose condition variables they still wait on
(pthread_cond_destroy blocks). gdb on WWE 2K14 rc5 (logs/close-gdb-2322): main thread
in pthread_cond_destroy <- ~PosixThread <- PurgeAllObjects <- TerminateTitle <- OnClosing,
window frozen, process alive indefinitely. Now a detached timer flushes the logs
(new rex::FlushLogging) and calls std::_Exit(0). Verified 2K14 r3-fix build: exit 3.9 s
after WM_DELETE, rc=0 (logs/close-fix-2349).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 include/rex/logging/api.h |  6 ++++++
 src/core/logging.cpp      | 10 ++++++++++
 src/ui/rex_app.cpp        | 21 +++++++++++++++++++++
 3 files changed, 37 insertions(+)

diff --git a/include/rex/logging/api.h b/include/rex/logging/api.h
index 70c5e72..343dbee 100644
--- a/include/rex/logging/api.h
+++ b/include/rex/logging/api.h
@@ -61,6 +61,12 @@ void InitLogging(const char* log_file = nullptr,
  */
 void ShutdownLogging();
 
+/**
+ * Flush all loggers without shutting the logging system down (safe to call
+ * just before a forced process exit).
+ */
+void FlushLogging();
+
 /**
  * Register a new log category at runtime.
  *
diff --git a/src/core/logging.cpp b/src/core/logging.cpp
index 32fe427..06ddcbb 100644
--- a/src/core/logging.cpp
+++ b/src/core/logging.cpp
@@ -206,6 +206,16 @@ void InitLogging(const char* log_file, spdlog::level::level_enum level) {
   InitLogging(config);
 }
 
+void FlushLogging() {
+  std::lock_guard lock(g_mutex);
+  if (!g_initialized)
+    return;
+  for (auto& entry : g_registry) {
+    if (entry.logger)
+      entry.logger->flush();
+  }
+}
+
 void ShutdownLogging() {
   std::lock_guard lock(g_mutex);
   if (!g_initialized)
diff --git a/src/ui/rex_app.cpp b/src/ui/rex_app.cpp
index b72211e..c13d462 100644
--- a/src/ui/rex_app.cpp
+++ b/src/ui/rex_app.cpp
@@ -12,6 +12,8 @@
 #include <rex/rex_app.h>
 
 #include <chrono>
+#include <cstdlib>
+#include <thread>
 
 #include <rex/cvar.h>
 #include <rex/diagnostics/freeze_logger.h>
@@ -56,6 +58,10 @@ REXCVAR_DEFINE_INT32(replay_trace_repeat, 1, "GPU",
 REXCVAR_DEFINE_STRING(replay_trace_out, "", "GPU",
                       "Output image (.ppm) for replay_trace; default: trace path + .ppm");
 REXCVAR_DEFINE_STRING(update_data_root, "", "Runtime", "Override update data path");
+REXCVAR_DEFINE_INT32(close_exit_timeout_seconds, 3, "Runtime",
+                     "After the window is closed, force the process to exit if shutdown has not "
+                     "finished within this many seconds (0 = wait forever)")
+    .range(0, 600);
 REXCVAR_DEFINE_BOOL(debug_ui, false, "UI/Debug",
                     "Enable developer overlays, hotkeys, and the Windows console")
     .lifecycle(rex::cvar::Lifecycle::kRequiresRestart);
@@ -375,6 +381,21 @@ void ReXApp::OnClosing(ui::UIEvent& e) {
   // window. Safe no-op when the logger was never started.
   rex::diagnostics::freeze_logger::Stop();
   REXLOG_INFO("[freeze-logger] disarmed at window close");
+  // TerminateTitle() can hang forever on POSIX: guest threads are suspended in
+  // the suspend signal handler, pthread_cancel does not end them, and
+  // ObjectTable::PurgeAllObjects() then destroys XThread objects whose
+  // condition variables those threads still wait on (pthread_cond_destroy
+  // blocks; gdb, logs/close-gdb-2322). The window would stay frozen and the
+  // process would keep running. The player asked to quit: if shutdown has not
+  // finished in time, flush the logs and exit.
+  if (const int timeout_s = REXCVAR_GET(close_exit_timeout_seconds); timeout_s > 0) {
+    std::thread([timeout_s] {
+      std::this_thread::sleep_for(std::chrono::seconds(timeout_s));
+      REXLOG_WARN("Shutdown still running {} s after the window closed; exiting now", timeout_s);
+      rex::FlushLogging();
+      std::_Exit(0);
+    }).detach();
+  }
   shutting_down_.store(true, std::memory_order_release);
   if (runtime_ && runtime_->kernel_state()) {
     runtime_->kernel_state()->TerminateTitle();
