From 6284452633bf549e505e6a9eb43eb5ed476b61f3 Mon Sep 17 00:00:00 2001
From: PromethenDev <PromethenDev@users.noreply.github.com>
Date: Thu, 1 Oct 2026 02:20:00 -0700
Subject: [PATCH 78/97] UI c0 remap: scene-sized-texture skip only for scenes
 smaller than 1280x720 (WWE13 1080p pause dimming)

The BUG-7 skip (0b16376) is right for the real 480p/576p modes, whose full-screen scene copies are laid out in
scene units, but the custom 1920x1080 scene keeps 1280x720 UI units: skipping the remap left a 1280x720 rectangle
of the 1080p pause background undimmed. Replays: 1080 trace 33319 now matches the pre-0b16376 image (mean abs diff
0.36 vs 8.88 before); 480 BUG-7 trace 8290 pixel-identical. Linux 1080/720/480 + Wine 1080/480 gates PASS.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/graphics/vulkan/command_processor.cpp | 16 +++++++++-------
 1 file changed, 9 insertions(+), 7 deletions(-)

diff --git a/src/graphics/vulkan/command_processor.cpp b/src/graphics/vulkan/command_processor.cpp
index f765126..18f8055 100644
--- a/src/graphics/vulkan/command_processor.cpp
+++ b/src/graphics/vulkan/command_processor.cpp
@@ -156,6 +156,9 @@ struct UiC0RemapConfig {
   size_t vertex_shader_hash_count = 0;
 };
 
+constexpr uint32_t kUiWidth = 1280;
+constexpr uint32_t kUiHeight = 720;
+
 bool DecodeUiC0SceneExtent(uint32_t c0_bits, uint32_t& extent) {
   const float c0 = std::bit_cast<float>(c0_bits);
   if (!std::isfinite(c0) || c0 <= 0.0f) {
@@ -199,8 +202,6 @@ static_assert(ScaleUiScissorBR(1024, 1024, 1280, 1024) == 1024);
 static_assert(ScaleUiScissorBR(390, 576, 720, 576) == 312);
 
 void ScaleUiScissorToScene(const UiC0RemapConfig& config, draw_util::Scissor& scissor) {
-  constexpr uint32_t kUiWidth = 1280;
-  constexpr uint32_t kUiHeight = 720;
   const uint32_t left = scissor.offset[0];
   const uint32_t top = scissor.offset[1];
   const uint32_t right = left + scissor.extent[0];
@@ -329,12 +330,13 @@ bool GetUiC0RemapTarget(const UiC0RemapConfig& config, uint64_t vertex_shader_ha
   return false;
 }
 
-// A UI-shader draw whose fetch-0 texture has exactly the reduced scene size is a full-screen
-// scene copy/fade laid out in scene units (e.g. VS 8586E774714B131B dims the 640x480 scene
-// during entrances/cutscenes). Remapping it to 1280x720 units would shrink it into the
-// top-left (WWE13 BUG-7: dark 320x320 box at 480p), so leave such draws unchanged.
+// A UI-shader draw whose fetch-0 texture has exactly the scene size is a full-screen scene
+// copy/fade. Real 480p/576p modes draw these in scene units, so leave them unchanged to avoid
+// shrinking them into the top-left (WWE13 BUG-7: dark 320x320 box at 480p). The custom 1080p
+// scene keeps 1280x720 UI units, so its scene-sized copies still need the remap.
 bool UiC0DrawSamplesSceneSizedTexture(const UiC0RemapConfig& config, const RegisterFile& regs) {
-  if (!config.scene_width || !config.scene_height) {
+  if (!config.scene_width || !config.scene_height ||
+      (config.scene_width >= kUiWidth && config.scene_height >= kUiHeight)) {
     return false;
   }
   const uint32_t fetch0 = regs[XE_GPU_REG_SHADER_CONSTANT_FETCH_00_0];
-- 
