From 5d5d5db70b1ac9d9e6f192367c1a5c2a8110ae0c Mon Sep 17 00:00:00 2001
From: PromethenDev <PromethenDev@users.noreply.github.com>
Date: Sun, 1 Nov 2026 15:19:22 -0800
Subject: [PATCH 136/149] xam: keep a closed content package's device while
 guest files from it are still open (card S5-2 follow-up)

996e61a keeps the guest's file handles on content close, but the package destructor then unregistered the device that
owns their entries; the next CloseContent read a freed entry path (Linux r147a: invalid_utf8 abort in utf8_starts_with
at the second DLC close). Each package has a unique device path, so leaving it registered is safe.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 include/rex/system/xam/content_manager.h |  9 ++++++++-
 src/system/xam/content_manager.cpp       | 10 +++++++---
 2 files changed, 15 insertions(+), 4 deletions(-)

diff --git a/include/rex/system/xam/content_manager.h b/include/rex/system/xam/content_manager.h
index c3b34bd1..d3917de1 100644
--- a/include/rex/system/xam/content_manager.h
+++ b/include/rex/system/xam/content_manager.h
@@ -131,6 +131,11 @@ class ContentPackage {
 
   uint32_t GetPackageLicense() const { return license_; }
 
+  // Card S5-2: guest files of this package are still open (kept by CloseOpenedFilesFromContent). Their XFile entries
+  // belong to this package's device, so the destructor must leave the device registered (unique path per package) or the
+  // next content close reads a freed entry (Linux: invalid_utf8 abort in utf8_starts_with at the second DLC close).
+  void KeepDeviceForOpenFiles() { keep_device_ = true; }
+
  private:
   KernelState* kernel_state_;
   std::string root_name_;
@@ -138,6 +143,7 @@ class ContentPackage {
   std::filesystem::path package_path_;
   XCONTENT_AGGREGATE_DATA content_data_;
   uint32_t license_ = 0;
+  bool keep_device_ = false;
 };
 
 class ContentManager {
@@ -170,7 +176,8 @@ class ContentManager {
 
   std::filesystem::path ResolveGameUserContentPath();
   bool IsContentOpen(const XCONTENT_AGGREGATE_DATA& data) const;
-  void CloseOpenedFilesFromContent(const std::string_view root_name);
+  // Returns true when at least one guest file of the content was still open.
+  bool CloseOpenedFilesFromContent(const std::string_view root_name);
 
   // Returns the host filesystem path for an open content package, or empty.
   std::filesystem::path GetOpenPackagePath(const std::string_view root_name) const;
diff --git a/src/system/xam/content_manager.cpp b/src/system/xam/content_manager.cpp
index 3111a625..8a157817 100644
--- a/src/system/xam/content_manager.cpp
+++ b/src/system/xam/content_manager.cpp
@@ -69,7 +69,7 @@ ContentPackage::ContentPackage(KernelState* kernel_state, const std::string_view
 ContentPackage::~ContentPackage() {
   auto fs = kernel_state_->file_system();
   fs->UnregisterSymbolicLink(root_name_ + ":");
-  fs->UnregisterDevice(device_path_);
+  if (!keep_device_) fs->UnregisterDevice(device_path_);
 }
 
 void ContentPackage::LoadPackageLicenseMask(const std::filesystem::path header_path) {
@@ -334,8 +334,9 @@ X_RESULT ContentManager::CloseContent(const std::string_view root_name) {
     if (it == open_packages_.end()) {
       return X_ERROR_FILE_NOT_FOUND;
     }
-    CloseOpenedFilesFromContent(root_name);
+    const bool files_open = CloseOpenedFilesFromContent(root_name);
     package = it->second;
+    if (files_open) package->KeepDeviceForOpenFiles();
     open_packages_.erase(it);
   }
   delete package;
@@ -430,7 +431,7 @@ std::filesystem::path ContentManager::GetOpenPackagePath(const std::string_view
   return it->second->package_path();
 }
 
-void ContentManager::CloseOpenedFilesFromContent(const std::string_view root_name) {
+bool ContentManager::CloseOpenedFilesFromContent(const std::string_view root_name) {
   // TODO(Gliniak): Cleanup this code to care only about handles
   // related to provided content
   const std::vector<object_ref<XFile>> all_files_handles =
@@ -438,6 +439,7 @@ void ContentManager::CloseOpenedFilesFromContent(const std::string_view root_nam
 
   std::string resolved_path = "";
   kernel_state_->file_system()->FindSymbolicLink(std::string(root_name) + ':', resolved_path);
+  bool any_open = false;
 
   for (const object_ref<XFile>& file : all_files_handles) {
     std::string file_path = file->entry()->absolute_path();
@@ -453,8 +455,10 @@ void ContentManager::CloseOpenedFilesFromContent(const std::string_view root_nam
       REXSYS_WARN("[content-close] root {} {} guest file handle 0x{:08X} {}", root_name,
                   keep ? "keeps" : "releases", file->handle(), file_path);
       if (!keep) file->ReleaseHandle();
+      any_open = true;
     }
   }
+  return any_open;
 }
 
 }  // namespace xam
-- 
