+TEST_CASE("ObjectTable reuse fix delays a freed number and rejects a second close", "[kernel][object_table]") {
+  InitTestLogging();
+  DestructorCountReset reset;
+
+  const bool old_fix = REXCVAR_GET(WWE2K14_HANDLE_REUSE_FIX);
+  REXCVAR_SET(WWE2K14_HANDLE_REUSE_FIX, true);
+  ObjectTable table;
+  auto* first = new TestObject();
+  X_HANDLE first_handle = 0;
+  CHECK(table.AddHandle(first, &first_handle) == X_STATUS_SUCCESS);
+  first->Release();
+  CHECK(table.ReleaseHandle(first_handle) == X_STATUS_SUCCESS);
+  CHECK(table.ReleaseHandle(first_handle) == X_STATUS_INVALID_HANDLE);
+
+  auto* second = new TestObject();
+  X_HANDLE second_handle = 0;
+  CHECK(table.AddHandle(second, &second_handle) == X_STATUS_SUCCESS);
+  second->Release();
+  CHECK(second_handle != first_handle);
+  table.Reset();
+  REXCVAR_SET(WWE2K14_HANDLE_REUSE_FIX, old_fix);
+}
+
