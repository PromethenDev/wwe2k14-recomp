+  CHECK(table.AddHandle(first, &first_handle) == X_STATUS_SUCCESS);
+  first->Release();
+  CHECK(table.ReleaseHandle(first_handle) == X_STATUS_SUCCESS);
+
+  auto* second = new TestObject();
+  X_HANDLE second_handle = 0;
+  CHECK(table.AddHandle(second, &second_handle) == X_STATUS_SUCCESS);
+  second->Release();
+  CHECK(second_handle == first_handle);
+  table.Reset();
+  REXCVAR_SET(WWE2K14_HANDLE_REUSE_FIX, old_fix);
