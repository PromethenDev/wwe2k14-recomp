+namespace {
+struct TestCpuLimit {
+  DWORD_PTR mask = 0;
+  uint32_t count = 0;
+  uint32_t cores = 0;
+  uint32_t threads_per_core = 0;
+  std::string source;
+};
+
+// Parses "N" or "NxT" (N 1..64 cores, T 1..2 logical CPUs per core). Returns false when absent or invalid.
+bool ParseTestCpuLimit(const std::string& text, uint32_t* cores, uint32_t* tpc) {
+  size_t i = 0;
+  while (i < text.size() && (text[i] == ' ' || text[i] == '\t' || text[i] == '\r' || text[i] == '\n')) ++i;
+  uint32_t n = 0, t = 1;
+  size_t digits = 0;
+  while (i < text.size() && text[i] >= '0' && text[i] <= '9' && digits < 3) n = n * 10 + uint32_t(text[i++] - '0'), ++digits;
+  if (!digits || n == 0 || n > 64) return false;
+  if (i < text.size() && (text[i] == 'x' || text[i] == 'X')) {
+    ++i;
+    if (i >= text.size() || text[i] < '1' || text[i] > '2') return false;
+    t = uint32_t(text[i++] - '0');
+  }
+  *cores = n;
+  *tpc = t;
+  return true;
+}
+
+const TestCpuLimit& GetTestCpuLimit() {
+  static const TestCpuLimit limit = [] {
+    TestCpuLimit out;
+    std::string text;
+    if (const char* env = std::getenv("REX_TEST_CPU_LIMIT"); env && *env) {
+      text = env;
+      out.source = "REX_TEST_CPU_LIMIT";
+    } else {
+      wchar_t path[MAX_PATH * 2];
+      DWORD n = GetModuleFileNameW(nullptr, path, DWORD(std::size(path)));
+      if (n && n < std::size(path)) {
+        std::wstring file(path, n);
+        const size_t slash = file.find_last_of(L"\\/");
+        file = (slash == std::wstring::npos ? std::wstring() : file.substr(0, slash + 1)) + L"TEST-CPU-LIMIT.txt";
+        HANDLE h = CreateFileW(file.c_str(), GENERIC_READ, FILE_SHARE_READ, nullptr, OPEN_EXISTING, 0, nullptr);
+        if (h != INVALID_HANDLE_VALUE) {
+          char buf[64] = {};
+          DWORD got = 0;
+          if (ReadFile(h, buf, sizeof(buf) - 1, &got, nullptr)) text.assign(buf, got);
+          CloseHandle(h);
+          out.source = "TEST-CPU-LIMIT.txt";
+        }
+      }
+    }
+    if (out.source.empty()) return out;
+    uint32_t cores = 0, tpc = 0;
+    if (!ParseTestCpuLimit(text, &cores, &tpc)) {
+      spdlog::warn("[cpu-limit] {} has an invalid value (expected N or NxT, e.g. 4 or 4x2); no limit", out.source);
+      return out;
+    }
+    // One entry per physical core, in Windows' logical-processor order (processor group 0 only).
+    DWORD bytes = 0;
+    GetLogicalProcessorInformation(nullptr, &bytes);
+    std::vector<SYSTEM_LOGICAL_PROCESSOR_INFORMATION> info(bytes / sizeof(SYSTEM_LOGICAL_PROCESSOR_INFORMATION) + 1);
+    if (!bytes || !GetLogicalProcessorInformation(info.data(), &bytes)) {
+      spdlog::warn("[cpu-limit] GetLogicalProcessorInformation failed; no limit");
+      return out;
+    }
+    info.resize(bytes / sizeof(SYSTEM_LOGICAL_PROCESSOR_INFORMATION));
+    uint32_t used_cores = 0;
+    for (const auto& e : info) {
+      if (e.Relationship != RelationProcessorCore || used_cores >= cores) continue;
+      uint32_t taken = 0;
+      for (uint32_t bit = 0; bit < sizeof(ULONG_PTR) * 8 && taken < tpc; ++bit) {
+        const ULONG_PTR b = ULONG_PTR(1) << bit;
+        if (e.ProcessorMask & b) {
+          out.mask |= b;
+          ++taken;
+        }
+      }
+      if (taken) ++used_cores;
+    }
+    for (DWORD_PTR m = out.mask; m; m &= m - 1) ++out.count;
+    out.cores = used_cores;
+    out.threads_per_core = tpc;
+    return out;
+  }();
+  return limit;
+}
+}  // namespace
+
+uint32_t TestCpuLimitCount() {
+  return GetTestCpuLimit().count;
+}
+
 void EnableAffinityConfiguration() {
   HANDLE process_handle = GetCurrentProcess();
   DWORD_PTR process_affinity_mask;
   DWORD_PTR system_affinity_mask;
   GetProcessAffinityMask(process_handle, &process_affinity_mask, &system_affinity_mask);
+  const TestCpuLimit& limit = GetTestCpuLimit();
+  if (limit.mask && (limit.mask & system_affinity_mask) == limit.mask) {
+    const BOOL ok = SetProcessAffinityMask(process_handle, limit.mask);
+    spdlog::warn("[cpu-limit] TEST CPU limit from {}: {} cores x {} = {} logical CPUs, mask 0x{:X} (system 0x{:X}) {}",
+                 limit.source, limit.cores, limit.threads_per_core, limit.count, uint64_t(limit.mask),
+                 uint64_t(system_affinity_mask), ok ? "applied" : "FAILED");
+    if (ok) return;
+  }
   SetProcessAffinityMask(process_handle, system_affinity_mask);
+  spdlog::info("[cpu-limit] no CPU limit: logical CPUs {} (mask 0x{:X})", std::thread::hardware_concurrency(),
+               uint64_t(system_affinity_mask));
 }
 
 uint32_t current_thread_system_id() {
