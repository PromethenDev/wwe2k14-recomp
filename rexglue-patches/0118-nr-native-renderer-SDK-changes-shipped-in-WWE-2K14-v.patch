 };
 bool GetNrVulkanDevice(NrVulkanDevice* out);
-// SetNrExternalSwap: the next IssueSwap presents this image view (an image on the device above, in
-// SHADER_READ_ONLY_OPTIMAL layout, written by work submitted to the queue above before the swap) instead of the
-// guest frontbuffer texture (texture fetch 0 from guest memory). Consumed by that one swap. width / height are the
-// frontbuffer's guest size; needs_rb_swap as VulkanTextureCache::RequestSwapTexture reports it for the view.
+// SetNrExternalSwap: the next IssueSwap presents this image view instead of the guest frontbuffer texture (texture
+// fetch 0 from guest memory). A normal same-device view is already SHADER_READ_ONLY_OPTIMAL; an external_image is
+// acquired/released with queue-family/layout barriers during that swap. Consumed by that one swap. width / height are
+// the presented image's size, width_unscaled / height_unscaled the frontbuffer's guest size (0 = width / height);
+// needs_rb_swap as VulkanTextureCache::RequestSwapTexture reports it for the view.
 struct NrExternalSwap {
   uint64_t image_view = 0;  // VkImageView
   uint32_t width = 0, height = 0;
+  // Card S3-47a: the image is a scaled snapshot presented at its own size; the swap pass samples it by pixel index,
+  // so it runs at width x height and maps its output to the unscaled region (0 = same as width / height).
+  uint32_t width_unscaled = 0, height_unscaled = 0;
   bool needs_rb_swap = false;
+  // Opt-in WWE2K14 D3D12 shared-present transport. `image` is imported from
+  // D3D12, in GENERAL layout and owned by VK_QUEUE_FAMILY_EXTERNAL between presents. With
+  // external_cpu_sync, the presenter uses queue-family/layout ownership barriers and no semaphore;
+  // ring metadata supplies per-slot reuse and a CPU fence callback immediately before submit. All
+  // zero for existing callers.
+  uint64_t external_image = 0;  // VkImage
+  uint64_t external_wait_semaphore = 0;  // VkSemaphore
+  uint64_t external_wait_value = 0;
+  uint64_t external_signal_value = 0;
+  bool external_cpu_sync = false;
+  // Opt-in D3D12 shared-present ring metadata. The slot key identifies one image's Vulkan
+  // completion fence; the D3D12 fence callback is invoked immediately before the sampling submit.
+  uint64_t external_present_slot_key = 0;
+  uint32_t external_ring_depth = 0, external_ring_slot = 0;
+  bool (*external_wait_cpu_fence)(void* context, uint64_t value, uint64_t* wait_ns) = nullptr;
+  void* external_cpu_fence_context = nullptr;
+  uint64_t external_cpu_fence_value = 0;
 };
 void SetNrExternalSwap(const NrExternalSwap& swap);
+// [wwe2k14 nr] card S3-44: called on the guest thread for every CP_RB_WPTR write (the guest kicked the ring past
+// everything it wrote so far). Set before the title starts; null = off.
+using NrWritePointerHook = void (*)(uint32_t value);
+void SetNrWritePointerHook(NrWritePointerHook fn);
+NrWritePointerHook GetNrWritePointerHook();
+// [wwe2k14 nr] card DE-2 O0 (owner OK 2026-10-21): called on the CP execution thread for every type-3 NOP the CP
+// reaches (after the bin predicate), before its payload is skipped. Ordering/lifetime metadata only, never render
+// state. The event and first_payload_word are valid only during the call. Set before the title starts; null = off.
+struct NrNopEvent {
+  memory::Memory* memory = nullptr;
+  uint32_t packet_guest_address = 0xFFFFFFFFu;  // physical address of the NOP header (0xFFFFFFFF = not physical)
+  uint32_t payload_dwords = 0;                  // payload count, header excluded
+  const uint8_t* first_payload_word = nullptr;  // borrowed, guest byte order; do not dereference before ownership check
+  bool predicated = false;                      // type-3 predicate bit
+};
+using NrNopHook = void (*)(const NrNopEvent& event);
+void SetNrNopHook(NrNopHook fn);
 
 // Not thread-safe to change while the GPU thread runs; set before the title or replay starts.
 void SetDrawObserver(DrawObserver* observer);
