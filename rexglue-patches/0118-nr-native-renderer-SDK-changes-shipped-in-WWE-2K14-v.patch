+namespace {
+NrNopHook g_nr_nop_hook = nullptr;  // [wwe2k14 nr] card DE-2 O0; set before the title starts
+}  // namespace
+void SetNrNopHook(NrNopHook fn) { g_nr_nop_hook = fn; }
+
 bool CommandProcessor::ExecutePacketType3_NOP(memory::RingBuffer* reader, uint32_t packet,
                                               uint32_t count) {
+  if (const NrNopHook hook = g_nr_nop_hook) {
+    // ExecutePacketType3 already validated count >= 1 payload words. The header may have been the last ring word,
+    // so recover its offset modulo the ring (read_ptr()-4 would be wrong after a wrap).
+    const uint32_t payload_offset = uint32_t(reader->read_offset());
+    const uint32_t header_offset =
+        payload_offset != 0 ? payload_offset - uint32_t(sizeof(uint32_t)) : uint32_t(reader->capacity()) - 4u;
+    const uintptr_t header = reinterpret_cast<uintptr_t>(reader->buffer()) + header_offset;
+    const uintptr_t phys_base = reinterpret_cast<uintptr_t>(memory_->physical_membase());
+    NrNopEvent event;
+    event.memory = memory_;
+    if (header >= phys_base && header - phys_base < 0x20000000u) event.packet_guest_address = uint32_t(header - phys_base);
+    event.payload_dwords = count;
+    event.predicated = (packet & 1u) != 0;
+    event.first_payload_word = reader->buffer() + payload_offset;
+    g_nr_command_processor = this;
+    hook(event);
+  }
   // skip N 32-bit words to get to the next packet
   // No-op, ignore some data.
   reader->AdvanceRead(count * sizeof(uint32_t));
@@ -1332,6 +1354,7 @@ bool CommandProcessor::ExecutePacketType3_INTERRUPT(memory::RingBuffer* reader,
 
   // generate interrupt from the command stream
   uint32_t cpu_mask = reader->ReadAndSwap<uint32_t>();
+  if (DrawObserver* observer = GetDrawObserver()) observer->OnBeforeInterrupt(cpu_mask);
   for (int n = 0; n < 6; n++) {
     if (cpu_mask & (1 << n)) {
       if (graphics_system_) {
@@ -1751,6 +1774,10 @@ namespace {
 DrawObserver* g_draw_observer = nullptr;
 }  // namespace
 void SetDrawObserver(DrawObserver* observer) { g_draw_observer = observer; }
+// [wwe2k14 nr] card S3-44: guest CP_RB_WPTR writes (ring kicks).
+static void (*g_nr_wptr_hook)(uint32_t) = nullptr;
+void SetNrWritePointerHook(void (*fn)(uint32_t)) { g_nr_wptr_hook = fn; }
+NrWritePointerHook GetNrWritePointerHook() { return g_nr_wptr_hook; }
 DrawObserver* GetDrawObserver() { return g_draw_observer; }
 
 void CommandProcessor::DumpEdramAfterDraw(uint32_t ordinal) {
@@ -1999,6 +2026,10 @@ bool CommandProcessor::ExecutePacketType3Draw(memory::RingBuffer* reader, uint32
   // when true, render conditionally based on query result
   // uint32_t viz_use = viz_query_condition & 0x100;
 
+  // WP3: header dword address (see below).
+  // PM4_DRAW_INDX also consumed its viz-query token before this call, so its header is two dwords back.
+  const uintptr_t packet_header_host =
+      reader->read_ptr() - (((packet >> 8) & 0x7F) == PM4_DRAW_INDX ? 2 : 1) * sizeof(uint32_t);
   assert_not_zero(count_remaining);
   if (!count_remaining) {
     REXGPU_ERROR("{}: Packet too small, can't read VGT_DRAW_INITIATOR", opcode_name);
@@ -2100,6 +2131,12 @@ bool CommandProcessor::ExecutePacketType3Draw(memory::RingBuffer* reader, uint32
       draw.vertex_shader = vs;
       draw.pixel_shader = ps;
       draw.memory = memory_;
+      {
+        const uintptr_t phys_base = reinterpret_cast<uintptr_t>(memory_->physical_membase());
+        draw.packet_guest_address = (packet_header_host >= phys_base && packet_header_host - phys_base < 0x20000000u)
+                                        ? uint32_t(packet_header_host - phys_base)
+                                        : 0xFFFFFFFFu;
+      }
       observer->OnDraw(draw);
     }
   }
