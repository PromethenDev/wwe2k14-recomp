+bool VulkanCommandProcessor::WaitNrExternalPresentSlot(uint64_t slot_key, uint64_t* wait_ns) {
+#if defined(_WIN32)
+  const auto wait_start = std::chrono::steady_clock::now();
+  if (wait_ns) *wait_ns = 0;
+  if (!slot_key || device_lost_ || submission_failed_) return false;
+  auto it = nr_external_present_fences_.find(slot_key);
+  if (it == nr_external_present_fences_.end() || !it->second.has_submission) return true;
+  const uint64_t target_submission = it->second.submission;
+  if (target_submission > submission_completed_) CheckSubmissionFenceAndDeviceLoss(target_submission);
+  const auto wait_end = std::chrono::steady_clock::now();
+  if (wait_ns) {
+    *wait_ns = uint64_t(std::chrono::duration_cast<std::chrono::nanoseconds>(wait_end - wait_start).count());
+  }
+  return !device_lost_ && !submission_failed_ && submission_completed_ >= target_submission;
+#else
+  (void)slot_key;
+  if (wait_ns) *wait_ns = 0;
+  return false;
+#endif
+}
