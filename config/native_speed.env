# Native renderer speed set S4 (2026-10-13, P1 card). Each switch was replay-checked (0 px diff on 8 traces)
# except DIRECT_PRESENT, which is inactive in replays and was checked on live screenshots only.
# NOTE: DIRECT_PRESENT implies RESOLVE_REUSE (nr_frontend.cpp:4268); replay-checked explicitly 2026-10-13: 0 px on 8 traces.
# Excluded on purpose: NO_MSAA/NO_GUEST (change the picture), VB_CACHE,
# TEX_SHARE, REUSE_SHORT (WWE '13 picture faults), TILE_ONCE/MSAA_ALIAS (WWE '13-specific, not imported).
WWE2K14_NR_DIRECT_INVALIDATE=1
WWE2K14_NR_EARLY_SUBMIT=256
WWE2K14_NR_UPLOAD_RING=1
WWE2K14_NR_STATE_ELIDE=1
WWE2K14_NR_DRAW_FAST=1
WWE2K14_NR_RECORD_THREAD=1
WWE2K14_NR_DIRECT_PRESENT=1
# S4 (2026-10-13, P1 L6): plume still reads the WWE13 name for this switch; replay 0 px, live pictures OK.
WWE13_NR_UPLOAD_HOST=1
# S5 (2026-10-13): UHD 630 replays 0 px (93918, 14201); demo-match 11 -> 16/s on UHD 630.
# S6 (2026-10-13, P2 #2): replays final frames identical + copy-outs identical with MIRROR_DUMP; live 81 shots no frozen frames; UHD 630 18 -> 20/s.
# S7 (2026-10-13, P5): skip EDRAM store+load of tiles a full clear overwrites; 9 replays byte-identical; UHD 630 EDRAM GPU 21.9 -> 16.8 ms.
# Scene-once (P4): near-identical (<=2 px >8/frame), only acts on strip-split scenes.
# S8 (2026-10-14 night; cards P7-P10 + COPYOUT_NOHASH): each byte-identical on the 9 survey replays (MIRROR_DUMP copy-outs,
# known 7666/8271 depth pair excepted); UHD 630 same-match A/B runs R19 (replay -4.4 ms), R20 (f24c -1.2 ms), R21 (patch -2.0 ms).
WWE2K14_NR_F24_CONSERVATIVE=1
# P11 (R26 A/B -0.66 ms): owned depth copies read the host surface.
# P12 (R28 A/B -1.0 ms): depth-only clears of an alias redrawn on the key the tiles came from.
# P13 (R30 A/B -2.5 ms): no transfer into an alias a depth-only clear covers; stencil copied only when read.
# P14 (R34 A/B -1.1 ms): k_8 copies sampled from their snapshot.
# S9 (2026-10-14 day, card P17 = host-RT stage 1): clear-only 4x views folded into their 1x surface; 9 replays byte-identical
# (single + REPEAT=3, fallbacks 0); UHD same-match A/B R37 -2.64 ms (29.2 -> 26.5 ms in match); lane A p17-a: 3 arenas,
# 2 entrances, 116 shots, 0 frozen, 0 UNSUPPORTED, fallbacks 0. Needs shader set v10 only for F16_REUSE (not in the set).
# S10 (2026-10-14 day): P16 fixed16 copy-outs sampled from a 16-bit UNORM host image (needs shader set v10:
# edram_resolve_color_linear.spv; without it the path stays off) and P19 transfers held across consecutive covering
# clears. Both byte-identical on 9 replays (single + REPEAT=3); UHD A/B R36 ~-0.4 ms, R39 -0.52 ms; lane A p1619-a:
# 3 arenas, entrances, 116 shots, 0 frozen, 0 UNSUPPORTED, fold fallbacks 0.
# S11 (2026-10-14 day, card P21): vertex/index buffer cache revalidated by the page write watch (WWE '13 VB_CACHE; its
# fault was Android-only). verify9 identical (p21-gate); UHD same-match A/B R41 -1.57 ms (median -2.21; nr 18.2 -> 14.6);
# lane A vbc-a: entrances + matches in RAW / Royal Rumble / Elimination Chamber, 116 shots, 0 frozen, 0 UNSUPPORTED.
# S12 (2026-10-14 day, card P23): 8888 copy-outs reused by shorter fetches (320x180 of a 320x184 copy) — entrance fetch
# rejects 45 -> 1 per 3 frames; 9 replays identical (single + REPEAT=3); lane A p23-a: entrances + arenas, 0 frozen,
# 0 UNSUPPORTED, short_reused 84,773, height rejects 0.
# S13 (2026-10-14 day): P22 precise Vulkan barriers (vendored plume; sync-validation clean; UHD ring A/B R43 -0.38 ms,
# barrier calls 321 -> 215/frame) and P26 scene-once init clear over the used rows only (-65 % cleared area per entrance
# frame). Both byte-identical on 9 replays (single + REPEAT=3); lane A p22-a and comb-a (with CONST_FENCE): entrances,
# TLC / Night of Champions arenas, 0 frozen, 0 UNSUPPORTED, scene row fallbacks 0. CONST_FENCE (P24) is NOT in the set
# (ring A/B R42 +0.8 ms); not in any launcher; its entrance effect was not isolated.
WWE2K14_NR_PRECISE_BARRIERS=1
# Visual option, NOT in the default set (owner-judged; separate launcher "3 - New renderer 480p inside"): WWE2K14_NR_SCALE=2/3
