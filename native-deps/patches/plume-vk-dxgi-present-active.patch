# Flag for the game log: whether createSwapChain returned the DXGI flip swap chain (VulkanDxgiPresentActive). Apply after
# plume-vk-dxgi-present.patch (patch -p1 in native-deps/plume). 2026-11-21.
--- a/plume_vulkan.cpp
+++ b/plume_vulkan.cpp
@@ -3659,13 +3659,18 @@
 #   if defined(_WIN64)
         if (VulkanDxgiPresent) {
             if (device->dxgiPresentSupported) {
-                if (auto dxgi = CreateVulkanDxgiSwapChain(this, desc))
+                if (auto dxgi = CreateVulkanDxgiSwapChain(this, desc)) {
+                    VulkanDxgiPresentActive = true;
                     return dxgi;
+                }
             }
