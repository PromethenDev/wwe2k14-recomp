         // Detect adapter to use that will offer the best performance and features.
         HRESULT res;
         UINT adapterIndex = 0;
+        bool userChoicePicked = false;
         IDXGIAdapter1 *adapterOption = nullptr;
+        // WWE '13 (2026-11-19): decide up front which adapter the user's GPU setting names. An exact
+        // DXGI description match wins; only when none matches does the vendor fallback below apply,
+        // and then the same-vendor adapter sharing the most words with the setting. Before, the first
+        // adapter of the named vendor was locked in, so on a PC with two Intel GPUs (UHD 630 + Arc)
+        // choosing the UHD 630 picked the Arc.
+        int userChoiceIndex = -1;
+        if (!preferredDeviceName.empty()) {
+            const auto words = [](const std::string &text) {
+                std::vector<std::string> out; std::string w;
+                for (char c : text) {
+                    if (std::isalnum(static_cast<unsigned char>(c))) { w += char(std::tolower(static_cast<unsigned char>(c))); }
+                    else if (!w.empty()) { out.push_back(w); w.clear(); }
+                }
+                if (!w.empty()) out.push_back(w);
+                return out;
+            };
+            const std::vector<std::string> wanted = words(preferredDeviceName);
+            const auto names = [&](const char *word) { return preferredDeviceName.find(word) != std::string::npos; };
+            int bestScore = -1;
+            IDXGIAdapter1 *scan = nullptr;
