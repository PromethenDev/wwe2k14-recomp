+                    (d.VendorId == 0x1002 && (names("AMD") || names("Radeon")));
+                if (!vendorNamed) continue;
+                int score = 0;
+                for (const std::string &w : words(name))
+                    for (const std::string &x : wanted) score += (w == x) ? 1 : 0;
+                if (score > bestScore) { bestScore = score; userChoiceIndex = int(i); }
+            }
+        }
